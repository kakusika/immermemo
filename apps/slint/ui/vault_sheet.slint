import { Palette } from "std-widgets.slint";
import {
    Metrics,
    Colors,
    Shapes,
    IconButton,
    TopBar,
    ActionRow,
} from "components.slint";

// Full-screen, same shape as the other sheets: which vault is open, and a
// way to link another one. Rust owns what "adding" a vault actually means
// (a typed path on desktop, a subfolder name on Android) -- this only
// ever shows names and reports which row was tapped.
export component VaultSheet inherits Rectangle {
    in property <[string]> vaults;
    // Index into `vaults`, or -1 if none matches (shouldn't normally
    // happen -- the current vault is always one of the known ones).
    in property <int> current: -1;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    callback select(int);
    callback add();
    callback close();
    callback delete-requested(int);

    property <int> menu-index: -1;

    background: Palette.background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            IconButton {
                shape: Shapes.back;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: "Vaults";
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        for name[i] in root.vaults: Rectangle {
            height: Metrics.touch;
            background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
            property <bool> long-pressed: false;

            HorizontalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                Text {
                    text: name;
                    color: i == root.current ? Palette.accent-background : Palette.foreground;
                    font-size: 17px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if i == root.current: Text {
                    text: "current";
                    font-size: 13px;
                    color: Palette.accent-background;
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                clicked => {
                    if (long-pressed) {
                        long-pressed = false;
                    } else {
                        root.select(i);
                    }
                }
            }

            Timer {
                interval: 500ms;
                running: touch.pressed && !long-pressed;
                triggered => {
                    long-pressed = true;
                    root.menu-index = i;
                }
            }
        }

        ActionRow {
            text: "+ Add vault";
            tint: Palette.accent-background;
            clicked => { root.add(); }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: root.inset-bottom;
        }
    }

    if root.menu-index >= 0: Rectangle {
        background: #00000055;
        TouchArea {
            clicked => { root.menu-index = -1; }
        }

        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: sheet-layout.preferred-height;
            background: Palette.background;
            border-radius: 12px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000044;

            sheet-layout := VerticalLayout {
                padding-bottom: root.inset-bottom;
                if root.vaults.length > 1: ActionRow {
                    text: "Delete";
                    tint: Colors.danger;
                    clicked => {
                        root.delete-requested(root.menu-index);
                        root.menu-index = -1;
                    }
                }
                if root.vaults.length <= 1: ActionRow {
                    text: "Cannot delete the only vault";
                    tint: Colors.muted;
                    clicked => {
                        root.menu-index = -1;
                    }
                }
            }
        }
    }
}
