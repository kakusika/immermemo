import { Palette } from "std-widgets.slint";
import { Metrics, ActionRow, Colors, BottomNavBar } from "components.slint";
import { HomeScreen } from "screens/home.slint";
import { FilesScreen } from "screens/files.slint";
import { EditorScreen } from "screens/editor.slint";
import { PropertiesScreen } from "screens/properties.slint";
import { SearchScreen } from "screens/search.slint";
import { RemoteSheet } from "sheets/remote.slint";
import { VaultSheet } from "sheets/vault.slint";
import { SettingsSheet } from "sheets/settings.slint";
import { ConflictSheet } from "sheets/conflict.slint";
import { HistorySheet } from "sheets/history.slint";
import { VaultHistorySheet } from "sheets/vault_history.slint";
import { TextInputDialog, ConfirmDialog, ActionSheet } from "dialogs.slint";

export component App inherits Window {
    title: "immermemo";
    preferred-width: 960px;
    preferred-height: 640px;
    background: Palette.background;

    // Navigation: 0: Home, 1: Files, 2: Note, 3: Details, 4: Search
    in-out property <int> active-tab: 2;

    in property <[string]> notes;
    in property <[string]> snippets: [];
    in property <[bool]> conflicted;
    in property <int> current: -1;
    in-out property <string> search-query: "";
    in property <string> current-title;
    in property <string> current-note-path: "";
    in property <int> char-count: 0;
    in property <int> word-count: 0;
    in property <int> line-count: 0;
    in property <int> conflict-count: 0;
    in-out property <string> status;
    in-out property <bool> status-is-error: false;
    in-out property <string> last-sync-error: "";
    in-out property <bool> sync-error-copied: false;
    in property <string> last-synced-at: "";
    in property <bool> syncing;
    in property <bool> current-has-conflict;
    in-out property <bool> conflict-sheet-open: false;
    in-out property <bool> history-sheet-open: false;
    in property <[string]> history-commits: [];
    in property <[string]> history-dates: [];
    in property <[string]> history-previews: [];
    in-out property <int> history-selected-index: 0;
    in-out property <bool> vault-history-open: false;
    in property <[string]> vault-history-commits: [];
    in property <[string]> vault-history-dates: [];
    in-out property <int> active-conflict-index: 0;
    in property <int> active-conflict-total: 0;
    in property <string> active-conflict-mine: "";
    in property <string> active-conflict-theirs: "";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in-out property <string> body;
    in property <bool> remote-configured;
    in-out property <bool> remote-open: false;
    in-out property <string> remote-url-draft;
    in-out property <string> remote-token-draft;
    in property <bool> remote-has-token;
    in-out property <int> note-menu-index: -1;
    in-out property <bool> rename-open: false;
    in-out property <string> rename-draft;
    in-out property <bool> delete-confirm-open: false;
    in-out property <bool> delete-vault-confirm-open: false;
    in-out property <bool> vault-sheet-open: false;
    in property <[string]> vaults;
    in property <int> current-vault: -1;
    in property <string> current-vault-name: "";
    in property <string> current-vault-path: "";
    in-out property <bool> settings-open: false;
    in-out property <int> font-size-choice: 1;
    in-out property <length> editor-font-size: 17px;
    in-out property <int> theme-choice: 0;
    in-out property <float> ui-scale <=> Metrics.ui-scale;

    function apply-theme-choice() {
        if (root.theme-choice == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.theme-choice == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    changed theme-choice => { root.apply-theme-choice(); }

    in-out property <bool> add-vault-open: false;
    in-out property <string> add-vault-draft;
    in property <length> extra-inset-top: 0px;
    in property <length> extra-inset-bottom: 0px;

    // Kept for backward compatibility with snap tests
    in-out property <bool> list-open: false;
    changed list-open => {
        if (root.list-open && root.active-tab != 1) {
            root.active-tab = 1;
        }
    }

    in-out property <bool> narrow: false;
    init => {
        root.narrow = root.width < 600px;
        root.apply-theme-choice();
    }
    changed width => { root.narrow = root.width < 600px; }

    callback select(int);
    callback edited(string);
    callback undo();
    callback redo();
    callback sync();
    callback new-note();
    callback link();
    callback open-settings();
    callback close-settings();
    callback font-size-changed(int);
    callback theme-changed(int);
    callback save-remote(string, string);
    callback close-remote();
    callback rename-requested(int);
    callback delete-requested(int);
    callback confirm-rename(string);
    callback confirm-delete();
    callback open-vault-sheet();
    callback switch-vault(int);
    callback add-vault-requested();
    callback confirm-add-vault(string);
    callback delete-vault-requested(int);
    callback confirm-delete-vault();
    callback resolve-mine();
    callback resolve-theirs();
    callback jump-conflict();
    callback open-conflict-sheet();
    callback resolve-conflict-step(int);
    callback prev-conflict-step();
    callback next-conflict-step();
    callback trigger-haptic();
    callback search-query-changed(string);
    callback open-conflict-note();
    callback copy-sync-error();
    callback dismiss-sync-error();
    callback open-history();
    callback restore-history-version(int);
    callback open-vault-history();

    public function set-cursor(offset: int) {
        pane.set-cursor(offset);
    }

    property <length> inset-top: root.safe-area-insets.top + root.extra-inset-top;
    in-out property <length> keyboard: 0px;
    function update-keyboard() {
        let old_kb = root.keyboard;
        root.keyboard = root.virtual-keyboard-size.height > 0
            ? max(0px, root.height - root.virtual-keyboard-position.y)
            : 0px;
        if (old_kb > 0px && root.keyboard == 0px && root.active-tab == 2) {
            pane.unfocus();
        }
    }
    changed virtual-keyboard-size => { root.update-keyboard(); }
    changed virtual-keyboard-position => { root.update-keyboard(); }
    changed height => { root.update-keyboard(); }
    property <length> inset-bottom: max(root.safe-area-insets.bottom + root.extra-inset-bottom, root.keyboard);

    // Horizontal swipe gesture tracking for tab navigation
    property <bool> is-swiping: false;
    property <length> swipe-dx: 0px;

    // Main App Layout
    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Content Area with 5 swipeable screens
        content-box := Rectangle {
            vertical-stretch: 1;
            clip: true;

            SwipeGestureHandler {
                width: 100%;
                height: 100%;
                enabled: root.narrow && root.keyboard == 0px && (root.active-tab != 2 || !pane.editor-has-focus);
                handle-swipe-left: root.active-tab < 4;
                handle-swipe-right: root.active-tab > 0;

                moved => {
                    if (self.swiping) {
                        root.is-swiping = true;
                        let dx = self.current-position.x - self.pressed-position.x;
                        root.swipe-dx = dx;
                    }
                }

                swiped => {
                    root.is-swiping = false;
                    let dx = self.current-position.x - self.pressed-position.x;
                    if (dx < -40px && root.active-tab < 4) {
                        root.active-tab += 1;
                        root.trigger-haptic();
                    } else if (dx > 40px && root.active-tab > 0) {
                        root.active-tab -= 1;
                        root.trigger-haptic();
                    }
                    root.swipe-dx = 0px;
                }

                cancelled => {
                    root.is-swiping = false;
                    root.swipe-dx = 0px;
                }

                // Screen 0: Home
                home-screen := HomeScreen {
                    x: (0 - root.active-tab) * parent.width + root.swipe-dx;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    inset-top: root.inset-top;
                    inset-bottom: root.inset-bottom;
                    vault-name: root.current-vault-name;
                    vault-path: root.current-vault-path;
                    note-count: root.notes.length;
                    conflict-count: root.conflict-count;
                    status: root.status;
                    syncing: root.syncing;
                    remote-configured: root.remote-configured;
                    last-sync-error: root.last-sync-error;
                    sync-error-copied: root.sync-error-copied;
                    last-synced-at: root.last-synced-at;
                    current-note-title: root.current-title;
                    has-current-note: root.current >= 0;
                    new-note => {
                        root.new-note();
                        root.active-tab = 2;
                        pane.focus-editor();
                    }
                    sync => { root.sync(); }
                    open-vaults => { root.open-vault-sheet(); }
                    open-settings => { root.open-settings(); }
                    open-vault-history => { root.open-vault-history(); }
                    open-current-note => {
                        root.active-tab = 2;
                        pane.focus-editor();
                    }
                    open-conflict-note => {
                        root.open-conflict-note();
                    }
                    copy-sync-error => {
                        root.copy-sync-error();
                    }
                    dismiss-sync-error => {
                        root.dismiss-sync-error();
                    }

                    animate x {
                        duration: root.is-swiping ? 0ms : 220ms;
                        easing: ease-out;
                    }
                }

                // Screen 1: Files / Notes list
                files-screen := FilesScreen {
                    x: (1 - root.active-tab) * parent.width + root.swipe-dx;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    notes: root.notes;
                    conflicted: root.conflicted;
                    current: root.current;
                    status: root.status;
                    syncing: root.syncing;
                    inset-top: root.inset-top;
                    inset-bottom: root.inset-bottom;
                    highlight-current: true;
                    remote-configured: root.remote-configured;
                    vault-name: root.current-vault-name;
                    select(i) => {
                        root.select(i);
                        root.active-tab = 2; // Jump to Note editor
                        pane.focus-editor();
                    }
                    new-note => {
                        root.new-note();
                        root.active-tab = 2; // Jump to Note editor
                        pane.focus-editor();
                    }
                    sync => { root.sync(); }
                    open-settings => { root.open-settings(); }
                    note-menu-requested(i) => { root.note-menu-index = i; }
                    trigger-haptic => { root.trigger-haptic(); }
                    open-vault-sheet => { root.open-vault-sheet(); }

                    animate x {
                        duration: root.is-swiping ? 0ms : 220ms;
                        easing: ease-out;
                    }
                }

                // Screen 2: Note Editor
                editor-wrapper := Rectangle {
                    x: (2 - root.active-tab) * parent.width + root.swipe-dx;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    pane := EditorScreen {
                        width: 100%;
                        height: 100%;
                        title: root.current-title;
                        has-note: root.current >= 0;
                        note-count: root.notes.length;
                        has-conflict: root.current-has-conflict;
                        can-undo: root.can-undo;
                        can-redo: root.can-redo;
                        show-back: false;
                        inset-top: root.inset-top;
                        inset-bottom: root.keyboard > 0px ? root.keyboard : root.inset-bottom;
                        font-size: root.editor-font-size;
                        status: root.status;
                        status-is-error: root.status-is-error;
                        body <=> root.body;
                        edited(t) => { root.edited(t); }
                        undo => { root.undo(); }
                        redo => { root.redo(); }
                        dismiss-status => {
                            root.status = "";
                            root.status-is-error = false;
                        }
                        new-note => {
                            root.new-note();
                            pane.focus-editor();
                        }
                        resolve-mine => { root.resolve-mine(); }
                        resolve-theirs => { root.resolve-theirs(); }
                        jump-conflict => { root.jump-conflict(); }
                        open-conflict-sheet => { root.open-conflict-sheet(); }
                        syncing: root.syncing;
                        remote-configured: root.remote-configured;
                        last-synced-at: root.last-synced-at;
                        manual-sync => { root.sync(); }
                        open-history => { root.open-history(); }
                    }

                    animate x {
                        duration: root.is-swiping ? 0ms : 220ms;
                        easing: ease-out;
                    }
                }

                // Screen 3: Details / Properties
                details-screen := PropertiesScreen {
                    x: (3 - root.active-tab) * parent.width + root.swipe-dx;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    inset-top: root.inset-top;
                    inset-bottom: root.inset-bottom;
                    has-note: root.current >= 0;
                    note-title: root.current-title;
                    note-path: root.current-note-path;
                    char-count: root.char-count;
                    word-count: root.word-count;
                    line-count: root.line-count;
                    has-conflict: root.current-has-conflict;
                    conflict-total: root.active-conflict-total;
                    conflict-mine-preview: root.active-conflict-mine;
                    conflict-theirs-preview: root.active-conflict-theirs;
                    open-conflict-sheet => { root.open-conflict-sheet(); }
                    rename-requested => {
                        if (root.current >= 0) {
                            root.rename-requested(root.current);
                        }
                    }
                    delete-requested => {
                        if (root.current >= 0) {
                            root.delete-requested(root.current);
                        }
                    }
                    resolve-mine => { root.resolve-mine(); }
                    resolve-theirs => { root.resolve-theirs(); }

                    animate x {
                        duration: root.is-swiping ? 0ms : 220ms;
                        easing: ease-out;
                    }
                }

                // Screen 4: Search
                search-screen := SearchScreen {
                    x: (4 - root.active-tab) * parent.width + root.swipe-dx;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    inset-top: root.inset-top;
                    inset-bottom: root.inset-bottom;
                    query <=> root.search-query;
                    notes: root.notes;
                    snippets: root.snippets;
                    conflicted: root.conflicted;
                    query-changed(q) => { root.search-query-changed(q); }
                    select(i) => {
                        root.select(i);
                        root.active-tab = 2; // Jump to Note editor
                        pane.focus-editor();
                    }

                    animate x {
                        duration: root.is-swiping ? 0ms : 220ms;
                        easing: ease-out;
                    }
                }
            }
        }

        // Bottom Navigation Bar
        BottomNavBar {
            visible: root.keyboard == 0px;
            height: root.keyboard == 0px ? (Metrics.bottom-bar-height + root.safe-area-insets.bottom + root.extra-inset-bottom) : 0px;
            active-tab <=> root.active-tab;
            conflict-count: root.conflict-count;
            current-has-conflict: root.current-has-conflict;
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            tab-selected(idx) => {
                root.active-tab = idx;
                root.trigger-haptic();
                pane.unfocus();
            }
        }
    }

    // Overlays & Sheets
    if root.settings-open: SettingsSheet {
        width: 100%;
        height: 100%;
        has-token: root.remote-has-token;
        url-draft <=> root.remote-url-draft;
        token-draft <=> root.remote-token-draft;
        syncing: root.syncing;
        sync-status: root.status;
        current-vault-name: root.current-vault-name;
        current-vault-path: root.current-vault-path;
        font-size-choice <=> root.font-size-choice;
        theme-choice <=> root.theme-choice;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        save-remote(url, token) => { root.save-remote(url, token); }
        sync => { root.sync(); }
        open-vaults => {
            root.settings-open = false;
            root.open-vault-sheet();
        }
        font-size-changed(c) => { root.font-size-changed(c); }
        theme-changed(c) => { root.theme-changed(c); }
        close => { root.close-settings(); }
    }

    if root.remote-open: RemoteSheet {
        width: 100%;
        height: 100%;
        has-token: root.remote-has-token;
        url-draft <=> root.remote-url-draft;
        token-draft <=> root.remote-token-draft;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        save(url, token) => { root.save-remote(url, token); }
        cancel => { root.close-remote(); }
    }

    if root.note-menu-index >= 0: ActionSheet {
        open: true;
        narrow: root.narrow;
        title: root.note-menu-index >= 0 ? root.notes[root.note-menu-index] : "";
        inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
        cancel => { root.note-menu-index = -1; }

        ActionRow {
            text: "Rename";
            clicked => {
                let idx = root.note-menu-index;
                root.note-menu-index = -1;
                root.rename-requested(idx);
            }
        }

        ActionRow {
            text: "Delete";
            tint: Colors.danger;
            clicked => {
                let idx = root.note-menu-index;
                root.note-menu-index = -1;
                root.delete-requested(idx);
            }
        }
    }

    if root.rename-open: TextInputDialog {
        open: true;
        narrow: root.narrow;
        title: "Rename note";
        text-draft <=> root.rename-draft;
        inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
        save(name) => {
            root.rename-open = false;
            root.confirm-rename(name);
        }
        cancel => { root.rename-open = false; }
    }

    if root.delete-confirm-open: ConfirmDialog {
        open: true;
        narrow: root.narrow;
        title: "Delete this note?";
        body: "This can't be undone from here.";
        confirm-text: "Delete";
        inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
        confirm => {
            root.delete-confirm-open = false;
            root.confirm-delete();
        }
        cancel => { root.delete-confirm-open = false; }
    }

    if root.vault-sheet-open: VaultSheet {
        width: 100%;
        height: 100%;
        vaults: root.vaults;
        current: root.current-vault;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        select(i) => {
            root.vault-sheet-open = false;
            root.switch-vault(i);
        }
        add => { root.add-vault-requested(); }
        close => { root.vault-sheet-open = false; }
        delete-requested(i) => { root.delete-vault-requested(i); }
        trigger-haptic => { root.trigger-haptic(); }
    }

    if root.delete-vault-confirm-open: ConfirmDialog {
        open: true;
        narrow: root.narrow;
        title: "Remove this vault?";
        body: "Its notes will stay on disk, but its sync settings and git history will be forgotten.";
        confirm-text: "Remove";
        inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
        confirm => {
            root.delete-vault-confirm-open = false;
            root.confirm-delete-vault();
        }
        cancel => { root.delete-vault-confirm-open = false; }
    }

    if root.add-vault-open: TextInputDialog {
        open: true;
        narrow: root.narrow;
        title: "Add vault";
        text-draft <=> root.add-vault-draft;
        inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
        save(input) => {
            root.add-vault-open = false;
            root.confirm-add-vault(input);
        }
        cancel => { root.add-vault-open = false; }
    }

    if root.conflict-sheet-open: ConflictSheet {
        width: 100%;
        height: 100%;
        open: true;
        conflict-index: root.active-conflict-index;
        conflict-total: root.active-conflict-total;
        mine-text: root.active-conflict-mine;
        theirs-text: root.active-conflict-theirs;
        close => { root.conflict-sheet-open = false; }
        resolve-choice(choice) => { root.resolve-conflict-step(choice); }
        prev-conflict => { root.prev-conflict-step(); }
        next-conflict => { root.next-conflict-step(); }
    }

    if root.history-sheet-open: HistorySheet {
        width: 100%;
        height: 100%;
        open: true;
        note-title: root.current-title;
        commits: root.history-commits;
        dates: root.history-dates;
        previews: root.history-previews;
        selected-index <=> root.history-selected-index;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        close => { root.history-sheet-open = false; }
        restore(idx) => { root.restore-history-version(idx); }
    }

    if root.vault-history-open: VaultHistorySheet {
        width: 100%;
        height: 100%;
        open: true;
        vault-name: root.current-vault-name;
        commits: root.vault-history-commits;
        dates: root.vault-history-dates;
        inset-top: root.inset-top;
        inset-bottom: root.inset-bottom;
        close => { root.vault-history-open = false; }
    }
}
