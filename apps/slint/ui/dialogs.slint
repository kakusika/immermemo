import { Palette, LineEdit, Button } from "std-widgets.slint";
import { Metrics, Colors } from "components.slint";

// Modern responsive text input dialog / bottom sheet.
// On narrow/mobile screens: slides up from the bottom as a bottom sheet.
// On wide/desktop screens: centered modal dialog with backdrop scrim.
export component TextInputDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <string> title;
    in-out property <string> text-draft;
    in property <length> inset-bottom: 0px;
    callback save(string);
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.open || self.opacity > 0.01;
    opacity: root.open ? 1.0 : 0.0;
    animate opacity { duration: 140ms; easing: ease-out; }

    // Scrim / Backdrop overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.45);

        TouchArea {
            enabled: root.open;
            clicked => { root.cancel(); }
        }
    }

    // Modal Card / Bottom Sheet
    card := Rectangle {
        width: root.narrow ? (parent.width - 24px) : min(440px, parent.width - 32px);
        height: content-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: root.narrow
            ? (root.open ? parent.height - self.height - 12px - root.inset-bottom : parent.height)
            : ((parent.height - self.height) / 2 + (root.open ? 0px : 24px));
        animate y { duration: 160ms; easing: ease-out; }

        background: Palette.background;
        border-radius: 20px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000044;

        content-layout := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 20px;
            spacing: 16px;

            if root.narrow: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Palette.foreground.with-alpha(0.2);
                }
            }

            Text {
                text: root.title;
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }

            text-field := LineEdit {
                height: Metrics.touch;
                text <=> root.text-draft;
                accepted => {
                    if (root.text-draft != "") {
                        root.save(root.text-draft);
                    }
                }
            }

            HorizontalLayout {
                height: 40px;
                alignment: end;
                spacing: 10px;

                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }

                Button {
                    text: "Save";
                    primary: true;
                    enabled: root.text-draft != "";
                    clicked => { root.save(root.text-draft); }
                }
            }
        }
    }
}

// Modern responsive confirmation dialog / bottom sheet.
export component ConfirmDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text: "Confirm";
    in property <length> inset-bottom: 0px;
    callback confirm();
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.open || self.opacity > 0.01;
    opacity: root.open ? 1.0 : 0.0;
    animate opacity { duration: 140ms; easing: ease-out; }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.45);

        TouchArea {
            enabled: root.open;
            clicked => { root.cancel(); }
        }
    }

    card := Rectangle {
        width: root.narrow ? (parent.width - 24px) : min(420px, parent.width - 32px);
        height: content-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: root.narrow
            ? (root.open ? parent.height - self.height - 12px - root.inset-bottom : parent.height)
            : ((parent.height - self.height) / 2 + (root.open ? 0px : 24px));
        animate y { duration: 160ms; easing: ease-out; }

        background: Palette.background;
        border-radius: 20px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000044;

        content-layout := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 20px;
            spacing: 16px;

            if root.narrow: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Palette.foreground.with-alpha(0.2);
                }
            }

            Text {
                text: root.title;
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }

            if root.body != "": Text {
                text: root.body;
                font-size: 14px;
                color: Colors.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                height: 40px;
                alignment: end;
                spacing: 10px;

                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }

                Button {
                    text: root.confirm-text;
                    primary: true;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

// Action sheet / context menu for long-press actions.
// Full screen backdrop with bottom sheet on narrow screens and centered card on wide screens.
export component ActionSheet inherits Rectangle {
    in property <bool> open: false;
    in property <bool> narrow: true;
    in property <string> title;
    in property <length> inset-bottom: 0px;
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.open || self.opacity > 0.01;
    opacity: root.open ? 1.0 : 0.0;
    animate opacity { duration: 140ms; easing: ease-out; }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.45);

        TouchArea {
            enabled: root.open;
            clicked => { root.cancel(); }
        }
    }

    card := Rectangle {
        width: root.narrow ? (parent.width - 24px) : min(380px, parent.width - 32px);
        height: content-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: root.narrow
            ? (root.open ? parent.height - self.height - 12px - root.inset-bottom : parent.height)
            : ((parent.height - self.height) / 2 + (root.open ? 0px : 24px));
        animate y { duration: 160ms; easing: ease-out; }

        background: Palette.background;
        border-radius: 20px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000044;

        content-layout := VerticalLayout {
            padding-top: 14px;
            padding-bottom: 12px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 2px;

            if root.narrow: HorizontalLayout {
                alignment: center;
                padding-bottom: 6px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Palette.foreground.with-alpha(0.2);
                }
            }

            if root.title != "": HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 6px;
                Text {
                    text: root.title;
                    font-size: 15px;
                    font-weight: 600;
                    color: Colors.muted;
                    overflow: elide;
                }
            }

            @children
        }
    }
}
