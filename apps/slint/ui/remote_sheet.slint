import { Palette, LineEdit, Button } from "std-widgets.slint";
import { Metrics, Colors } from "components.slint";

// A full-screen sheet for linking a vault to a remote: covers the list and
// editor both, so it reads the same on a phone or a wide window.
export component RemoteSheet inherits Rectangle {
    in property <bool> has-token;
    in-out property <string> url-draft;
    in-out property <string> token-draft;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    callback save(string, string);
    callback cancel();

    background: Palette.background;

    VerticalLayout {
        padding: Metrics.gutter;
        padding-top: root.inset-top + Metrics.gutter;
        padding-bottom: root.inset-bottom + Metrics.gutter;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Sync remote";
            font-size: 22px;
            font-weight: 600;
        }

        Text {
            text: "A GitHub, Gitea or Forgejo repository URL, and a personal access token with permission to push to it.";
            font-size: 13px;
            color: Colors.muted;
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Remote URL";
                font-size: 13px;
                color: Colors.muted;
            }

            LineEdit {
                height: Metrics.touch;
                placeholder-text: "https://github.com/you/notes.git";
                text <=> root.url-draft;
            }
        }

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Access token";
                font-size: 13px;
                color: Colors.muted;
            }

            LineEdit {
                height: Metrics.touch;
                placeholder-text: root.has-token ? "Leave blank to keep the saved token" : "Personal access token";
                input-type: password;
                text <=> root.token-draft;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }

            Button {
                text: "Save";
                primary: true;
                clicked => { root.save(root.url-draft, root.token-draft); }
            }
        }
    }
}
