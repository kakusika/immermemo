import { Palette, Button, ScrollView } from "std-widgets.slint";
import {
    Metrics,
    Colors,
    Shapes,
    BubbleButton,
    TopBar,
    ActionRow,
} from "../components.slint";

export component HomePane inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    // Vault info
    in property <string> vault-name: "Default";
    in property <string> vault-path: "";
    in property <int> note-count: 0;
    in property <int> conflict-count: 0;
    in property <string> status: "";
    in property <bool> syncing: false;
    in property <bool> remote-configured: false;

    // Currently open / recent note
    in property <string> current-note-title: "";
    in property <bool> has-current-note: false;

    callback new-note();
    callback sync();
    callback open-vaults();
    callback open-settings();
    callback open-current-note();

    background: Palette.background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;

            Text {
                horizontal-stretch: 1;
                text: "ホーム";
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            BubbleButton {
                shape: Shapes.sync;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                enabled: !root.syncing;
                clicked => { root.sync(); }
            }

            BubbleButton {
                shape: Shapes.settings;
                clicked => { root.open-settings(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: 16px;
                padding-bottom: root.inset-bottom + 24px;
                spacing: 20px;

                // ----------------------------------------------------
                // Section: Active Vault Card
                // ----------------------------------------------------
                Rectangle {
                    border-radius: 14px;
                    background: Palette.alternate-background;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                Text {
                                    text: "現在の保管庫";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Colors.muted;
                                    letter-spacing: 0.5px;
                                }

                                Text {
                                    text: root.vault-name != "" ? root.vault-name : "Notes";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }
                            }

                            BubbleButton {
                                shape: Shapes.files;
                                clicked => { root.open-vaults(); }
                            }
                        }

                        if root.vault-path != "": Text {
                            text: root.vault-path;
                            font-size: 12px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 1px;
                            background: Colors.separator;
                        }

                        HorizontalLayout {
                            spacing: 16px;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "ノート数";
                                    font-size: 12px;
                                    color: Colors.muted;
                                }
                                Text {
                                    text: root.note-count;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            if root.conflict-count > 0: VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "競合";
                                    font-size: 12px;
                                    color: Colors.warning;
                                }
                                Text {
                                    text: root.conflict-count;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Colors.warning;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.status != "": Text {
                                text: root.status;
                                font-size: 12px;
                                color: Colors.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Currently Open Note
                // ----------------------------------------------------
                if root.has-current-note: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "編集中ノート";
                        font-size: 11px;
                        font-weight: 700;
                        color: Colors.muted;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: 14px;
                        background: Palette.alternate-background;

                        TouchArea {
                            clicked => { root.open-current-note(); }
                        }

                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;

                            Text {
                                text: root.current-note-title;
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Text {
                                text: "タップして編集を続ける →";
                                font-size: 13px;
                                color: Palette.accent-background;
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Quick Actions
                // ----------------------------------------------------
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "クイックアクション";
                        font-size: 11px;
                        font-weight: 700;
                        color: Colors.muted;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: 14px;
                        background: Palette.alternate-background;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            ActionRow {
                                text: "+ 新しいノート";
                                tint: Palette.accent-background;
                                clicked => { root.new-note(); }
                            }

                            ActionRow {
                                text: "保管庫を切り替え...";
                                clicked => { root.open-vaults(); }
                            }

                            ActionRow {
                                text: "設定・同期...";
                                clicked => { root.open-settings(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
