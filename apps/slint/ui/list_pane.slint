import { Palette, ListView } from "std-widgets.slint";
import {
    Metrics,
    Colors,
    Shapes,
    Icon,
    IconButton,
    TopBar,
    Fab,
    ActionRow,
} from "components.slint";

export component ListPane inherits Rectangle {
    in property <[string]> notes;
    in property <[string]> snippets: [];
    in property <[bool]> conflicted;
    in property <int> current: -1;
    in property <string> status;
    in property <bool> syncing;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // The editor sits beside the list, so the open note stays highlighted.
    in property <bool> highlight-current: false;
    // Whether a remote is linked yet -- shown as a dot on the link icon.
    in property <bool> remote-configured: false;
    in-out property <string> search-query: "";
    callback select(int);
    callback new-note();
    callback sync();
    callback open-settings();
    callback note-menu-requested(int);
    callback trigger-haptic();
    // Tapping the title opens the vault switcher.
    callback open-vault-sheet();
    // Swiping left on the list or its items closes the drawer on narrow screens.
    callback close-drawer();
    callback search-query-changed(string);

    background: Palette.background;

    // Catches left swipes in empty space (e.g. below the list) to close the drawer on mobile
    TouchArea {
        moved => {
            if (self.pressed && self.pressed-x - self.mouse-x > 24px) {
                root.close-drawer();
            }
        }
    }

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            // Aligns the title with the rows below.
            Rectangle {
                width: Metrics.gutter - 4px;
            }

            Rectangle {
                horizontal-stretch: 1;
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.status != "" ? root.status : "Notes";
                    font-size: root.status != "" ? 14px : 22px;
                    font-weight: root.status != "" ? 400 : 600;
                    color: root.status != "" ? Colors.muted : Palette.foreground;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }

                TouchArea {
                    property <bool> swiped: false;
                    moved => {
                        if (self.pressed && self.pressed-x - self.mouse-x > 24px) {
                            swiped = true;
                            root.close-drawer();
                        }
                    }
                    clicked => {
                        if (swiped) {
                            swiped = false;
                        } else {
                            root.open-vault-sheet();
                        }
                    }
                }
            }

            IconButton {
                shape: Shapes.settings;
                // Warns that nothing is linked yet.
                tint: root.remote-configured ? Palette.foreground : Colors.warning;
                clicked => { root.open-settings(); }
            }

            IconButton {
                shape: Shapes.sync;
                enabled: !root.syncing;
                clicked => { root.sync(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        // Permanent Search Bar
        Rectangle {
            height: 50px;
            search-box := Rectangle {
                x: 10px;
                y: 5px;
                width: parent.width - 20px;
                height: 40px;
                border-radius: 20px;
                background: Palette.foreground.with-alpha(0.06);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;

                    Rectangle {
                        width: 18px;
                        horizontal-stretch: 0;
                        Icon {
                            shape: Shapes.search;
                            tint: Colors.muted;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if search-input.text == "": Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            text: "Search notes...";
                            font-size: 14px;
                            color: Colors.muted;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            single-line: true;
                            text <=> root.search-query;
                            font-size: 14px;
                            color: Palette.foreground;
                            edited => {
                                root.search-query-changed(self.text);
                            }
                        }
                    }

                    if root.search-query != "": Rectangle {
                        width: 28px;
                        height: 28px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        border-radius: 14px;
                        background: clear-btn.pressed ? Palette.foreground.with-alpha(0.12) : transparent;

                        Icon {
                            shape: Shapes.close;
                            tint: Colors.muted;
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        clear-btn := TouchArea {
                            clicked => {
                                root.search-query = "";
                                root.search-query-changed("");
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        // Top spacing before first list card
        Rectangle {
            height: 4px;
        }

        if root.notes.length == 0 && root.search-query != "": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Icon {
                    shape: Shapes.search;
                    tint: Colors.muted;
                    width: 32px;
                    height: 32px;
                    x: (parent.width - self.width) / 2;
                }
                Text {
                    text: "No notes matching \"" + root.search-query + "\"";
                    font-size: 14px;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.notes.length > 0 || root.search-query == "": ListView {
            vertical-stretch: 1;
            for name[i] in root.notes: Rectangle {
                property <bool> has-snippet: root.snippets.length > i && root.snippets[i] != "";
                height: has-snippet ? 66px : 54px;

                // Pill / rounded container with side insets and vertical gaps
                item-container := Rectangle {
                    x: 8px;
                    y: 3px;
                    width: parent.width - 16px;
                    height: parent.height - 6px;
                    border-radius: 20px;
                    background: (root.highlight-current && i == root.current)
                        ? Palette.accent-background.with-alpha(0.20)
                        : (touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent);

                    animate background {
                        duration: 150ms;
                        easing: ease-out;
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: name;
                                font-size: 15px;
                                font-weight: (root.highlight-current && i == root.current) ? 600 : 400;
                                color: (root.highlight-current && i == root.current)
                                    ? Palette.accent-background
                                    : Palette.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if has-snippet: Text {
                                text: root.snippets[i];
                                font-size: 12px;
                                color: Colors.muted;
                                overflow: elide;
                            }
                        }

                        if root.conflicted[i]: Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Colors.warning;
                        }
                    }
                }

                // A `clicked` still fires on release even after a long
                // hold (TouchArea doesn't time-limit it) -- this is what
                // tells that `clicked` apart from the tap that opens the
                // note, once the long-press timer already acted on it.
                property <bool> long-pressed: false;

                touch := TouchArea {
                    property <bool> swiped: false;
                    property <length> dx: self.pressed-x - self.mouse-x;
                    property <length> dy: self.mouse-y > self.pressed-y ? self.mouse-y - self.pressed-y : self.pressed-y - self.mouse-y;
                    moved => {
                        if (self.pressed && dx > 24px && dx > dy) {
                            swiped = true;
                            root.close-drawer();
                        }
                    }
                    clicked => {
                        if (swiped) {
                            swiped = false;
                        } else if (long-pressed) {
                            long-pressed = false;
                        } else {
                            root.select(i);
                        }
                    }
                }

                // Fires once after a held press, not repeatedly: it turns
                // itself off as soon as it fires. Released or moved-away
                // presses never reach `interval`, since `running` tracks
                // `touch.pressed` directly.
                Timer {
                    interval: 500ms;
                    running: touch.pressed && !long-pressed && !touch.swiped;
                    triggered => {
                        long-pressed = true;
                        root.trigger-haptic();
                        root.note-menu-requested(i);
                    }
                }
            }
        }
    }

    Fab {
        x: parent.width - self.width - Metrics.gutter;
        y: parent.height - self.height - Metrics.gutter - root.inset-bottom;
        clicked => { root.new-note(); }
    }
}
