import { Palette, ListView } from "std-widgets.slint";
import { Metrics, Colors, Shapes, IconButton, TopBar, Fab, ActionRow } from "components.slint";

export component ListPane inherits Rectangle {
    in property <[string]> notes;
    in property <[bool]> conflicted;
    in property <int> current: -1;
    in property <string> status;
    in property <bool> syncing;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // The editor sits beside the list, so the open note stays highlighted.
    in property <bool> highlight-current: false;
    // Whether a remote is linked yet -- shown as a dot on the link icon.
    in property <bool> remote-configured: false;
    callback select(int);
    callback new-note();
    callback sync();
    callback link();
    // Fired once the user picks an action from the long-press sheet;
    // Rust owns the actual confirmation/rename dialogs (see app.slint),
    // so this is just "which note, which action" -- nothing here needs
    // a round-trip to Rust just to show or hide the sheet itself.
    callback rename-requested(int);
    callback delete-requested(int);

    // Which row's long-press action sheet is open, if any. Purely local
    // UI state -- Rust never needs to know this was ever shown.
    property <int> menu-index: -1;

    background: Palette.background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            // Aligns the title with the rows below.
            Rectangle {
                width: Metrics.gutter - 4px;
            }
            Text {
                horizontal-stretch: 1;
                text: root.status != "" ? root.status : "Notes";
                font-size: root.status != "" ? 14px : 22px;
                font-weight: root.status != "" ? 400 : 600;
                color: root.status != "" ? Colors.muted : Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
            }
            IconButton {
                shape: Shapes.link;
                // Warns that nothing is linked yet.
                tint: root.remote-configured ? Palette.foreground : Colors.warning;
                clicked => { root.link(); }
            }
            IconButton {
                shape: Shapes.sync;
                enabled: !root.syncing;
                clicked => { root.sync(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        ListView {
            vertical-stretch: 1;
            for name[i] in root.notes: Rectangle {
                height: Metrics.row-height;
                background: (root.highlight-current && i == root.current)
                    ? Palette.accent-background.with-alpha(0.16)
                    : (touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent);

                // A `clicked` still fires on release even after a long
                // hold (TouchArea doesn't time-limit it) -- this is what
                // tells that `clicked` apart from the tap that opens the
                // note, once the long-press timer already acted on it.
                property <bool> long-pressed: false;

                HorizontalLayout {
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: name;
                        font-size: 17px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.conflicted[i]: Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: Colors.warning;
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    x: Metrics.gutter;
                    width: parent.width - Metrics.gutter;
                    background: Colors.separator;
                }

                touch := TouchArea {
                    clicked => {
                        if (long-pressed) {
                            long-pressed = false;
                        } else {
                            root.select(i);
                        }
                    }
                }

                // Fires once after a held press, not repeatedly: it turns
                // itself off as soon as it fires. Released or moved-away
                // presses never reach `interval`, since `running` tracks
                // `touch.pressed` directly.
                Timer {
                    interval: 500ms;
                    running: touch.pressed;
                    triggered => {
                        self.running = false;
                        long-pressed = true;
                        root.menu-index = i;
                    }
                }
            }
        }
    }

    Fab {
        x: parent.width - self.width - Metrics.gutter;
        y: parent.height - self.height - Metrics.gutter - root.inset-bottom;
        clicked => { root.new-note(); }
    }

    if root.menu-index >= 0: Rectangle {
        // Covers the whole pane so a tap outside the sheet dismisses it.
        background: #00000055;
        TouchArea {
            clicked => { root.menu-index = -1; }
        }

        Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: sheet-layout.preferred-height;
            background: Palette.background;
            border-radius: 12px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000044;

            sheet-layout := VerticalLayout {
                padding-bottom: root.inset-bottom;
                ActionRow {
                    text: "Rename";
                    clicked => {
                        root.rename-requested(root.menu-index);
                        root.menu-index = -1;
                    }
                }
                ActionRow {
                    text: "Delete";
                    tint: Colors.danger;
                    clicked => {
                        root.delete-requested(root.menu-index);
                        root.menu-index = -1;
                    }
                }
            }
        }
    }
}
