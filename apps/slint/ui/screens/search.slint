import { Palette } from "std-widgets.slint";
import {
    Metrics,
    Colors,
    Shapes,
    TopBar,
    Icon,
    AppScrollView,
} from "../components.slint";

export component SearchScreen inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    in-out property <string> query: "";
    in property <[string]> notes: [];
    in property <[string]> snippets: [];
    in property <[bool]> conflicted: [];

    callback query-changed(string);
    callback select(int);

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;

            // Search bar taking full width of top bar
            Rectangle {
                horizontal-stretch: 1;
                height: Metrics.search-bar-height;
                border-radius: self.height / 2;
                background: Palette.alternate-background;

                HorizontalLayout {
                    padding-left: Metrics.spacing-md;
                    padding-right: Metrics.spacing-sm;
                    spacing: Metrics.spacing-sm;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            shape: Shapes.search;
                            tint: Colors.muted;
                            width: Metrics.icon-md;
                            height: Metrics.icon-md;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if root.query == "": Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            text: "ノートのタイトルや本文を検索...";
                            font-size: Metrics.font-md;
                            color: Colors.muted;
                            overflow: elide;
                        }

                        search_input := TextInput {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            font-size: Metrics.font-md;
                            color: Palette.foreground;
                            selection-background-color: Palette.accent-background.with-alpha(0.3);
                            selection-foreground-color: Palette.foreground;
                            single-line: true;
                            text <=> root.query;
                            edited => {
                                root.query-changed(self.text);
                            }
                        }
                    }

                    if root.query != "": VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: Metrics.icon-lg + 4px * Metrics.ui-scale;
                            height: self.width;
                            horizontal-stretch: 0;
                            border-radius: self.width / 2;
                            background: clear_btn.pressed ? Palette.foreground.with-alpha(0.12) : transparent;

                            Icon {
                                shape: Shapes.close;
                                tint: Colors.muted;
                                width: Metrics.icon-sm;
                                height: Metrics.icon-sm;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            clear_btn := TouchArea {
                                clicked => {
                                    root.query = "";
                                    root.query-changed("");
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        // Top spacing
        Rectangle {
            height: Metrics.spacing-xs + 2px * Metrics.ui-scale;
        }

        // Empty state when search query produced no results
        if root.notes.length == 0 && root.query != "": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-md;

                Icon {
                    shape: Shapes.search;
                    tint: Colors.muted;
                    width: Metrics.icon-xl;
                    height: Metrics.icon-xl;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: "\"" + root.query + "\" に一致するノートはありません";
                    font-size: Metrics.font-md;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        // Initial empty state when no query typed
        if root.query == "": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-sm;

                Icon {
                    shape: Shapes.search;
                    tint: Colors.muted.with-alpha(0.4);
                    width: Metrics.icon-xl;
                    height: Metrics.icon-xl;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: "タイトルや本文でノートを検索できます";
                    font-size: Metrics.font-md;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        // Search Results List
        if root.notes.length > 0 && root.query != "": AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: root.inset-bottom + Metrics.spacing-2xl;

                for name[i] in root.notes: Rectangle {
                    property <bool> has-snippet: root.snippets.length > i && root.snippets[i] != "";
                    height: has-snippet ? (Metrics.row-height + 10px * Metrics.ui-scale) : Metrics.row-height;

                    item_container := Rectangle {
                        x: Metrics.spacing-sm;
                        y: Metrics.spacing-xs / 2;
                        width: parent.width - Metrics.spacing-lg;
                        height: parent.height - Metrics.spacing-xs;
                        border-radius: Metrics.radius-lg;
                        background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
                        animate background {
                            duration: 120ms;
                            easing: ease-out;
                        }

                        HorizontalLayout {
                            padding-left: Metrics.spacing-lg;
                            padding-right: Metrics.spacing-lg;
                            spacing: Metrics.spacing-md;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px * Metrics.ui-scale;

                                Text {
                                    text: name;
                                    font-size: Metrics.font-body;
                                    font-weight: 500;
                                    color: Palette.foreground;
                                    overflow: elide;
                                }

                                if has-snippet: Text {
                                    text: root.snippets[i];
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    overflow: elide;
                                }
                            }

                            if root.conflicted.length > i && root.conflicted[i]: Rectangle {
                                width: Metrics.spacing-sm;
                                height: Metrics.spacing-sm;
                                y: (parent.height - self.height) / 2;
                                border-radius: Metrics.spacing-sm / 2;
                                background: Colors.warning;
                            }
                        }

                        touch := TouchArea {
                            clicked => {
                                root.select(i);
                            }
                        }
                    }
                }
            }
        }
    }
}
