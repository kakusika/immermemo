import { Palette, Button } from "std-widgets.slint";
import {
    Metrics,
    Colors,
    Shapes,
    Icon,
    BubbleButton,
    TopBar,
    ActionRow,
    AppScrollView,
} from "../components.slint";

export component HomeScreen inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    // Vault info
    in property <string> vault-name: "Default";
    in property <string> vault-path: "";
    in property <int> note-count: 0;
    in property <int> conflict-count: 0;
    in property <string> status: "";
    in property <bool> syncing: false;
    in property <bool> remote-configured: false;
    in property <string> last-sync-error: "";
    in property <bool> sync-error-copied: false;
    in property <string> last-synced-at: "";

    // Currently open / recent note
    in property <string> current-note-title: "";
    in property <bool> has-current-note: false;

    callback new-note();
    callback sync();
    callback open-vaults();
    callback open-settings();
    callback open-vault-history();
    callback open-current-note();
    callback open-conflict-note();
    callback copy-sync-error();
    callback dismiss-sync-error();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;

            Text {
                horizontal-stretch: 1;
                text: "ホーム";
                font-size: Metrics.font-title;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            BubbleButton {
                shape: Shapes.sync;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                enabled: !root.syncing;
                clicked => { root.sync(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: Metrics.spacing-lg;
                padding-bottom: root.inset-bottom + Metrics.spacing-2xl;
                spacing: Metrics.spacing-xl;

                // ----------------------------------------------------
                // Section: Active Vault Card
                // ----------------------------------------------------
                Rectangle {
                    border-radius: Metrics.radius-md;
                    background: Palette.alternate-background;

                    VerticalLayout {
                        padding: Metrics.spacing-lg;
                        spacing: Metrics.spacing-md;

                        HorizontalLayout {
                            spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px * Metrics.ui-scale;

                                Text {
                                    text: "現在の保管庫";
                                    font-size: Metrics.font-caption;
                                    font-weight: 700;
                                    color: Colors.muted;
                                    letter-spacing: 0.5px;
                                }

                                Text {
                                    text: root.vault-name != "" ? root.vault-name : "Notes";
                                    font-size: Metrics.font-title;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }
                            }

                            BubbleButton {
                                shape: Shapes.files;
                                clicked => { root.open-vaults(); }
                            }
                        }

                        if root.vault-path != "": Text {
                            text: root.vault-path;
                            font-size: Metrics.font-sm;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 1px;
                            background: Colors.separator;
                        }

                        HorizontalLayout {
                            spacing: Metrics.spacing-lg;

                            VerticalLayout {
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: "ノート数";
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                }

                                Text {
                                    text: root.note-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            if root.conflict-count > 0: VerticalLayout {
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: "競合";
                                    font-size: Metrics.font-sm;
                                    color: Colors.warning;
                                }

                                Text {
                                    text: root.conflict-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Colors.warning;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            if root.status != "": Text {
                                text: root.status;
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Sync Status
                // ----------------------------------------------------
                VerticalLayout {
                    spacing: Metrics.spacing-sm;

                    HorizontalLayout {
                        spacing: Metrics.spacing-sm;

                        Text {
                            horizontal-stretch: 1;
                            text: "同期ステータス";
                            font-size: Metrics.font-caption;
                            font-weight: 700;
                            color: Colors.muted;
                            letter-spacing: 0.5px;
                        }

                        if root.syncing: HorizontalLayout {
                            spacing: Metrics.spacing-xs;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;

                                Icon {
                                    width: Metrics.icon-sm;
                                    height: Metrics.icon-sm;
                                    shape: Shapes.sync;
                                    tint: Palette.accent-background;
                                }
                            }

                            Text {
                                text: "同期中...";
                                font-size: Metrics.font-caption;
                                font-weight: 600;
                                color: Palette.accent-background;
                            }
                        }
                    }

                    // Card: Error State (When last-sync-error != "")
                    if root.last-sync-error != "": Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Colors.danger.with-alpha(0.08);
                        border-width: 1.5px;
                        border-color: Colors.danger.with-alpha(0.4);

                        VerticalLayout {
                            padding: Metrics.spacing-md + 2px * Metrics.ui-scale;
                            spacing: Metrics.spacing-md;

                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-md;
                                        height: Metrics.icon-md;
                                        shape: Shapes.close;
                                        tint: Colors.danger;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: "同期に失敗しました";
                                    font-size: Metrics.font-body;
                                    font-weight: 700;
                                    color: Colors.danger;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: Metrics.icon-lg + 4px * Metrics.ui-scale;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: Palette.foreground.with-alpha(0.06);

                                        TouchArea {
                                            clicked => { root.dismiss-sync-error(); }
                                        }

                                        Icon {
                                            width: Metrics.icon-sm;
                                            height: Metrics.icon-sm;
                                            shape: Shapes.close;
                                            tint: Colors.muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }

                            // Error text display (selectable, word-wrapped)
                            Rectangle {
                                border-radius: Metrics.radius-sm;
                                background: Palette.background;
                                border-width: 1px;
                                border-color: Colors.separator;

                                VerticalLayout {
                                    padding: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                    TextInput {
                                        text: root.last-sync-error;
                                        read-only: true;
                                        wrap: word-wrap;
                                        color: Palette.foreground;
                                        font-size: Metrics.font-sm;
                                    }
                                }
                            }

                            // Action buttons: Copy Error and Retry Sync
                            HorizontalLayout {
                                spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Metrics.bubble-button-size;
                                    border-radius: Metrics.radius-sm;
                                    background: root.sync-error-copied
                                        ? #2e7d32.with-alpha(0.18)
                                        : Palette.alternate-background;
                                    border-width: 1px;
                                    border-color: root.sync-error-copied
                                        ? #2e7d32.with-alpha(0.5)
                                        : Colors.separator;

                                    TouchArea {
                                        clicked => { root.copy-sync-error(); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;

                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                width: Metrics.icon-sm;
                                                height: Metrics.icon-sm;
                                                shape: root.sync-error-copied ? Shapes.check : Shapes.copy;
                                                tint: root.sync-error-copied ? #2e7d32 : Palette.foreground;
                                            }
                                        }

                                        Text {
                                            text: root.sync-error-copied ? "コピーしました" : "エラーをコピー";
                                            font-size: Metrics.font-sub;
                                            font-weight: 600;
                                            color: root.sync-error-copied ? #2e7d32 : Palette.foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: Metrics.bubble-button-size;
                                    width: 100px * Metrics.ui-scale;
                                    border-radius: Metrics.radius-sm;
                                    background: Palette.accent-background;
                                    opacity: root.syncing ? 0.6 : 1.0;

                                    TouchArea {
                                        enabled: !root.syncing;
                                        clicked => { root.sync(); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;

                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                width: Metrics.icon-sm;
                                                height: Metrics.icon-sm;
                                                shape: Shapes.sync;
                                                tint: #ffffff;
                                            }
                                        }

                                        Text {
                                            text: "再試行";
                                            font-size: Metrics.font-sub;
                                            font-weight: 600;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Card: Normal / Idle / Remote Not Configured
                    if root.last-sync-error == "": Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Palette.alternate-background;

                        VerticalLayout {
                            padding: Metrics.spacing-md + 2px * Metrics.ui-scale;
                            spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                            if !root.remote-configured: HorizontalLayout {
                                spacing: Metrics.spacing-md;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-lg;
                                        height: Metrics.icon-lg;
                                        shape: Shapes.link;
                                        tint: Colors.muted;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px * Metrics.ui-scale;

                                    Text {
                                        text: "リモート未設定";
                                        font-size: Metrics.font-body;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }

                                    Text {
                                        text: "Git リモートを設定すると自動同期できます";
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: Metrics.bubble-chip-height;
                                        width: 60px * Metrics.ui-scale;
                                        border-radius: Metrics.radius-sm;
                                        background: Palette.accent-background.with-alpha(0.12);

                                        TouchArea {
                                            clicked => { root.open-settings(); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "設定";
                                                font-size: Metrics.font-sm;
                                                font-weight: 600;
                                                color: Palette.accent-background;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.remote-configured: HorizontalLayout {
                                spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-md;
                                        height: Metrics.icon-md;
                                        shape: Shapes.sync;
                                        tint: root.syncing ? Palette.accent-background : Colors.muted;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px * Metrics.ui-scale;

                                    Text {
                                        text: root.syncing ? "同期を実行中..." : "同期完了";
                                        font-size: Metrics.font-body;
                                        font-weight: 600;
                                        color: root.syncing ? Palette.accent-background : Palette.foreground;
                                    }

                                    Text {
                                        text: root.syncing
                                            ? "リモートとの差分を確認・更新しています"
                                            : (root.last-synced-at != "" ? "最終同期: " + root.last-synced-at : (root.status != "" ? root.status : "ローカルとリモートは同期済みです"));
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: Metrics.bubble-chip-height;
                                        width: 80px * Metrics.ui-scale;
                                        border-radius: Metrics.radius-sm;
                                        background: Palette.foreground.with-alpha(0.06);

                                        TouchArea {
                                            enabled: !root.syncing;
                                            clicked => { root.sync(); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: Metrics.spacing-xs;

                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    width: Metrics.icon-sm;
                                                    height: Metrics.icon-sm;
                                                    shape: Shapes.sync;
                                                    tint: root.syncing ? Colors.muted : Palette.foreground;
                                                }
                                            }

                                            Text {
                                                text: "同期";
                                                font-size: Metrics.font-sm;
                                                font-weight: 600;
                                                color: root.syncing ? Colors.muted : Palette.foreground;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Unresolved Conflicts
                // ----------------------------------------------------
                if root.conflict-count > 0: VerticalLayout {
                    spacing: Metrics.spacing-sm;

                    Text {
                        text: "未解決のコンフリクト";
                        font-size: Metrics.font-caption;
                        font-weight: 700;
                        color: Colors.warning;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Colors.warning.with-alpha(0.12);
                        border-width: 1.5px;
                        border-color: Colors.warning.with-alpha(0.4);

                        TouchArea {
                            clicked => { root.open-conflict-note(); }
                        }

                        VerticalLayout {
                            padding: Metrics.spacing-lg;
                            spacing: Metrics.spacing-sm;

                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;
                                alignment: center;

                                Text {
                                    text: "⚠️";
                                    font-size: Metrics.font-subtitle;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.conflict-count + " 件のノートに競合があります";
                                    font-size: Metrics.font-body;
                                    font-weight: 700;
                                    color: Colors.warning;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "タップして競合ノートを開く・解決する →";
                                font-size: Metrics.font-sub;
                                font-weight: 600;
                                color: Colors.warning.darker(10%);
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Currently Open Note
                // ----------------------------------------------------
                if root.has-current-note: VerticalLayout {
                    spacing: Metrics.spacing-sm;

                    Text {
                        text: "編集中ノート";
                        font-size: Metrics.font-caption;
                        font-weight: 700;
                        color: Colors.muted;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Palette.alternate-background;

                        TouchArea {
                            clicked => { root.open-current-note(); }
                        }

                        VerticalLayout {
                            padding: Metrics.spacing-lg;
                            spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;

                            Text {
                                text: root.current-note-title;
                                font-size: Metrics.font-body;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Text {
                                text: "タップして編集を続ける →";
                                font-size: Metrics.font-sub;
                                color: Palette.accent-background;
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Quick Actions
                // ----------------------------------------------------
                VerticalLayout {
                    spacing: Metrics.spacing-sm;

                    Text {
                        text: "クイックアクション";
                        font-size: Metrics.font-caption;
                        font-weight: 700;
                        color: Colors.muted;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Palette.alternate-background;

                        VerticalLayout {
                            padding: Metrics.spacing-sm;
                            spacing: Metrics.spacing-xs;

                            ActionRow {
                                text: "+ 新しいノート";
                                tint: Palette.accent-background;
                                clicked => { root.new-note(); }
                            }

                            ActionRow {
                                text: "保管庫を切り替え...";
                                clicked => { root.open-vaults(); }
                            }

                            ActionRow {
                                text: "設定・同期...";
                                clicked => { root.open-settings(); }
                            }

                            ActionRow {
                                text: "保管庫の履歴・コミット...";
                                clicked => { root.open-vault-history(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
