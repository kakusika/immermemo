import { Palette, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Shapes } from "@origami-mobile/icons.slint";
import { TopBar, ActionRow, AppScrollView } from "@origami-mobile/components.slint";

export component PropertiesScreen inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    in property <bool> has-note: false;
    in property <string> note-title: "";
    in property <string> note-path: "";
    in property <int> char-count: 0;
    in property <int> word-count: 0;
    in property <int> line-count: 0;
    in property <bool> has-conflict: false;
    in property <int> conflict-total: 0;
    in property <string> conflict-mine-preview: "";
    in property <string> conflict-theirs-preview: "";

    callback rename-requested();
    callback delete-requested();
    callback resolve-mine();
    callback resolve-theirs();
    callback open-conflict-sheet();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;

            Text {
                horizontal-stretch: 1;
                text: @tr("Properties");
                font-size: Metrics.font-title;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        if !root.has-note: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-md;
                Text {
                    text: @tr("No note is currently open.");
                    font-size: Metrics.font-body;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.has-note: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: Metrics.spacing-lg;
                padding-bottom: root.inset-bottom + Metrics.spacing-2xl;
                spacing: Metrics.spacing-xl;

                // ----------------------------------------------------
                // Section: Document Info
                // ----------------------------------------------------
                Rectangle {
                    border-radius: Metrics.radius-md;
                    background: Colors.surface-elevated;

                    VerticalLayout {
                        padding: Metrics.spacing-lg;
                        spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: Metrics.spacing-xs;
                            Text {
                                text: @tr("Note Info");
                                font-size: Metrics.font-caption;
                                font-weight: 700;
                                color: Colors.muted;
                                letter-spacing: 0.5px;
                            }

                            Text {
                                text: root.note-title;
                                font-size: Metrics.font-subtitle;
                                font-weight: 700;
                                color: Palette.foreground;
                            }

                            if root.note-path != "": Text {
                                text: root.note-path;
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Colors.separator;
                        }

                        // Statistics
                        HorizontalLayout {
                            spacing: Metrics.spacing-lg;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("Characters");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                }

                                Text {
                                    text: root.char-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("Words");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                }

                                Text {
                                    text: root.word-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("Lines");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                }

                                Text {
                                    text: root.line-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Conflict Status
                // ----------------------------------------------------
                if root.has-conflict: Rectangle {
                    border-radius: Metrics.radius-md;
                    background: Colors.warning.with-alpha(0.12);
                    border-width: 1.5px;
                    border-color: Colors.warning.with-alpha(0.4);

                    VerticalLayout {
                        padding: Metrics.spacing-lg;
                        spacing: Metrics.spacing-md;

                        HorizontalLayout {
                            alignment: center;
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: "⚠️";
                                font-size: Metrics.font-body;
                                vertical-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.conflict-total > 0
                                    ? @tr("{n} conflict found" | "{n} conflicts found" % root.conflict-total)
                                    : @tr("Conflict detected");
                                font-size: Metrics.font-body;
                                font-weight: 700;
                                color: Colors.warning;
                                vertical-alignment: center;
                            }
                        }

                        // Conflict Preview cards if preview text is available
                        if root.conflict-mine-preview != "" || root.conflict-theirs-preview != "": VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            if root.conflict-mine-preview != "": Rectangle {
                                border-radius: Metrics.radius-sm;
                                background: Palette.foreground.with-alpha(0.04);
                                border-width: 1px;
                                border-color: Palette.accent-background.with-alpha(0.35);

                                VerticalLayout {
                                    padding: Metrics.spacing-sm;
                                    spacing: Metrics.spacing-xs;
                                    Text {
                                        text: @tr("📱 Your changes (Local):");
                                        font-size: Metrics.font-caption;
                                        font-weight: 700;
                                        color: Palette.accent-background;
                                    }

                                    Text {
                                        text: root.conflict-mine-preview;
                                        font-size: Metrics.font-sub;
                                        color: Palette.foreground;
                                        overflow: elide;
                                    }
                                }
                            }

                            if root.conflict-theirs-preview != "": Rectangle {
                                border-radius: Metrics.radius-sm;
                                background: Palette.foreground.with-alpha(0.04);
                                border-width: 1px;
                                border-color: Colors.warning.with-alpha(0.35);

                                VerticalLayout {
                                    padding: Metrics.spacing-sm;
                                    spacing: Metrics.spacing-xs;
                                    Text {
                                        text: @tr("☁️ Remote changes (Remote):");
                                        font-size: Metrics.font-caption;
                                        font-weight: 700;
                                        color: Colors.warning;
                                    }

                                    Text {
                                        text: root.conflict-theirs-preview;
                                        font-size: Metrics.font-sub;
                                        color: Palette.foreground;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // Open Conflict Sheet Button
                        Rectangle {
                            height: Metrics.bubble-button-size;
                            border-radius: self.height / 2;
                            background: resolve-sheet-touch.pressed ? Colors.warning.darker(15%) : Colors.warning;

                            HorizontalLayout {
                                alignment: center;
                                spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("🔍 Open resolution sheet");
                                    font-size: Metrics.font-sub;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }

                            resolve-sheet-touch := TouchArea {
                                clicked => { root.open-conflict-sheet(); }
                            }
                        }

                        // Quick action buttons
                        HorizontalLayout {
                            spacing: Metrics.spacing-sm;
                            Button {
                                horizontal-stretch: 1;
                                text: @tr("Keep Mine");
                                clicked => { root.resolve-mine(); }
                            }

                            Button {
                                horizontal-stretch: 1;
                                text: @tr("Keep Theirs");
                                clicked => { root.resolve-theirs(); }
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Note Actions
                // ----------------------------------------------------
                VerticalLayout {
                    spacing: Metrics.spacing-sm;

                    Text {
                        text: @tr("Actions");
                        font-size: Metrics.font-caption;
                        font-weight: 700;
                        color: Colors.muted;
                        letter-spacing: 0.5px;
                    }

                    Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Colors.surface-elevated;

                        VerticalLayout {
                            padding: Metrics.spacing-sm;
                            spacing: Metrics.spacing-xs;

                            ActionRow {
                                text: @tr("Rename...");
                                clicked => { root.rename-requested(); }
                            }

                            ActionRow {
                                text: @tr("Delete Note...");
                                tint: Colors.danger;
                                clicked => { root.delete-requested(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
