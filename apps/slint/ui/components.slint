export component IconButton inherits Rectangle {
    in property <string> shape;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: Metrics.touch;
    height: 100%;
    min-height: Metrics.touch;

    circle := Rectangle {
        width: Metrics.touch;
        height: Metrics.touch;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.14) : transparent;

        Icon {
            shape: root.shape;
            tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopBar inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <string> title;
    in property <string> subtitle;
    // Slots for the buttons at either end.
    height: root.inset-top + Metrics.bar-height;
    background: Palette.background;

    VerticalLayout {
        padding-top: root.inset-top;
        HorizontalLayout {
            height: Metrics.bar-height;
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-sm;
            @children
        }
    }
}

// Circular bubble button for headers
export component BubbleButton inherits Rectangle {
    in property <string> shape;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: Metrics.bubble-button-size;
    height: 100%;
    min-height: Metrics.touch;

    bubble := Rectangle {
        width: Metrics.bubble-button-size;
        height: Metrics.bubble-button-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background {
            duration: 120ms;
            easing: ease-out;
        }

        Icon {
            shape: root.shape;
            tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            width: Metrics.icon-md;
            height: Metrics.icon-md;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            animate tint {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Pill-shaped bubble button with text (e.g. Vault switcher, actions)
export component BubbleChip inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    preferred-height: Metrics.touch;

    chip := Rectangle {
        height: Metrics.bubble-chip-height;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background {
            duration: 120ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;
            alignment: center;

            if root.icon != "": Icon {
                shape: root.icon;
                tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.text;
                font-size: Metrics.font-md;
                font-weight: 600;
                color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Capsule-grouped undo/redo bubble
export component UndoRedoBubble inherits Rectangle {
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    callback undo();
    callback redo();

    width: Metrics.bubble-button-size * 2 + 2px * Metrics.ui-scale;
    height: 100%;
    min-height: Metrics.touch;

    capsule := Rectangle {
        width: Metrics.bubble-button-size * 2 + 2px * Metrics.ui-scale;
        height: Metrics.bubble-button-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.height / 2;
        background: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            undo-box := Rectangle {
                width: (parent.width - 1px) / 2;
                height: Metrics.bubble-button-size;
                border-top-left-radius: self.height / 2;
                border-bottom-left-radius: self.height / 2;
                background: undo-touch.pressed && root.can-undo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    shape: Shapes.undo;
                    tint: root.can-undo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                undo-touch := TouchArea {
                    enabled: root.can-undo;
                    clicked => { root.undo(); }
                }
            }

            // Divider line between undo and redo
            Rectangle {
                width: 1px;
                height: Metrics.icon-md;
                y: (parent.height - self.height) / 2;
                background: Colors.separator;
            }

            redo-box := Rectangle {
                width: (parent.width - 1px) / 2;
                height: Metrics.bubble-button-size;
                border-top-right-radius: self.height / 2;
                border-bottom-right-radius: self.height / 2;
                background: redo-touch.pressed && root.can-redo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    shape: Shapes.redo;
                    tint: root.can-redo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                redo-touch := TouchArea {
                    enabled: root.can-redo;
                    clicked => { root.redo(); }
                }
            }
        }
    }
}

// A tappable text row for an action sheet or menu -- not a list row (no
// separator, no selection highlight of its own).
export component ActionRow inherits Rectangle {
    in property <string> text;
    in property <color> tint: Palette.foreground;
    callback clicked();

    height: Metrics.touch;
    border-radius: Metrics.radius-sm + 2px * Metrics.ui-scale;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    Text {
        x: Metrics.gutter;
        text: root.text;
        color: root.tint;
        font-size: Metrics.font-body + 1px * Metrics.ui-scale;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Fab inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: Metrics.fab;
    height: Metrics.fab;
    border-radius: self.width / 2;
    background: Palette.accent-background;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000055;

    Icon {
        shape: Shapes.plus;
        tint: Palette.accent-foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    callback clicked();

    horizontal-stretch: 1;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 3px * Metrics.ui-scale;
        padding-top: 4px * Metrics.ui-scale;
        padding-bottom: 4px * Metrics.ui-scale;

        // Centered pill indicator
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 60px * Metrics.ui-scale;
                height: 32px * Metrics.ui-scale;
                border-radius: self.height / 2;
                background: root.active ? Palette.accent-background.with-alpha(0.18) : transparent;
                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                Icon {
                    shape: root.icon;
                    tint: root.active ? Palette.accent-background : Colors.muted;
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate tint {
                        duration: 120ms;
                        easing: ease-out;
                    }
                }

                if root.badge-count > 0: Rectangle {
                    x: parent.width - self.width - 4px * Metrics.ui-scale;
                    y: 2px * Metrics.ui-scale;
                    width: root.badge-count > 9 ? 18px * Metrics.ui-scale : 14px * Metrics.ui-scale;
                    height: 14px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.badge-count > 99 ? "99+" : root.badge-count;
                            font-size: Metrics.font-badge;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.badge-count == 0 && root.badge-dot: Rectangle {
                    x: parent.width - 12px * Metrics.ui-scale;
                    y: 3px * Metrics.ui-scale;
                    width: 7px * Metrics.ui-scale;
                    height: 7px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;
                }
            }
        }

        Text {
            text: root.label;
            font-size: Metrics.font-sm;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Palette.accent-background : Colors.muted;
            horizontal-alignment: center;
            animate color {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }
}

// Floating Mini-Player Note Card shown above the bottom nav bar
export component MiniNoteCard inherits Rectangle {
    in property <string> title: "";
    in property <string> preview: "";
    in property <bool> has-conflict: false;
    in property <bool> syncing: false;
    callback clicked();
    callback expand();

    height: Metrics.mini-card-height;
    background: Colors.surface-elevated;
    border-radius: Metrics.radius-lg;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    HorizontalLayout {
        padding-left: 8px * Metrics.ui-scale;
        padding-right: 8px * Metrics.ui-scale;
        spacing: 8px * Metrics.ui-scale;

        // Left note icon badge (vertically centered)
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px * Metrics.ui-scale;
                height: 36px * Metrics.ui-scale;
                border-radius: Metrics.radius-md;
                background: root.has-conflict
                    ? Colors.warning.with-alpha(0.18)
                    : Palette.accent-background.with-alpha(0.18);

                Icon {
                    shape: root.has-conflict ? Shapes.alert : Shapes.note;
                    tint: root.has-conflict ? Colors.warning : Palette.accent-background;
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Center title & excerpt
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title != "" ? root.title : "Untitled";
                font-size: Metrics.font-body;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.has-conflict: Text {
                text: "競合が発生しています";
                font-size: Metrics.font-caption;
                color: Colors.warning;
                overflow: elide;
            }

            if !root.has-conflict && root.preview != "": Text {
                text: root.preview;
                font-size: Metrics.font-caption;
                color: Colors.muted;
                overflow: elide;
            }
        }

        // Right expand chevron (vertically centered)
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 32px * Metrics.ui-scale;
                height: 32px * Metrics.ui-scale;
                border-radius: self.height / 2;
                background: touch.pressed ? Palette.foreground.with-alpha(0.1) : transparent;

                Icon {
                    shape: Shapes.up;
                    tint: Colors.muted;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component BottomNavBar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in property <length> inset-bottom: 0px;
    in property <int> conflict-count: 0;
    in property <bool> current-has-conflict: false;
    callback tab-selected(int);

    height: Metrics.bottom-bar-height + root.inset-bottom;
    background: Colors.surface-elevated;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: -2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #00000088 : #00000018;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: Metrics.bottom-bar-height;
        padding-left: 0px;
        padding-right: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        NavItem {
            icon: Shapes.home;
            label: "ホーム";
            active: root.active-tab == 0;
            clicked => {
                root.active-tab = 0;
                root.tab-selected(0);
            }
        }

        NavItem {
            icon: Shapes.files;
            label: "ファイル一覧";
            active: root.active-tab == 1;
            badge-count: root.conflict-count;
            clicked => {
                root.active-tab = 1;
                root.tab-selected(1);
            }
        }

        NavItem {
            icon: Shapes.search;
            label: "検索";
            active: root.active-tab == 2;
            clicked => {
                root.active-tab = 2;
                root.tab-selected(2);
            }
        }

        NavItem {
            icon: Shapes.properties;
            label: "プロパティ";
            active: root.active-tab == 3;
            clicked => {
                root.active-tab = 3;
                root.tab-selected(3);
            }
        }

        NavItem {
            icon: Shapes.settings;
            label: "設定";
            active: root.active-tab == 4;
            clicked => {
                root.active-tab = 4;
                root.tab-selected(4);
            }
        }
    }
}

// Clean mobile scroll view with a modern floating translucent pill scroll indicator,
// replacing the wireframe outline scrollbar in standard widgets.
export component AppScrollView inherits Rectangle {
    in property <bool> enabled: true;
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-x <=> flickable.content-x;
    in-out property <length> content-y <=> flickable.content-y;
    callback scrolled <=> flickable.flicked;

    clip: true;

    flickable := Flickable {
        width: 100%;
        height: 100%;
        interactive: root.enabled;

        @children
    }

    // Modern mobile floating pill scrollbar (solid semi-transparent, no wireframe box)
    property <bool> show-scrollbar: flickable.content-height > flickable.height + 2px;
    property <length> track-height: flickable.height;
    property <length> thumb-height: max(28px, flickable.height * min(1.0, flickable.height / max(1px, flickable.content-height)));
    property <length> max-scroll: max(1px, flickable.content-height - flickable.height);
    property <length> thumb-y: (-flickable.content-y / root.max-scroll) * (root.track-height - root.thumb-height);

    if root.show-scrollbar: Rectangle {
        x: parent.width - 5px;
        y: min(max(2px, root.thumb-y), root.track-height - root.thumb-height - 2px);
        width: 3px;
        height: root.thumb-height;
        border-radius: 1.5px;
        background: Palette.foreground.with-alpha(0.28);
    }
}
