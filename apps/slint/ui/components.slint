export component IconButton inherits Rectangle {
    in property <string> shape;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: Metrics.touch;
    preferred-height: Metrics.touch;

    circle := Rectangle {
        width: Metrics.touch;
        height: Metrics.touch;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.14) : transparent;

        Icon {
            shape: root.shape;
            tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopBar inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <string> title;
    in property <string> subtitle;
    // Slots for the buttons at either end.
    height: root.inset-top + Metrics.bar-height;
    background: Palette.background;

    VerticalLayout {
        padding-top: root.inset-top;
        HorizontalLayout {
            height: Metrics.bar-height;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            @children
        }
    }
}

// Circular bubble button for headers
export component BubbleButton inherits Rectangle {
    in property <string> shape;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: 36px;
    preferred-height: Metrics.touch;

    bubble := Rectangle {
        width: 36px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background { duration: 120ms; easing: ease-out; }

        Icon {
            shape: root.shape;
            tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
            width: 18px;
            height: 18px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            animate tint { duration: 120ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Pill-shaped bubble button with text (e.g. Vault switcher, actions)
export component BubbleChip inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    preferred-height: Metrics.touch;

    chip := Rectangle {
        height: 34px;
        y: (parent.height - self.height) / 2;
        border-radius: 17px;
        background: touch.pressed && root.enabled
            ? Palette.foreground.with-alpha(0.16)
            : Palette.foreground.with-alpha(0.08);
        animate background { duration: 120ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            alignment: center;

            if root.icon != "": Icon {
                shape: root.icon;
                tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.text;
                font-size: 14px;
                font-weight: 600;
                color: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Capsule-grouped undo/redo bubble
export component UndoRedoBubble inherits Rectangle {
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    callback undo();
    callback redo();

    width: 76px;
    preferred-height: Metrics.touch;

    capsule := Rectangle {
        width: 76px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: Palette.foreground.with-alpha(0.08);

        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            undo-box := Rectangle {
                width: 37px;
                height: 36px;
                border-top-left-radius: 18px;
                border-bottom-left-radius: 18px;
                background: undo-touch.pressed && root.can-undo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    shape: Shapes.undo;
                    tint: root.can-undo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                undo-touch := TouchArea {
                    enabled: root.can-undo;
                    clicked => { root.undo(); }
                }
            }

            // Divider line between undo and redo
            Rectangle {
                width: 1px;
                height: 18px;
                y: 9px;
                background: Colors.separator;
            }

            redo-box := Rectangle {
                width: 37px;
                height: 36px;
                border-top-right-radius: 18px;
                border-bottom-right-radius: 18px;
                background: redo-touch.pressed && root.can-redo ? Palette.foreground.with-alpha(0.14) : transparent;

                Icon {
                    shape: Shapes.redo;
                    tint: root.can-redo ? Palette.foreground : Colors.muted.with-alpha(0.3);
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                redo-touch := TouchArea {
                    enabled: root.can-redo;
                    clicked => { root.redo(); }
                }
            }
        }
    }
}

// A tappable text row for an action sheet or menu -- not a list row (no
// separator, no selection highlight of its own).
export component ActionRow inherits Rectangle {
    in property <string> text;
    in property <color> tint: Palette.foreground;
    callback clicked();

    height: Metrics.touch;
    border-radius: 10px;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background { duration: 150ms; easing: ease-out; }

    Text {
        x: Metrics.gutter;
        text: root.text;
        color: root.tint;
        font-size: 17px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Fab inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: Metrics.fab;
    height: Metrics.fab;
    border-radius: self.width / 2;
    background: Palette.accent-background;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000055;

    Icon {
        shape: Shapes.plus;
        tint: Palette.accent-foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    callback clicked();

    horizontal-stretch: 1;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 3px;
        padding-top: 4px;
        padding-bottom: 4px;

        // Centered pill indicator
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 56px;
                height: 28px;
                border-radius: 14px;
                background: root.active ? Palette.accent-background.with-alpha(0.18) : transparent;
                animate background { duration: 150ms; easing: ease-out; }

                Icon {
                    shape: root.icon;
                    tint: root.active ? Palette.accent-background : Colors.muted;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate tint { duration: 120ms; easing: ease-out; }
                }

                if root.badge-count > 0: Rectangle {
                    x: parent.width - self.width - 4px;
                    y: 1px;
                    width: root.badge-count > 9 ? 18px : 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Colors.warning;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.badge-count > 99 ? "99+" : root.badge-count;
                            font-size: 9px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.badge-count == 0 && root.badge-dot: Rectangle {
                    x: parent.width - 12px;
                    y: 3px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Colors.warning;
                }
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Palette.accent-background : Colors.muted;
            horizontal-alignment: center;
            animate color { duration: 120ms; easing: ease-out; }
        }
    }
}

export component BottomNavBar inherits Rectangle {
    in-out property <int> active-tab: 2;
    in property <length> inset-bottom: 0px;
    in property <int> conflict-count: 0;
    in property <bool> current-has-conflict: false;
    callback tab-selected(int);

    height: 58px + root.inset-bottom;
    background: Palette.background;

    // Subtle top border / separator
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: Colors.separator;
    }

    HorizontalLayout {
        x: 0px;
        y: 1px;
        width: 100%;
        height: 57px;
        padding-left: 0px;
        padding-right: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        NavItem {
            icon: Shapes.home;
            label: "ホーム";
            active: root.active-tab == 0;
            clicked => {
                root.active-tab = 0;
                root.tab-selected(0);
            }
        }
        NavItem {
            icon: Shapes.files;
            label: "ファイル一覧";
            active: root.active-tab == 1;
            badge-count: root.conflict-count;
            clicked => {
                root.active-tab = 1;
                root.tab-selected(1);
            }
        }
        NavItem {
            icon: Shapes.note;
            label: "ノート";
            active: root.active-tab == 2;
            badge-dot: root.current-has-conflict;
            clicked => {
                root.active-tab = 2;
                root.tab-selected(2);
            }
        }
        NavItem {
            icon: Shapes.properties;
            label: "プロパティ";
            active: root.active-tab == 3;
            clicked => {
                root.active-tab = 3;
                root.tab-selected(3);
            }
        }
        NavItem {
            icon: Shapes.search;
            label: "検索";
            active: root.active-tab == 4;
            clicked => {
                root.active-tab = 4;
                root.tab-selected(4);
            }
        }
    }
}
