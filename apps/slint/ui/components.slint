import { Palette } from "std-widgets.slint";

// Touch targets are at least 48px: `px` here is a logical pixel, which the
// backend scales to the phone's density, so 48px is about 48dp.
export global Metrics {
    out property <length> touch: 48px;
    out property <length> bar-height: 56px;
    out property <length> row-height: 60px;
    out property <length> fab: 56px;
    out property <length> gutter: 16px;
}

export global Colors {
    out property <color> warning: #d9822b;
    out property <color> danger: #d9302f;
    out property <color> separator: Palette.foreground.with-alpha(0.12);
    out property <color> muted: Palette.foreground.with-alpha(0.6);
}

// A 24x24 icon drawn as a stroked path, so no icon font has to exist on the
// device.
export component Icon inherits Path {
    in property <string> shape;
    in property <color> tint: Palette.foreground;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.shape;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export global Shapes {
    out property <string> back: "M15 5 L8 12 L15 19";
    out property <string> plus: "M12 5 L12 19 M5 12 L19 12";
    out property <string> undo: "M9 6 L4 11 L9 16 M4 11 L15 11 C18.5 11 20 13 20 15.5 C20 18.5 18.5 20 15 20";
    out property <string> redo: "M15 6 L20 11 L15 16 M20 11 L9 11 C5.5 11 4 13 4 15.5 C4 18.5 5.5 20 9 20";
    out property <string> sync: "M19 9 C17.6 6 14.9 4.5 12 4.5 C8.5 4.5 5.5 6.8 4.6 10 M19.5 4 L19 9 L14 8.5 M5 15 C6.4 18 9.1 19.5 12 19.5 C15.5 19.5 18.5 17.2 19.4 14 M4.5 20 L5 15 L10 15.5";
    out property <string> link: "M8 16 L6.5 16 C4.6 16 3 14.4 3 12.5 C3 10.6 4.6 9 6.5 9 L8 9 M16 9 L17.5 9 C19.4 9 21 10.6 21 12.5 C21 14.4 19.4 16 17.5 16 L16 16 M8 12.5 L16 12.5";
    out property <string> menu: "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17";
}

export component IconButton inherits Rectangle {
    in property <string> shape;
    in property <bool> enabled: true;
    in property <color> tint: Palette.foreground;
    callback clicked();

    width: Metrics.touch;
    height: Metrics.touch;
    border-radius: self.width / 2;
    background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.14) : transparent;

    Icon {
        shape: root.shape;
        tint: root.enabled ? root.tint : Colors.muted.with-alpha(0.35);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopBar inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <string> title;
    in property <string> subtitle;
    // Slots for the buttons at either end.
    height: root.inset-top + Metrics.bar-height;
    background: Palette.background;

    VerticalLayout {
        padding-top: root.inset-top;
        HorizontalLayout {
            height: Metrics.bar-height;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            @children
        }
    }
}

// A tappable text row for an action sheet or menu -- not a list row (no
// separator, no selection highlight of its own).
export component ActionRow inherits Rectangle {
    in property <string> text;
    in property <color> tint: Palette.foreground;
    callback clicked();

    height: Metrics.touch;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;

    Text {
        x: Metrics.gutter;
        text: root.text;
        color: root.tint;
        font-size: 17px;
        vertical-alignment: center;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Fab inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    width: Metrics.fab;
    height: Metrics.fab;
    border-radius: self.width / 2;
    background: Palette.accent-background;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000055;

    Icon {
        shape: Shapes.plus;
        tint: Palette.accent-foreground;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}
