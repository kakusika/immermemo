import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, Icons } from "@origami-icons/icons.slint";
import { BubbleButton, TopBar, AppScrollView } from "@origami-mobile/components.slint";

export component VaultHistorySheet inherits Rectangle {
    in property <bool> open: false;
    in property <string> vault-name: "";
    in property <[string]> commits: [];
    in property <[string]> dates: [];
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    callback close();

    background: Colors.page-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        TopBar {
            inset-top: root.inset-top;

            BubbleButton {
                icon: Icons.chevron-left;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.vault-name != "" ? @tr("Vault History: {}", root.vault-name) : @tr("Vault History");
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                color: Palette.foreground;
            }

            BubbleButton {
                icon: Icons.x;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        if root.commits.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding: 24px;

                Text {
                    text: @tr("No commit history yet");
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("Creating or syncing notes will record the vault's history here.");
                    font-size: 13px;
                    color: Colors.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.commits.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 6px;
                padding-bottom: max(16px, root.inset-bottom);
                spacing: 4px;

                for commit[i] in root.commits: Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: Colors.surface-elevated;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: Icons.check;
                                color: Colors.success;
                                width: 16px;
                                height: 16px;
                            }
                        }

                        // Time is what users scan for here, so it leads;
                        // the commit hash/message is secondary detail.
                        Text {
                            text: root.dates[i];
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: commit;
                            font-size: 11px;
                            color: Colors.muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
