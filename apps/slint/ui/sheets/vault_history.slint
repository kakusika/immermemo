import { Palette, ScrollView } from "std-widgets.slint";
import { Metrics, Colors, Shapes, Icon, BubbleButton, TopBar } from "../components.slint";

export component VaultHistorySheet inherits Rectangle {
    in property <bool> open: false;
    in property <string> vault-name: "";
    in property <[string]> commits: [];
    in property <[string]> dates: [];
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    callback close();

    background: Palette.background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        TopBar {
            inset-top: root.inset-top;

            BubbleButton {
                shape: Shapes.back;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.vault-name != "" ? "保管庫の履歴: " + root.vault-name : "保管庫の履歴";
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                color: Palette.foreground;
            }

            BubbleButton {
                shape: Shapes.close;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        if root.commits.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding: 24px;

                Text {
                    text: "コミット履歴はありません";
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: "ノートを作成または同期すると、保管庫の履歴がここに表示されます。";
                    font-size: 13px;
                    color: Colors.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.commits.length > 0: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 6px;
                padding-bottom: max(16px, root.inset-bottom);
                spacing: 4px;

                for commit[i] in root.commits: Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: Palette.alternate-background;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                shape: Shapes.sync;
                                tint: Palette.accent-background;
                                width: 16px;
                                height: 16px;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                text: commit;
                                font-size: 13px;
                                font-weight: 600;
                                color: Palette.foreground;
                                overflow: elide;
                            }

                            Text {
                                text: root.dates[i];
                                font-size: 11px;
                                color: Colors.muted;
                            }
                        }
                    }
                }
            }
        }
    }
}
