import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Shapes, Icon } from "@origami-mobile/icons.slint";
import { BubbleButton, TopBar, AppScrollView } from "@origami-mobile/components.slint";

export component HistorySheet inherits Rectangle {
    in property <bool> open: false;
    in property <string> note-title: "";
    in property <[string]> commits: [];
    in property <[string]> dates: [];
    in property <[string]> previews: [];
    in-out property <int> selected-index: 0;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    callback close();
    callback restore(int);

    property <bool> is-wide: root.width > 680px;
    in-out property <bool> viewing-preview: false;

    background: Colors.page-background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        TopBar {
            inset-top: root.inset-top;

            if root.viewing-preview && !root.is-wide: BubbleButton {
                shape: Shapes.back;
                clicked => { root.viewing-preview = false; }
            }

            if !root.viewing-preview || root.is-wide: BubbleButton {
                shape: Shapes.back;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: (root.viewing-preview && !root.is-wide)
                    ? @tr("Preview")
                    : (root.note-title != "" ? @tr("History: {}", root.note-title) : @tr("Version History"));
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                color: Palette.foreground;
            }

            BubbleButton {
                shape: Shapes.close;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        // Empty state
        if root.commits.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding: 24px;

                Text {
                    text: @tr("This note has no history yet");
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("Saving or syncing this note will record past versions here.");
                    font-size: 13px;
                    color: Colors.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Mobile portrait mode: Commit list view
        if root.commits.length > 0 && !root.is-wide && !root.viewing-preview: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 6px;
                padding-bottom: max(16px, root.inset-bottom);
                spacing: 4px;

                for commit[i] in root.commits: Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: item-touch.pressed
                        ? Palette.foreground.with-alpha(0.08)
                        : (root.selected-index == i ? Palette.accent-background.with-alpha(0.12) : Colors.surface-elevated);
                    border-width: root.selected-index == i ? 1px : 0px;
                    border-color: Palette.accent-background;

                    item-touch := TouchArea {
                        clicked => {
                            root.selected-index = i;
                            root.viewing-preview = true;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 6px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                shape: Shapes.history;
                                tint: root.selected-index == i ? Palette.accent-background : Colors.muted;
                                width: 16px;
                                height: 16px;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                text: root.dates[i];
                                font-size: 13px;
                                font-weight: 600;
                                color: root.selected-index == i ? Palette.accent-background : Palette.foreground;
                                overflow: elide;
                            }

                            Text {
                                text: commit;
                                font-size: 11px;
                                color: Colors.muted;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                shape: Shapes.forward;
                                tint: Colors.muted.with-alpha(0.5);
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
            }
        }

        // Mobile portrait mode: Single version preview view
        if root.commits.length > 0 && !root.is-wide && root.viewing-preview: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 6px;
            padding-bottom: max(16px, root.inset-bottom);
            spacing: 6px;

            // Revision Info pill
            Rectangle {
                height: 38px;
                border-radius: 6px;
                background: Colors.surface-elevated;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            shape: Shapes.history;
                            tint: Palette.accent-background;
                            width: 16px;
                            height: 16px;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;
                        alignment: center;

                        Text {
                            text: root.selected-index >= 0 && root.selected-index < root.dates.length ? root.dates[root.selected-index] : "";
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground;
                            overflow: elide;
                        }

                        Text {
                            text: root.selected-index >= 0 && root.selected-index < root.commits.length ? root.commits[root.selected-index] : "";
                            font-size: 10px;
                            color: Colors.muted;
                            overflow: elide;
                        }
                    }
                }
            }

            // Scrollable note preview with reduced padding for maximum readable width
            Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                background: Colors.surface-elevated;
                clip: true;

                AppScrollView {
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        Text {
                            text: root.selected-index >= 0 && root.selected-index < root.previews.length ? root.previews[root.selected-index] : "";
                            font-size: 14px;
                            color: Palette.foreground;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Mobile-friendly full-width Restore button
            Rectangle {
                height: 48px;
                border-radius: 24px;
                background: mobile_restore_touch.pressed ? Palette.accent-background.darker(0.15) : Palette.accent-background;

                mobile_restore_touch := TouchArea {
                    clicked => { root.restore(root.selected-index); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            shape: Shapes.undo;
                            tint: Palette.accent-foreground;
                            width: 18px;
                            height: 18px;
                        }
                    }

                    Text {
                        text: @tr("Restore This Version");
                        font-size: 15px;
                        font-weight: 700;
                        color: Palette.accent-foreground;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Desktop / Tablet wide mode: Side-by-side view
        if root.commits.length > 0 && root.is-wide: HorizontalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 12px;

            // Left: Commit list
            Rectangle {
                width: 250px;
                background: Colors.surface-elevated;
                border-radius: 10px;
                clip: true;

                AppScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        for commit[i] in root.commits: Rectangle {
                            height: 48px;
                            border-radius: 6px;
                            background: root.selected-index == i ? Palette.accent-background.with-alpha(0.18) : (item_wide_touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent);
                            border-width: root.selected-index == i ? 1px : 0px;
                            border-color: Palette.accent-background;

                            item_wide_touch := TouchArea {
                                clicked => { root.selected-index = i; }
                            }

                            VerticalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 1px;
                                alignment: center;

                                Text {
                                    text: root.dates[i];
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.selected-index == i ? Palette.accent-background : Palette.foreground;
                                    overflow: elide;
                                }

                                Text {
                                    text: commit;
                                    font-size: 11px;
                                    color: Colors.muted;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // Right: Preview & Restore
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.selected-index >= 0 && root.selected-index < root.dates.length ? @tr("{} contents", root.dates[root.selected-index]) : @tr("Preview");
                        font-size: 14px;
                        font-weight: 600;
                        color: Colors.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: wide_restore_touch.pressed ? Palette.accent-background.darker(0.15) : Palette.accent-background;

                        wide_restore_touch := TouchArea {
                            clicked => { root.restore(root.selected-index); }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    shape: Shapes.undo;
                                    tint: Palette.accent-foreground;
                                    width: 16px;
                                    height: 16px;
                                }
                            }

                            Text {
                                text: @tr("Restore This Version");
                                font-size: 13px;
                                font-weight: 700;
                                color: Palette.accent-foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Colors.surface-elevated;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Colors.separator;
                    clip: true;

                    AppScrollView {
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: root.selected-index >= 0 && root.selected-index < root.previews.length ? root.previews[root.selected-index] : "";
                                font-size: 14px;
                                color: Palette.foreground;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
