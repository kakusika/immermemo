import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import { BubbleButton, TopBar, AppScrollView } from "@origami-mobile/widgets.slint";
import { SheetDragArea } from "../components.slint";

export component VaultHistorySheet inherits Rectangle {
    in property <bool> open: false;
    in property <string> vault-name: "";
    in property <[string]> commits: [];
    in property <[string]> dates: [];
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // How far the sheet has animated open and the pixel offset that
    // follows from it -- same contract as `EditorScreen`'s own
    // `sheet-progress`/`sheet-y-offset` (see that file's doc comment);
    // app.slint owns the travel distance and drag state machine.
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();
    // Mirrors the scroll view's `content-y` via a two-way alias declared
    // at its own (conditional) site -- its id isn't reachable from
    // `body-gesture.enabled` below since that lives outside the `if`.
    property <length> history-content-y: 0px;

    callback close();

    background: Colors.page-background;

    header-gesture := SheetDragArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        TopBar {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;
            inset-top: root.inset-top;

            // The swipe-down gesture and this button are now the only
            // two ways to dismiss the sheet, so there's no longer a
            // separate close button on the opposite side.
            BubbleButton {
                icon: TablerIcons.x;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.vault-name != "" ? @tr("Vault History: {}", root.vault-name) : @tr("Vault History");
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                color: Palette.foreground;
            }
        }
    }

    body-gesture := SheetDragArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        enabled: root.commits.length == 0 || root.history-content-y >= -1px;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        VerticalLayout {
        y: root.sheet-y-offset;
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 1px;
            background: Colors.separator;
        }

        if root.commits.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding: 24px;

                Text {
                    text: @tr("No commit history yet");
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("Creating or syncing notes will record the vault's history here.");
                    font-size: 13px;
                    color: Colors.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.commits.length > 0: AppScrollView {
            vertical-stretch: 1;
            content-y <=> root.history-content-y;

            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-top: 6px;
                padding-bottom: max(16px, root.inset-bottom);
                spacing: 4px;

                for commit[i] in root.commits: Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: Colors.surface-elevated;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: TablerIcons.check;
                                color: Colors.success;
                                width: 16px;
                                height: 16px;
                            }
                        }

                        // Time is what users scan for here, so it leads;
                        // the commit hash/message is secondary detail.
                        Text {
                            text: root.dates[i];
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: commit;
                            font-size: 11px;
                            color: Colors.muted;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        }
    }
}
