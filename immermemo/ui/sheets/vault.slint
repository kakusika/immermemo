import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { TablerIcons } from "@origami-icons/icons.slint";
import { IconButton, TopBar, ActionRow, ActionSheet } from "@origami-mobile/widgets.slint";
import { SheetDragArea } from "../components.slint";

// Full-screen, same shape as the other sheets: which vault is open, and a
// way to link another one. Rust owns what "adding" a vault actually means
// (a typed path on desktop, a subfolder name on Android) -- this only
// ever shows names and reports which row was tapped.
export component VaultSheet inherits Rectangle {
    in property <[string]> vaults;
    // Index into `vaults`, or -1 if none matches (shouldn't normally
    // happen -- the current vault is always one of the known ones).
    in property <int> current: -1;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // How far the sheet has animated open and the pixel offset that
    // follows from it -- same contract as `EditorScreen`'s own
    // `sheet-progress`/`sheet-y-offset` (see that file's doc comment);
    // app.slint owns the travel distance and drag state machine.
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();
    callback select(int);
    callback add();
    callback close();
    callback delete-requested(int);
    callback trigger-haptic();

    property <int> menu-index: -1;

    background: Colors.page-background;

    header-gesture := SheetDragArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        TopBar {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;
            inset-top: root.inset-top;
            IconButton {
                icon: TablerIcons.x;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: @tr("Vaults");
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    body-gesture := SheetDragArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        // No scrollable content here (a plain list, not an
        // `AppScrollView`), so there's no scroll position to gate on.
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        VerticalLayout {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            Rectangle {
                height: 1px;
                background: Colors.separator;
            }

            for name[i] in root.vaults: Rectangle {
                height: Metrics.touch;
                background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
                property <bool> long-pressed: false;

                HorizontalLayout {
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    Text {
                        text: name;
                        color: i == root.current ? Palette.accent-background : Palette.foreground;
                        font-size: 17px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if i == root.current: Text {
                        text: @tr("current");
                        font-size: 13px;
                        color: Palette.accent-background;
                        vertical-alignment: center;
                    }
                }

                touch := TouchArea {
                    clicked => {
                        if (long-pressed) {
                            long-pressed = false;
                        } else {
                            root.select(i);
                        }
                    }
                }

                Timer {
                    interval: 500ms;
                    running: touch.pressed && !long-pressed;
                    triggered => {
                        long-pressed = true;
                        root.trigger-haptic();
                        root.menu-index = i;
                    }
                }
            }

            ActionRow {
                text: @tr("+ Add vault");
                tint: Palette.accent-background;
                clicked => { root.add(); }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: root.inset-bottom;
            }
        }
    }

    ActionSheet {
        open: root.menu-index >= 0;
        narrow: root.width < 600px;
        title: root.menu-index >= 0 ? root.vaults[root.menu-index] : "";
        inset-bottom: root.inset-bottom;
        cancel => { root.menu-index = -1; }

        if root.vaults.length > 1: ActionRow {
            text: @tr("Delete");
            tint: Colors.danger;
            clicked => {
                let idx = root.menu-index;
                root.menu-index = -1;
                root.delete-requested(idx);
            }
        }
        if root.vaults.length <= 1: ActionRow {
            text: @tr("Cannot delete the only vault");
            tint: Colors.muted;
            clicked => {
                root.menu-index = -1;
            }
        }
    }
}
