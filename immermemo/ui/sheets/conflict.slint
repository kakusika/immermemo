import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import {
    IconButton,
    BubbleButton,
    AppScrollView,
} from "@origami-mobile/widgets.slint";

export component ConflictSheet inherits Rectangle {
    in property <bool> open: false;
    in property <int> conflict-index: 0;
    in property <int> conflict-total: 0;
    // `a`/`b` are `@conflict`'s own structural names, not mine/theirs --
    // `a-label`/`b-label`/`*-button-label` are computed in Rust (from
    // `immermemo_sync::ConflictSide`) and already say "Mine"/"Theirs"/a
    // neutral "A"/"B" as appropriate; this file never decides that
    // itself (see `.agents/tasks/git-ancestry-conflict-labeling.md`).
    in property <string> a-text: "";
    in property <string> b-text: "";
    in property <string> a-label: "";
    in property <string> b-label: "";
    in property <string> a-button-label: "";
    in property <string> b-button-label: "";

    callback close();
    callback resolve-choice(int); // 0: Mine, 1: Theirs, 2: Both
    callback prev-conflict();
    callback next-conflict();

    // Modal overlay
    background: Colors.separator.with-alpha(0.45);

    TouchArea {
        clicked => { root.close(); }
    }

    sheet := Rectangle {
        width: root.width > 540px ? 500px : root.width - 24px;
        height: root.height > 680px ? 600px : root.height - 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Colors.surface-elevated;
        border-radius: 16px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000.with-alpha(0.25);
        clip: true;

        // Consume touches inside the sheet
        TouchArea { }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 12px;

            // Sheet Header
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: @tr("⚠️ Resolve Conflict");
                    font-size: 16px;
                    font-weight: 700;
                    color: Colors.warning;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.conflict-total > 1: Rectangle {
                    border-radius: 10px;
                    background: Palette.foreground.with-alpha(0.08);
                    height: 24px;

                    HorizontalLayout {
                        alignment: center;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: (root.conflict-index + 1) + " / " + root.conflict-total;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                IconButton {
                    icon: TablerIcons.x;
                    tint: Palette.foreground.with-alpha(0.6);
                    clicked => { root.close(); }
                }
            }

            // Scrollable Content Cards
            AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 12px;

                    // Mine Card (Local)
                    Rectangle {
                        border-radius: 12px;
                        background: Palette.foreground.with-alpha(0.04);
                        border-width: 1.5px;
                        border-color: Palette.accent-background.with-alpha(0.4);

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.a-label;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Palette.accent-background;
                                }
                            }

                            Rectangle {
                                background: Colors.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Colors.separator;

                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.a-text != "" ? root.a-text : @tr("(deleted or empty)");
                                        font-size: 14px;
                                        color: root.a-text != "" ? Palette.foreground : Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Keep A Button
                            Rectangle {
                                height: 36px;
                                border-radius: 18px;
                                background: a-btn-touch.pressed ? Palette.accent-background.darker(15%) : Palette.accent-background;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.a-button-label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                a-btn-touch := TouchArea {
                                    clicked => { root.resolve-choice(0); }
                                }
                            }
                        }
                    }

                    // Theirs Card (Remote)
                    Rectangle {
                        border-radius: 12px;
                        background: Palette.foreground.with-alpha(0.04);
                        border-width: 1.5px;
                        border-color: Colors.warning.with-alpha(0.5);

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.b-label;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Colors.warning;
                                }
                            }

                            Rectangle {
                                background: Colors.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Colors.separator;

                                HorizontalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.b-text != "" ? root.b-text : @tr("(deleted or empty)");
                                        font-size: 14px;
                                        color: root.b-text != "" ? Palette.foreground : Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Keep B Button
                            Rectangle {
                                height: 36px;
                                border-radius: 18px;
                                background: b-btn-touch.pressed ? Colors.warning.darker(15%) : Colors.warning;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.b-button-label;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                b-btn-touch := TouchArea {
                                    clicked => { root.resolve-choice(1); }
                                }
                            }
                        }
                    }

                    // Both Action Button
                    Rectangle {
                        height: 38px;
                        border-radius: 19px;
                        background: both-btn-touch.pressed ? Palette.foreground.with-alpha(0.15) : Palette.foreground.with-alpha(0.08);

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("+ Keep Both (A → B)");
                                font-size: 13px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        both-btn-touch := TouchArea {
                            clicked => { root.resolve-choice(2); }
                        }
                    }

                    // Navigation Between Conflicts
                    if root.conflict-total > 1: HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: prev-touch.pressed ? Palette.foreground.with-alpha(0.12) : Palette.foreground.with-alpha(0.05);

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("◀ Previous Conflict");
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: root.conflict-index > 0 ? Palette.foreground : Colors.muted;
                                    vertical-alignment: center;
                                }
                            }

                            prev-touch := TouchArea {
                                enabled: root.conflict-index > 0;
                                clicked => { root.prev-conflict(); }
                            }
                        }

                        Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: 16px;
                            background: next-touch.pressed ? Palette.foreground.with-alpha(0.12) : Palette.foreground.with-alpha(0.05);

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Next Conflict ▶");
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: root.conflict-index < root.conflict-total - 1 ? Palette.foreground : Colors.muted;
                                    vertical-alignment: center;
                                }
                            }

                            next-touch := TouchArea {
                                enabled: root.conflict-index < root.conflict-total - 1;
                                clicked => { root.next-conflict(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
