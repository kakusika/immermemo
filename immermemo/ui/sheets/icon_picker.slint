import { LineEdit } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { TablerIcons } from "@origami-icons/icons.slint";
import { IconButton, IconTile, TopBar, AppScrollView } from "@origami-mobile/widgets.slint";
import { SheetDragArea } from "../components.slint";

// One candidate in the picker's (already filtered, already capped) result
// list -- `image` is resolved in Rust (`immermemo::render::icon_image`,
// the same `origami_icons::icon_svg` path `@doc.icon` rendering uses), not
// here: Slint has no way to turn `name` into an `@image-url()` at runtime,
// only a fixed literal per call site (see `origami-icons`'s own
// `ui/icons.slint` doc comment).
export struct PickerIconEntry {
    name: string,
    image: image,
}

// Lets the user set a note's own `@meta{ icon: @doc.icon(...) }`. Opened
// from the note menu (`immermemo::session::open_icon_picker`), which owns
// *which* note this acts on -- this component only ever reports a chosen
// slug back via `select`, the same "shows names, reports taps, Rust
// decides what it means" split `VaultSheet` uses.
//
// `results` is Rust-filtered/capped (not every one of Tabler's 5000+
// icons rendered at once) -- see `session::filter_icon_picker`'s doc for
// why that filtering has to live there instead of in `query`'s own
// `changed` callback here.
export component IconPickerSheet inherits Rectangle {
    in-out property <string> query;
    in property <[PickerIconEntry]> results: [];
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    // How far the sheet has animated open and the pixel offset that
    // follows from it -- same contract as `EditorScreen`'s own
    // `sheet-progress`/`sheet-y-offset` (see that file's doc comment);
    // app.slint owns the travel distance and drag state machine.
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();
    callback query-changed(string);
    callback select(string);
    callback close();

    background: Colors.page-background;

    header-gesture := SheetDragArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        inset-top: root.inset-top;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        TopBar {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;
            inset-top: root.inset-top;
            IconButton {
                icon: TablerIcons.x;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: @tr("Choose an icon");
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    body-gesture := SheetDragArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        // A search field mid-edit shouldn't have a downward drag misread
        // as "dismiss the sheet"; same for scrolling away from the top of
        // the grid (handled below like EditorScreen's `scroll-at-top`).
        enabled: !search-field.has-focus && results-scroll.content-y >= -1px;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        VerticalLayout {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            Rectangle {
                height: 1px;
                background: Colors.separator;
            }

            HorizontalLayout {
                padding: Metrics.gutter;
                search-field := LineEdit {
                    height: Metrics.touch;
                    placeholder-text: @tr("Search icons");
                    text <=> root.query;
                    edited(text) => { root.query-changed(text); }
                }
            }

            results-scroll := AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-bottom: root.inset-bottom + Metrics.spacing-lg;

                    GridLayout {
                        spacing: Metrics.spacing-sm;
                        property <int> columns: 5;

                        // Same component and equal-column stretch (via
                        // `IconTile`'s own zeroed min/preferred-width)
                        // as `files.slint`'s library/directory grid --
                        // `tile-height: Metrics.touch` keeps each cell a
                        // real tap target, not an arbitrary multiple of
                        // one.
                        for entry[i] in root.results: IconTile {
                            row: i / parent.columns;
                            col: Math.mod(i, parent.columns);
                            tile-height: Metrics.touch;
                            icon: entry.image;
                            label-text: "";
                            clicked => { root.select(entry.name); }
                        }
                    }

                    if root.results.length == 0: Text {
                        text: @tr("No icons match");
                        font-size: Metrics.font-body;
                        color: Colors.muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
