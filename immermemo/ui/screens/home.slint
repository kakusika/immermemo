import { Palette, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import {
    BubbleButton,
    TopBar,
    AppScrollView,
    Card,
    Section,
    Divider,
    IconTile,
} from "@origami-mobile/components.slint";

export component HomeScreen inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    // Vault info
    in property <string> vault-name: @tr("Default");
    in property <string> vault-path: "";
    in property <int> note-count: 0;
    in property <int> conflict-count: 0;
    in property <string> status: "";
    in property <bool> syncing: false;
    in property <bool> remote-configured: false;
    in property <string> last-sync-error: "";
    in property <bool> sync-error-copied: false;
    in property <string> last-synced-at: "";

    callback new-note();
    callback sync();
    callback open-vaults();
    callback open-settings();
    callback open-vault-history();
    callback open-conflict-note();
    callback copy-sync-error();
    callback dismiss-sync-error();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            bar-background: transparent;

            Text {
                horizontal-stretch: 1;
                text: @tr("Home");
                font-size: Metrics.font-title;
                font-weight: 700;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            BubbleButton {
                icon: TablerIcons.refresh;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                enabled: !root.syncing;
                clicked => { root.sync(); }
            }
        }

        AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                // Without this, a VerticalLayout shorter than its Flickable
                // dumps all the leftover space onto one section instead of
                // leaving it below the content: sections here have no
                // explicit vertical-stretch, so they default to a tied
                // max-stretch, and on a tie Slint's layout solver grows the
                // *last* one to fill the rest of the viewport. `start`
                // packs from the top and only grows/shrinks children when
                // the content actually overflows, same as before.
                alignment: start;
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: Metrics.spacing-lg;
                padding-bottom: root.inset-bottom + Metrics.spacing-2xl;
                spacing: Metrics.spacing-xl;

                // ----------------------------------------------------
                // Section: Active Vault Card
                // ----------------------------------------------------
                Card {
                        HorizontalLayout {
                            spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px * Metrics.ui-scale;

                                Text {
                                    text: @tr("Current Vault");
                                    font-size: Metrics.font-caption;
                                    font-weight: 700;
                                    color: Colors.muted;
                                    letter-spacing: 0.5px;
                                }

                                Text {
                                    text: root.vault-name != "" ? root.vault-name : @tr("Notes");
                                    font-size: Metrics.font-title;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }
                            }

                            BubbleButton {
                                icon: TablerIcons.files;
                                clicked => { root.open-vaults(); }
                            }
                        }

                        if root.vault-path != "": Text {
                            text: root.vault-path;
                            font-size: Metrics.font-sm;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Divider { }

                        HorizontalLayout {
                            spacing: Metrics.spacing-lg;

                            VerticalLayout {
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("Notes");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                }

                                Text {
                                    text: root.note-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                            }

                            if root.conflict-count > 0: VerticalLayout {
                                spacing: 2px * Metrics.ui-scale;
                                Text {
                                    text: @tr("Conflicts");
                                    font-size: Metrics.font-sm;
                                    color: Colors.warning;
                                }

                                Text {
                                    text: root.conflict-count;
                                    font-size: Metrics.font-body;
                                    font-weight: 600;
                                    color: Colors.warning;
                                }
                            }
                        }
                }

                // ----------------------------------------------------
                // Section: Sync Status
                // ----------------------------------------------------
                Section {
                    title: @tr("Sync Status");
                    action-icon: TablerIcons.history;
                    action => { root.open-vault-history(); }

                    // Card: Error State (When last-sync-error != "")
                    if root.last-sync-error != "": Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Colors.danger.with-alpha(0.08);
                        border-width: 1.5px;
                        border-color: Colors.danger.with-alpha(0.4);

                        VerticalLayout {
                            padding: Metrics.spacing-md + 2px * Metrics.ui-scale;
                            spacing: Metrics.spacing-md;

                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-md;
                                        height: Metrics.icon-md;
                                        source: TablerIcons.x;
                                        color: Colors.danger;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: @tr("Sync failed");
                                    font-size: Metrics.font-body;
                                    font-weight: 700;
                                    color: Colors.danger;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: Metrics.icon-lg + 4px * Metrics.ui-scale;
                                        height: self.width;
                                        border-radius: self.width / 2;
                                        background: Palette.foreground.with-alpha(0.06);

                                        TouchArea {
                                            clicked => { root.dismiss-sync-error(); }
                                        }

                                        Icon {
                                            width: Metrics.icon-sm;
                                            height: Metrics.icon-sm;
                                            source: TablerIcons.x;
                                            color: Colors.muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }

                            // Error text display (selectable, word-wrapped)
                            Rectangle {
                                border-radius: Metrics.radius-sm;
                                background: Colors.surface;
                                border-width: 1px;
                                border-color: Colors.separator;

                                VerticalLayout {
                                    padding: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                    TextInput {
                                        text: root.last-sync-error;
                                        read-only: true;
                                        wrap: word-wrap;
                                        color: Palette.foreground;
                                        font-size: Metrics.font-sm;
                                    }
                                }
                            }

                            // Action buttons: Copy Error and Retry Sync
                            HorizontalLayout {
                                spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Metrics.bubble-button-size;
                                    border-radius: Metrics.radius-sm;
                                    background: root.sync-error-copied
                                        ? Colors.success.with-alpha(0.18)
                                        : Colors.surface-elevated;
                                    border-width: 1px;
                                    border-color: root.sync-error-copied
                                        ? Colors.success.with-alpha(0.5)
                                        : Colors.separator;

                                    TouchArea {
                                        clicked => { root.copy-sync-error(); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;

                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                width: Metrics.icon-sm;
                                                height: Metrics.icon-sm;
                                                source: root.sync-error-copied ? TablerIcons.check : TablerIcons.copy;
                                                color: root.sync-error-copied ? Colors.success : Palette.foreground;
                                            }
                                        }

                                        Text {
                                            text: root.sync-error-copied ? @tr("Copied") : @tr("Copy Error");
                                            font-size: Metrics.font-sub;
                                            font-weight: 600;
                                            color: root.sync-error-copied ? Colors.success : Palette.foreground;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    height: Metrics.bubble-button-size;
                                    width: 100px * Metrics.ui-scale;
                                    border-radius: Metrics.radius-sm;
                                    background: Palette.accent-background;
                                    opacity: root.syncing ? 0.6 : 1.0;

                                    TouchArea {
                                        enabled: !root.syncing;
                                        clicked => { root.sync(); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Metrics.spacing-xs + 2px * Metrics.ui-scale;

                                        VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                width: Metrics.icon-sm;
                                                height: Metrics.icon-sm;
                                                source: TablerIcons.refresh;
                                                color: #ffffff;
                                            }
                                        }

                                        Text {
                                            text: @tr("Retry");
                                            font-size: Metrics.font-sub;
                                            font-weight: 600;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Card: Normal / Idle / Remote Not Configured
                    if root.last-sync-error == "": Card {
                        content-padding: Metrics.spacing-md + 2px * Metrics.ui-scale;
                        content-spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                            if !root.remote-configured: HorizontalLayout {
                                spacing: Metrics.spacing-md;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-lg;
                                        height: Metrics.icon-lg;
                                        source: TablerIcons.link;
                                        color: Colors.muted;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px * Metrics.ui-scale;

                                    Text {
                                        text: @tr("No remote configured");
                                        font-size: Metrics.font-body;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }

                                    Text {
                                        text: @tr("Set a git remote to enable automatic sync");
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: Metrics.bubble-chip-height;
                                        width: 60px * Metrics.ui-scale;
                                        border-radius: Metrics.radius-sm;
                                        background: Palette.accent-background.with-alpha(0.12);

                                        TouchArea {
                                            clicked => { root.open-settings(); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: @tr("Settings");
                                                font-size: Metrics.font-sm;
                                                font-weight: 600;
                                                color: Palette.accent-background;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.remote-configured: HorizontalLayout {
                                spacing: Metrics.spacing-sm + 2px * Metrics.ui-scale;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        width: Metrics.icon-md;
                                        height: Metrics.icon-md;
                                        source: root.syncing ? TablerIcons.refresh : TablerIcons.check;
                                        color: root.syncing ? Palette.accent-background : Colors.success;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px * Metrics.ui-scale;

                                    Text {
                                        text: root.syncing ? @tr("Syncing...") : @tr("Up to date");
                                        font-size: Metrics.font-body;
                                        font-weight: 600;
                                        color: root.syncing ? Palette.accent-background : Palette.foreground;
                                    }

                                    Text {
                                        text: root.syncing
                                            ? @tr("Checking for changes with the remote")
                                            : (root.last-synced-at != "" ? @tr("Last synced: {}", root.last-synced-at) : (root.status != "" ? root.status : @tr("Local and remote are in sync")));
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: Metrics.bubble-chip-height;
                                        width: 80px * Metrics.ui-scale;
                                        border-radius: Metrics.radius-sm;
                                        background: Palette.foreground.with-alpha(0.06);

                                        TouchArea {
                                            enabled: !root.syncing;
                                            clicked => { root.sync(); }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: Metrics.spacing-xs;

                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    width: Metrics.icon-sm;
                                                    height: Metrics.icon-sm;
                                                    source: TablerIcons.refresh;
                                                    color: root.syncing ? Colors.muted : Palette.foreground;
                                                }
                                            }

                                            Text {
                                                text: @tr("Sync");
                                                font-size: Metrics.font-sm;
                                                font-weight: 600;
                                                color: root.syncing ? Colors.muted : Palette.foreground;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                // ----------------------------------------------------
                // Section: Unresolved Conflicts
                // ----------------------------------------------------
                if root.conflict-count > 0: Section {
                    title: @tr("Unresolved Conflicts");
                    title-color: Colors.warning;

                    Rectangle {
                        border-radius: Metrics.radius-md;
                        background: Colors.warning.with-alpha(0.12);
                        border-width: 1.5px;
                        border-color: Colors.warning.with-alpha(0.4);

                        TouchArea {
                            clicked => { root.open-conflict-note(); }
                        }

                        VerticalLayout {
                            padding: Metrics.spacing-lg;
                            spacing: Metrics.spacing-sm;

                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;
                                alignment: center;

                                Text {
                                    text: "⚠️";
                                    font-size: Metrics.font-subtitle;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: @tr("{n} note has a conflict" | "{n} notes have conflicts" % root.conflict-count);
                                    font-size: Metrics.font-body;
                                    font-weight: 700;
                                    color: Colors.warning;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: @tr("Tap to open and resolve conflicted notes →");
                                font-size: Metrics.font-sub;
                                font-weight: 600;
                                color: Colors.warning.darker(10%);
                            }
                        }
                    }
                }

                // ----------------------------------------------------
                // Section: Quick Actions
                // ----------------------------------------------------
                // Vault switching and Settings are already one tap away
                // (the Vault Card's icon button, the bottom nav Settings
                // tab) so they don't need a quick action of their own.
                Section {
                    title: @tr("Quick Actions");

                    HorizontalLayout {
                        spacing: Metrics.spacing-sm;

                        IconTile {
                            icon: TablerIcons.plus;
                            label-text: @tr("New Note");
                            tint: Palette.accent-background;
                            clicked => { root.new-note(); }
                        }

                        // Reserved grid slots for upcoming quick actions.
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
