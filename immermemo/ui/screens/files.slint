import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, Icons } from "@origami-icons/icons.slint";
import {
    BubbleButton,
    IconButton,
    TopBar,
    Fab,
    AppScrollView,
} from "@origami-mobile/components.slint";

// A square icon-over-label tile for the Library hub's 2-column section
// grid -- same recipe as home.slint's QuickActionTile (kept as its own
// copy here since the two screens have no shared import point for it),
// plus an `enabled` flag: a section with no implementation yet still
// gets a tile (muted, inert) rather than being left out, so the grid
// doesn't need reshaping once List/Diary gain real content.
component LibrarySectionTile inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 1;
    // Without both of these, each tile's own preferred-width comes from
    // its label Text's natural single-line width -- "Directory" is
    // wider than "List"/"Diary" -- and stretch only distributes
    // *leftover* space past that preferred-width equally; it does not
    // equalize the preferred-width itself. (min-width alone, tried
    // first, wasn't enough -- confirmed by measuring actual rendered
    // pixel widths: 410px vs 334px, still off. preferred-width is the
    // real basis stretch starts from.) Zeroing both makes the row's
    // split purely stretch-driven, confirmed equal by the same
    // pixel measurement after this change.
    min-width: 0px;
    preferred-width: 0px;
    height: 88px * Metrics.ui-scale;
    border-radius: Metrics.radius-md;
    background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.12) : Colors.surface-elevated;
    opacity: root.enabled ? 1.0 : 0.5;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        spacing: Metrics.spacing-xs;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-lg;
                height: Metrics.icon-lg;
                color: root.enabled ? Palette.foreground : Colors.muted;
            }
        }

        Text {
            text: root.label-text;
            font-size: Metrics.font-sm;
            font-weight: 600;
            color: root.enabled ? Palette.foreground : Colors.muted;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FilesScreen inherits Rectangle {
    in property <[string]> notes;
    in property <[bool]> conflicted;
    in property <int> current: -1;
    in property <string> status;
    in property <bool> syncing;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <bool> highlight-current: false;
    in property <bool> remote-configured: false;
    // 0: section hub (Directory/List/Diary tiles), 1: Directory (today's
    // flat note list). in-out so the app-level Back action can pop it,
    // same shape as sheets/settings.slint's own `page` -- see
    // app.slint's handle-back().
    in-out property <int> page: 0;

    callback select(int);
    callback new-note();
    callback sync();
    callback open-settings();
    callback note-menu-requested(int);
    callback trigger-haptic();
    callback trigger-heavy-haptic();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            bar-background: transparent;

            if root.page != 0: IconButton {
                icon: Icons.chevron-left;
                clicked => { root.page = 0; }
            }

            Text {
                horizontal-stretch: 1;
                text: root.page == 1 ? @tr("Directory") : @tr("Library");
                font-size: Metrics.font-title;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
            }

            BubbleButton {
                icon: Icons.refresh;
                enabled: !root.syncing;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                clicked => { root.sync(); }
            }
        }

        // Top spacing
        Rectangle {
            height: Metrics.spacing-xs + 2px * Metrics.ui-scale;
        }

        if root.page == 0: VerticalLayout {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-top: Metrics.spacing-sm;
            spacing: Metrics.spacing-sm;

            HorizontalLayout {
                spacing: Metrics.spacing-sm;

                LibrarySectionTile {
                    icon: Icons.folder;
                    label-text: @tr("Directory");
                    clicked => { root.page = 1; }
                }

                // No list icon exists in origami-icons -- menu-2
                // (hamburger) stands in until this has a real
                // implementation to design a look for.
                LibrarySectionTile {
                    icon: Icons.menu-2;
                    label-text: @tr("List");
                    enabled: false;
                }
            }

            HorizontalLayout {
                spacing: Metrics.spacing-sm;

                // No diary/calendar icon exists either -- same
                // placeholder situation as List, above.
                LibrarySectionTile {
                    icon: Icons.file;
                    label-text: @tr("Diary");
                    enabled: false;
                }

                // Reserved grid slot for a future section.
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }

        if root.page == 1 && root.notes.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-md;
                Icon {
                    source: Icons.files;
                    color: Colors.muted.with-alpha(0.5);
                    width: Metrics.icon-xl;
                    height: Metrics.icon-xl;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: @tr("No notes yet");
                    font-size: Metrics.font-body;
                    font-weight: 600;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("Tap + below to create your first note");
                    font-size: Metrics.font-sub;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.page == 1 && root.notes.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;

                for name[i] in root.notes: Rectangle {
                    height: Metrics.row-height;

                    item-container := Rectangle {
                        x: Metrics.spacing-sm;
                        y: Metrics.spacing-xs / 2;
                        width: parent.width - Metrics.spacing-lg;
                        height: parent.height - Metrics.spacing-xs;
                        border-radius: Metrics.radius-lg;
                        background: (root.highlight-current && i == root.current)
                            ? Palette.accent-background.with-alpha(0.20)
                            : (touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent);

                        animate background {
                            duration: 150ms;
                            easing: ease-out;
                        }

                        HorizontalLayout {
                            padding-left: Metrics.spacing-lg;
                            padding-right: Metrics.spacing-lg;
                            spacing: Metrics.spacing-md;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: name;
                                    font-size: Metrics.font-body;
                                    font-weight: (root.highlight-current && i == root.current) ? 600 : 400;
                                    color: (root.highlight-current && i == root.current)
                                        ? Palette.accent-background
                                        : Palette.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.conflicted[i]: Rectangle {
                                width: Metrics.spacing-sm;
                                height: Metrics.spacing-sm;
                                y: (parent.height - self.height) / 2;
                                border-radius: Metrics.spacing-sm / 2;
                                background: Colors.warning;
                            }
                        }
                    }

                    property <bool> long-pressed: false;

                    touch := TouchArea {
                        clicked => {
                            if (long-pressed) {
                                long-pressed = false;
                            } else {
                                root.select(i);
                            }
                        }
                    }

                    Timer {
                        interval: 400ms;
                        running: touch.pressed && !long-pressed;
                        triggered => {
                            long-pressed = true;
                            root.trigger-heavy-haptic();
                            root.note-menu-requested(i);
                        }
                    }
                }
            }
        }
    }

    if root.page == 1: Fab {
        x: parent.width - self.width - Metrics.gutter;
        y: parent.height - self.height - Metrics.gutter - root.inset-bottom;
        clicked => { root.new-note(); }
    }
}
