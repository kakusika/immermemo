import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import {
    BubbleButton,
    IconButton,
    TopBar,
    Fab,
    AppScrollView,
    SegmentedControl,
} from "@origami-mobile/components.slint";

// One row of the Directory page's List view, or one tile of its Grid
// view -- both are the direct contents of whichever folder is currently
// browsed (see `immermemo/src/directory.rs`'s `build_folder_entries`).
// `note-index` is `-1` for a folder row/tile (folders have no index of
// their own, only a `key` derived from splitting titles on `/`).
export struct DirectoryEntry {
    is-folder: bool,
    key: string,
    display: string,
    note-index: int,
    has-conflict: bool,
    // A note's `@meta{ icon: @doc.icon(...) }`, resolved (see
    // `immermemo::session::to_entry_view`). Empty for a folder entry, or a
    // note with no such meta -- `file`/`folder` (TablerIcons) stand in for
    // either below, same as before this field existed.
    icon-image: image,
}

// One tappable segment of the breadcrumb trail above the browsed folder's
// contents -- `key` is what a tap navigates to, `display` is just that
// segment's own name. See `DirectoryBreadcrumb` below.
export struct BreadcrumbSegment {
    key: string,
    display: string,
}

// A square icon-over-label tile for the Library hub's 2-column section
// grid -- same recipe as home.slint's QuickActionTile (kept as its own
// copy here since the two screens have no shared import point for it),
// plus an `enabled` flag: a section with no implementation yet still
// gets a tile (muted, inert) rather than being left out, so the grid
// doesn't need reshaping once List/Diary gain real content.
component LibrarySectionTile inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 1;
    // Without both of these, each tile's own preferred-width comes from
    // its label Text's natural single-line width -- "Directory" is
    // wider than "List"/"Diary" -- and stretch only distributes
    // *leftover* space past that preferred-width equally; it does not
    // equalize the preferred-width itself. (min-width alone, tried
    // first, wasn't enough -- confirmed by measuring actual rendered
    // pixel widths: 410px vs 334px, still off. preferred-width is the
    // real basis stretch starts from.) Zeroing both makes the row's
    // split purely stretch-driven, confirmed equal by the same
    // pixel measurement after this change.
    min-width: 0px;
    preferred-width: 0px;
    height: 88px * Metrics.ui-scale;
    border-radius: Metrics.radius-md;
    background: touch.pressed && root.enabled ? Palette.foreground.with-alpha(0.12) : Colors.surface-elevated;
    opacity: root.enabled ? 1.0 : 0.5;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        spacing: Metrics.spacing-xs;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-lg;
                height: Metrics.icon-lg;
                color: root.enabled ? Palette.foreground : Colors.muted;
            }
        }

        Text {
            text: root.label-text;
            font-size: Metrics.font-sm;
            font-weight: 600;
            color: root.enabled ? Palette.foreground : Colors.muted;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// An icon-over-label tile for the Directory page's Grid view -- same
// recipe as `LibrarySectionTile`, minus its `enabled`-muting (every grid
// entry is a real folder or note, never a placeholder), plus a long-press
// timer on note tiles so Grid gets the same rename/delete menu List
// already has. Folders have no such menu: they're derived from paths,
// not an entity of their own to rename or delete.
component DirectoryGridTile inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    in property <bool> is-folder;
    in property <bool> has-conflict;
    in property <bool> highlighted;
    callback clicked();
    callback long-pressed();

    horizontal-stretch: 1;
    height: 96px * Metrics.ui-scale;
    border-radius: Metrics.radius-md;
    background: touch.pressed
        ? Palette.foreground.with-alpha(0.12)
        : (root.highlighted ? Palette.accent-background.with-alpha(0.20) : Colors.surface-elevated);
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    VerticalLayout {
        alignment: center;
        spacing: Metrics.spacing-xs;

        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-lg;
                height: Metrics.icon-lg;
                color: root.highlighted ? Palette.accent-background : Palette.foreground;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: Metrics.spacing-xs;

            Text {
                text: root.label-text;
                font-size: Metrics.font-sm;
                font-weight: 600;
                color: root.highlighted ? Palette.accent-background : Palette.foreground;
                horizontal-alignment: center;
                overflow: elide;
            }

            if root.has-conflict: Rectangle {
                width: Metrics.spacing-sm;
                height: Metrics.spacing-sm;
                border-radius: Metrics.spacing-sm / 2;
                background: Colors.warning;
            }
        }
    }

    property <bool> long-pressed-flag: false;

    touch := TouchArea {
        clicked => {
            if (long-pressed-flag) {
                long-pressed-flag = false;
            } else {
                root.clicked();
            }
        }
    }

    Timer {
        interval: 400ms;
        running: touch.pressed && !root.is-folder && !long-pressed-flag;
        triggered => {
            long-pressed-flag = true;
            root.long-pressed();
        }
    }
}

// The folder-browsing context above List/Grid's contents: a breadcrumb
// trail that jumps to any specific ancestor folder, its first entry
// always the vault root itself (shown as a home icon, `seg.key == ""` --
// the only way back to it now that there's no separate always-present
// root button). Shared by both view modes -- they browse the same
// folder-at-a-time state, just render its contents differently.
// `alignment: start` keeps the trail packed to the left at its own
// natural width -- without it, `HorizontalLayout`'s default `stretch`
// alignment spreads its children across the whole row instead of packing
// them together.
component DirectoryBreadcrumb inherits HorizontalLayout {
    in property <[BreadcrumbSegment]> segments;
    callback go-to(string);

    alignment: start;
    spacing: Metrics.spacing-xs;

    for seg[i] in root.segments: HorizontalLayout {
        spacing: Metrics.spacing-xs;

        if i > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: TablerIcons.chevron-right;
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                color: Colors.muted;
            }
        }

        Rectangle {
            crumb-touch := TouchArea {
                clicked => { root.go-to(seg.key); }
            }

            VerticalLayout {
                alignment: center;

                if seg.key == "": Icon {
                    source: TablerIcons.home;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    color: crumb-touch.pressed ? Palette.foreground : Colors.muted;
                }

                if seg.key != "": Text {
                    text: seg.display;
                    font-size: Metrics.font-sub;
                    font-weight: i == root.segments.length - 1 ? 700 : 600;
                    color: i == root.segments.length - 1
                        ? Palette.foreground
                        : (crumb-touch.pressed ? Palette.foreground : Colors.muted);
                }
            }
        }
    }
}

export component FilesScreen inherits Rectangle {
    in property <int> current: -1;
    in property <string> status;
    in property <bool> syncing;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <bool> highlight-current: false;
    in property <bool> remote-configured: false;
    // 0: section hub (Directory/List/Diary tiles), 1: Directory. in-out
    // so the app-level Back action can pop it, same shape as
    // sheets/settings.slint's own `page` -- see app.slint's handle-back().
    in-out property <int> page: 0;
    // Directory's own view-mode switch: 0 = List, 1 = Grid. Both browse
    // the same folder-at-a-time state (`folder-entries`/`breadcrumb`, see
    // `immermemo/src/directory.rs`'s `build_folder_entries`/
    // `build_breadcrumb`) and only ever carry a `note-index` into the
    // same flat note list every other action already indexes by -- they
    // differ purely in how they render one folder's contents.
    in-out property <int> directory-mode: 0;
    in property <[DirectoryEntry]> folder-entries: [];
    in property <[BreadcrumbSegment]> breadcrumb: [];

    callback select(int);
    callback new-note();
    callback sync();
    callback open-settings();
    callback note-menu-requested(int);
    callback navigate-folder(string);
    callback trigger-haptic();
    callback trigger-heavy-haptic();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            bar-background: transparent;

            if root.page != 0: IconButton {
                icon: TablerIcons.x;
                clicked => { root.page = 0; }
            }

            Text {
                horizontal-stretch: 1;
                text: root.page == 1 ? @tr("Directory") : @tr("Library");
                font-size: Metrics.font-title;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
            }

            BubbleButton {
                icon: TablerIcons.refresh;
                enabled: !root.syncing;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                clicked => { root.sync(); }
            }
        }

        // Top spacing
        Rectangle {
            height: Metrics.spacing-xs + 2px * Metrics.ui-scale;
        }

        if root.page == 0: VerticalLayout {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-top: Metrics.spacing-sm;
            spacing: Metrics.spacing-sm;

            HorizontalLayout {
                spacing: Metrics.spacing-sm;

                LibrarySectionTile {
                    icon: TablerIcons.folder;
                    label-text: @tr("Directory");
                    clicked => { root.page = 1; }
                }

                // No list icon exists in origami-icons -- menu-2
                // (hamburger) stands in until this has a real
                // implementation to design a look for.
                LibrarySectionTile {
                    icon: TablerIcons.menu-2;
                    label-text: @tr("List");
                    enabled: false;
                }
            }

            HorizontalLayout {
                spacing: Metrics.spacing-sm;

                // No diary/calendar icon exists either -- same
                // placeholder situation as List, above.
                LibrarySectionTile {
                    icon: TablerIcons.file;
                    label-text: @tr("Diary");
                    enabled: false;
                }

                // Reserved grid slot for a future section.
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }

        if root.page == 1 && root.breadcrumb.length > 0: DirectoryBreadcrumb {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-bottom: Metrics.spacing-sm;
            segments: root.breadcrumb;
            go-to(key) => { root.navigate-folder(key); }
        }

        if root.page == 1: HorizontalLayout {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-bottom: Metrics.spacing-sm;

            SegmentedControl {
                options: [@tr("List"), @tr("Grid")];
                selected: root.directory-mode;
                changed(i) => { root.directory-mode = i; }
            }
        }

        if root.page == 1 && root.folder-entries.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-md;
                Icon {
                    source: TablerIcons.files;
                    color: Colors.muted.with-alpha(0.5);
                    width: Metrics.icon-xl;
                    height: Metrics.icon-xl;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: root.breadcrumb.length > 0 ? @tr("This folder is empty") : @tr("No notes yet");
                    font-size: Metrics.font-body;
                    font-weight: 600;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }

                if root.breadcrumb.length == 0: Text {
                    text: @tr("Tap + below to create your first note");
                    font-size: Metrics.font-sub;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        // List view
        if root.page == 1 && root.directory-mode == 0 && root.folder-entries.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;

                for entry[i] in root.folder-entries: Rectangle {
                    height: Metrics.row-height;

                    item-container := Rectangle {
                        x: Metrics.spacing-sm;
                        y: Metrics.spacing-xs / 2;
                        width: parent.width - Metrics.spacing-lg;
                        height: parent.height - Metrics.spacing-xs;
                        border-radius: Metrics.radius-lg;
                        background: (!entry.is-folder && root.highlight-current && entry.note-index == root.current)
                            ? Palette.accent-background.with-alpha(0.20)
                            : (touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent);

                        animate background {
                            duration: 150ms;
                            easing: ease-out;
                        }

                        HorizontalLayout {
                            padding-left: Metrics.spacing-lg;
                            padding-right: Metrics.spacing-lg;
                            spacing: Metrics.spacing-sm;

                            if entry.is-folder: VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.folder;
                                    width: Metrics.icon-sm;
                                    height: Metrics.icon-sm;
                                    color: Colors.muted;
                                }
                            }

                            // Only when the note actually has a
                            // `@meta{ icon: @doc.icon(...) }` -- a note
                            // without one keeps the plain title-only row
                            // this had before `icon-image` existed, not a
                            // generic file icon suddenly appearing on
                            // every row.
                            if !entry.is-folder && entry.icon-image.width > 0: VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: entry.icon-image;
                                    width: Metrics.icon-sm;
                                    height: Metrics.icon-sm;
                                    color: Colors.muted;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: entry.display;
                                    font-size: Metrics.font-body;
                                    font-weight: entry.is-folder
                                        ? 600
                                        : ((root.highlight-current && entry.note-index == root.current) ? 600 : 400);
                                    color: (!entry.is-folder && root.highlight-current && entry.note-index == root.current)
                                        ? Palette.accent-background
                                        : Palette.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if !entry.is-folder && entry.has-conflict: Rectangle {
                                width: Metrics.spacing-sm;
                                height: Metrics.spacing-sm;
                                y: (parent.height - self.height) / 2;
                                border-radius: Metrics.spacing-sm / 2;
                                background: Colors.warning;
                            }

                            if entry.is-folder: VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.chevron-right;
                                    width: Metrics.icon-sm;
                                    height: Metrics.icon-sm;
                                    color: Colors.muted;
                                }
                            }
                        }
                    }

                    property <bool> long-pressed: false;

                    touch := TouchArea {
                        clicked => {
                            if (long-pressed) {
                                long-pressed = false;
                            } else if (entry.is-folder) {
                                root.navigate-folder(entry.key);
                            } else {
                                root.select(entry.note-index);
                            }
                        }
                    }

                    Timer {
                        interval: 400ms;
                        running: touch.pressed && !entry.is-folder && !long-pressed;
                        triggered => {
                            long-pressed = true;
                            root.trigger-heavy-haptic();
                            root.note-menu-requested(entry.note-index);
                        }
                    }
                }
            }
        }

        // Grid view
        if root.page == 1 && root.directory-mode == 1 && root.folder-entries.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;
                spacing: Metrics.spacing-sm;

                GridLayout {
                    spacing: Metrics.spacing-sm;

                    for entry[i] in root.folder-entries: DirectoryGridTile {
                        row: i / 3;
                        col: Math.mod(i, 3);
                        icon: entry.is-folder
                            ? TablerIcons.folder
                            : (entry.icon-image.width > 0 ? entry.icon-image : TablerIcons.file);
                        label-text: entry.display;
                        is-folder: entry.is-folder;
                        has-conflict: entry.has-conflict;
                        highlighted: !entry.is-folder && root.highlight-current && entry.note-index == root.current;
                        clicked => {
                            if (entry.is-folder) {
                                root.navigate-folder(entry.key);
                            } else {
                                root.select(entry.note-index);
                            }
                        }
                        long-pressed => {
                            root.trigger-heavy-haptic();
                            root.note-menu-requested(entry.note-index);
                        }
                    }
                }
            }
        }
    }

    if root.page == 1: Fab {
        x: parent.width - self.width - Metrics.gutter;
        y: parent.height - self.height - Metrics.gutter - root.inset-bottom;
        clicked => { root.new-note(); }
    }
}
