import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon } from "@origami-icons/icons.slint";

// What `immermemo-editor`'s `classify_body()` found in one top-level
// block of the note body, as the editor's view-mode display (see
// `RenderedBlockView` below) wants it. `shape` is a closed set of drawing
// primitives, not a vocabulary registry -- which `(namespace, name)`
// identity maps to which `shape`/`tone`/`text` is decided entirely on the
// Rust side, in `immermemo_editor::classify::REGISTRY` (see that module's
// doc). This component never branches on a vocabulary name; giving a new
// `@use`'d vocabulary its own presentation never requires touching this
// file.
export enum RenderedBlockShape {
    plain-text,
    badge,
    // A `@ruby[base](rt:"reading")` standing as its own block (rarer than
    // the inline case, `@richtext/flow_view.slint`'s `FlowView` -- see
    // `immermemo_editor::classify::BlockShape::Ruby`'s doc).
    ruby,
    // A bare `@link`/`@std.link` -- `text` is its display content, or the
    // target itself with no `[content]` (see
    // `immermemo_editor::classify::BlockShape::Link`'s doc). Static, same
    // as every other shape here -- not tappable.
    link,
    // A `@doc.icon(name, pkg)` -- `icon-image` is the resolved image (see
    // `RenderedBlock.icon-image`'s doc).
    icon,
    // A `@conflict(a: [...], b: [...])` -- `side-a`/`side-b` hold each
    // side's own content (see `immermemo_editor::classify::BlockShape::
    // Conflict`'s doc). `text`/`reading` unused (empty), same as every
    // other shape whose look doesn't come from them.
    conflict,
}

export enum RenderedBlockTone {
    accent,
    warning,
    neutral,
}

// One block inside a `@conflict`'s `side-a`/`side-b` -- the same flat
// fields `RenderedBlock` has, minus `side-a`/`side-b` themselves: Slint's
// struct/component system can't express a type nesting inside itself
// (confirmed against the real compiler -- see
// `immermemo::render::classify::ConflictLeafBlock`'s doc, the Rust-side
// counterpart this mirrors field-for-field), and a `@conflict` only ever
// has exactly two sides in practice, never an unbounded tree to walk, so
// there was nothing to buy by reaching for one anyway. `shape` is never
// `conflict` here -- a nested, still-unresolved `@conflict` inside a side
// is normalized to `badge` before it ever reaches this struct (see
// `immermemo::render::to_conflict_side_block`).
export struct ConflictSideBlock {
    shape: RenderedBlockShape,
    tone: RenderedBlockTone,
    text: string,
    bold: bool,
    italic: bool,
    mark: bool,
    strikeout: bool,
    reading: string,
    icon-image: image,
}

export struct RenderedBlock {
    shape: RenderedBlockShape,
    tone: RenderedBlockTone,
    // The paragraph text for `plain-text`, the base for `ruby`, or a label
    // for `badge`. Unused (empty) for `conflict` -- its look comes
    // entirely from `side-a`/`side-b`.
    text: string,
    // Meaningful only for `plain-text` -- `em`/`strong`/`mark`/`strikeout`
    // tagging a whole block with nothing else sharing its line (see
    // `immermemo_tomet_render`'s `classify_bare_character_element`).
    // `false` everywhere else.
    bold: bool,
    italic: bool,
    mark: bool,
    strikeout: bool,
    // The reading annotation, meaningful only for `ruby`. Empty elsewhere.
    reading: string,
    // The resolved icon, meaningful only for `icon`
    // (`immermemo::render::to_rendered_block` resolves `@doc.icon`'s
    // `(name, pkg)` into this via `origami_icons::icon_svg`, since Slint's
    // own `@image-url()` can only ever resolve a fixed literal per call
    // site, never a runtime string). Empty elsewhere.
    icon-image: image,
    // `@conflict`'s two sides, meaningful only for `conflict`. Empty for
    // every other shape, same convention as `reading`.
    side-a: [ConflictSideBlock],
    side-b: [ConflictSideBlock],
}

// One leaf inside a `@conflict`'s side -- the same five shape branches
// `RenderedBlockView` below has (everything but `conflict` itself, which
// never reaches here -- see `ConflictSideBlock`'s own doc), duplicated
// rather than delegating to `RenderedBlockView`: Slint resolves names
// top-down within a file with no forward declarations (confirmed against
// the real compiler), and `RenderedBlockView`'s own `conflict` branch
// needs this component, so the two can't reference each other in either
// order without one of them existing first. Defining this one first and
// keeping it self-contained sidesteps that cycle instead of fighting it.
export component ConflictSideBlockView inherits VerticalLayout {
    in property <ConflictSideBlock> block;
    in property <length> text-font-size: Metrics.font-body;

    property <color> tone-color: root.block.tone == RenderedBlockTone.accent ? Palette.accent-background
        : root.block.tone == RenderedBlockTone.warning ? Colors.warning
        : Colors.muted;

    if root.block.shape == RenderedBlockShape.plain-text: Rectangle {
        width: 100%;
        background: root.block.mark ? Colors.warning.with-alpha(0.25) : transparent;

        leaf-text-item := Text {
            width: 100%;
            text: root.block.text;
            font-size: root.text-font-size;
            font-weight: root.block.bold ? 700 : 400;
            font-italic: root.block.italic;
            color: root.block.tone == RenderedBlockTone.neutral ? Palette.foreground : root.tone-color;
            wrap: word-wrap;
        }

        if root.block.strikeout: Rectangle {
            y: leaf-text-item.height / 2;
            width: leaf-text-item.preferred-width;
            height: 1px;
            background: leaf-text-item.color;
        }
    }

    if root.block.shape == RenderedBlockShape.badge: HorizontalLayout {
        alignment: start;

        Rectangle {
            height: Metrics.bubble-chip-height * 0.75;
            border-radius: self.height / 2;
            background: Palette.foreground.with-alpha(0.08);

            HorizontalLayout {
                padding-left: Metrics.spacing-sm;
                padding-right: Metrics.spacing-sm;
                Text {
                    text: root.block.text;
                    font-size: Metrics.font-sm;
                    font-weight: 600;
                    color: Colors.muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.block.shape == RenderedBlockShape.ruby: VerticalLayout {
        alignment: start;

        Text {
            text: root.block.reading;
            font-size: root.text-font-size * 0.5;
            color: Colors.muted;
            horizontal-alignment: center;
        }

        Text {
            text: root.block.text;
            font-size: root.text-font-size;
            color: Palette.foreground;
            horizontal-alignment: center;
        }
    }

    if root.block.shape == RenderedBlockShape.link: Rectangle {
        width: 100%;

        leaf-link-text-item := Text {
            width: 100%;
            text: root.block.text;
            font-size: root.text-font-size;
            color: root.tone-color;
            wrap: word-wrap;
        }

        Rectangle {
            y: leaf-link-text-item.height - 1px;
            width: leaf-link-text-item.preferred-width;
            height: 1px;
            background: root.tone-color;
        }
    }

    if root.block.shape == RenderedBlockShape.icon: HorizontalLayout {
        alignment: start;

        Icon {
            source: root.block.icon-image;
            width: root.text-font-size;
            height: root.text-font-size;
            color: Palette.foreground;
        }
    }
}

// Renders one `RenderedBlock` in the editor's view-mode display: plain
// text as-is, or a small label standing in for a recognized element's raw
// `@element(...)` syntax. Static, not a button -- resolving a conflict
// still goes through the warning bar/ConflictSheet (`editor.slint`,
// `conflict.slint`); this only hides the marker syntax, it doesn't take
// on their job too.
export component RenderedBlockView inherits VerticalLayout {
    in property <RenderedBlock> block;
    in property <length> text-font-size: Metrics.font-body;

    property <color> tone-color: root.block.tone == RenderedBlockTone.accent ? Palette.accent-background
        : root.block.tone == RenderedBlockTone.warning ? Colors.warning
        : Colors.muted;

    if root.block.shape == RenderedBlockShape.plain-text: Rectangle {
        // Explicit `width: 100%` on both this wrapper and the `Text`
        // inside it -- a bare `Rectangle` placed directly in the
        // surrounding `VerticalLayout` does not reliably inherit the
        // full-width stretch a `Text` got for free as a direct child
        // (discovered the hard way: it silently shrank to the text's own
        // natural width and the `VerticalLayout` centered it instead of
        // word-wrapping at the real available width).
        width: 100%;
        background: root.block.mark ? Colors.warning.with-alpha(0.25) : transparent;

        plain-text-item := Text {
            width: 100%;
            text: root.block.text;
            font-size: root.text-font-size;
            font-weight: root.block.bold ? 700 : 400;
            font-italic: root.block.italic;
            // Every other caller leaves `tone` at its default (`neutral`)
            // for this shape -- only a `@conflict`'s two inline sides set
            // it to `accent`/`warning`, to read as visually distinct runs
            // without a "Mine"/"Theirs" text label (see
            // `immermemo::render::flow::push_conflict_side`'s doc).
            color: root.block.tone == RenderedBlockTone.neutral ? Palette.foreground : root.tone-color;
            wrap: word-wrap;
        }

        // A single overlay line through vertical-center: exact for the
        // common case (a short, single-line block), an approximation for
        // a `word-wrap`-wrapped multi-line one (there's no per-line
        // strike this draws against today).
        if root.block.strikeout: Rectangle {
            y: plain-text-item.height / 2;
            width: plain-text-item.preferred-width;
            height: 1px;
            background: plain-text-item.color;
        }
    }

    // Each side gets a thin colored rule down its left edge (accent for
    // `side-a`, warning for `side-b`) instead of a text label -- the same
    // colors the retired `@mobile.conflict` scheme used for its "Mine"/
    // "Theirs" chips, without reintroducing a mine/theirs label that can
    // read backwards on another device (see the decision in
    // `.agents/tasks/adopt-std-conflict.md`). `ConflictSideBlockView`,
    // not a recursive call to `RenderedBlockView` itself -- confirmed
    // unbuildable (see `ConflictSideBlock`'s own doc).
    if root.block.shape == RenderedBlockShape.conflict: VerticalLayout {
        spacing: Metrics.spacing-sm;

        HorizontalLayout {
            spacing: Metrics.spacing-sm;
            Rectangle {
                width: 3px;
                background: Palette.accent-background;
            }

            VerticalLayout {
                spacing: Metrics.spacing-xs;
                for side-item in root.block.side-a: ConflictSideBlockView {
                    block: side-item;
                    text-font-size: root.text-font-size;
                }
            }
        }

        HorizontalLayout {
            spacing: Metrics.spacing-sm;
            Rectangle {
                width: 3px;
                background: Colors.warning;
            }

            VerticalLayout {
                spacing: Metrics.spacing-xs;
                for side-item in root.block.side-b: ConflictSideBlockView {
                    block: side-item;
                    text-font-size: root.text-font-size;
                }
            }
        }
    }

    if root.block.shape == RenderedBlockShape.badge: HorizontalLayout {
        alignment: start;

        Rectangle {
            height: Metrics.bubble-chip-height * 0.75;
            border-radius: self.height / 2;
            background: Palette.foreground.with-alpha(0.08);

            HorizontalLayout {
                padding-left: Metrics.spacing-sm;
                padding-right: Metrics.spacing-sm;
                Text {
                    text: root.block.text;
                    font-size: Metrics.font-sm;
                    font-weight: 600;
                    color: Colors.muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Reading above base, centered -- the usual horizontal-text ruby
    // layout (furigana sits above the kanji it annotates, not beside it).
    if root.block.shape == RenderedBlockShape.ruby: VerticalLayout {
        alignment: start;

        Text {
            text: root.block.reading;
            font-size: root.text-font-size * 0.5;
            color: Colors.muted;
            horizontal-alignment: center;
        }

        Text {
            text: root.block.text;
            font-size: root.text-font-size;
            color: Palette.foreground;
            horizontal-alignment: center;
        }
    }

    if root.block.shape == RenderedBlockShape.link: Rectangle {
        width: 100%;

        link-text-item := Text {
            width: 100%;
            text: root.block.text;
            font-size: root.text-font-size;
            color: root.tone-color;
            wrap: word-wrap;
        }

        Rectangle {
            y: link-text-item.height - 1px;
            width: link-text-item.preferred-width;
            height: 1px;
            background: root.tone-color;
        }
    }

    if root.block.shape == RenderedBlockShape.icon: HorizontalLayout {
        alignment: start;

        Icon {
            source: root.block.icon-image;
            width: root.text-font-size;
            height: root.text-font-size;
            color: Palette.foreground;
        }
    }
}
