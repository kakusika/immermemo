import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import {
    IconButton,
    BubbleButton,
    UndoRedoBubble,
    TopBar,
    AppScrollView,
    PillButton,
} from "@origami-mobile/widgets.slint";
import { NoteBodyItemView, NoteBodyView } from "note_body.slint";
import { ViewSwitcher, NavPill } from "../components.slint";
import { PropertiesView } from "properties.slint";

// Elevation + the open/close corner-radius morph, shared by the header and
// body halves of the note sheet so they read as one continuous card. No
// shadow on the body half -- its own edges sit against the screen edge
// where a shadow wouldn't be visible anyway, and the header's shadow
// already covers the visually relevant (top) edge.
component SheetSurface inherits Rectangle {
    in property <bool> is-header: false;
    in property <float> sheet-progress: 1.0;

    background: Colors.page-background;
    opacity: clamp(root.sheet-progress * 10.0, 0.0, 1.0);
    clip: root.is-header;
    border-top-left-radius: root.is-header ? Metrics.radius-lg * (1.0 - root.sheet-progress) : 0px;
    border-top-right-radius: root.is-header ? Metrics.radius-lg * (1.0 - root.sheet-progress) : 0px;
    drop-shadow-blur: root.is-header ? 10px * Metrics.ui-scale : 0px;
    drop-shadow-offset-y: root.is-header ? 2px * Metrics.ui-scale : 0px;
    drop-shadow-color: root.is-header
        ? (Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024)
        : transparent;
}

// header-gesture/body-gesture both need two independent swipe behaviors at
// once: the existing down-to-dismiss (forwarded as `sheet-drag-*`, same
// shape `SheetDragArea` in components.slint offers the other sheets) and a
// new left/right history-navigation swipe (`nav-drag-*`). `moved` fires for
// every pointer move regardless of which direction `swiped` eventually
// resolves to, so a continuous drag still needs its own axis lock -- same
// dx-vs-dy comparison `app.slint`'s `mini-card-gesture` already uses for the
// same reason, decided once per gesture at its first `moved` call.
// handle-swipe-left/right are left for the instantiation site to bind (see
// `nav-swipe-enabled` below), same as any other inherited SwipeGestureHandler
// property -- only handle-swipe-down is fixed here, since both header and
// body always offer the dismiss gesture.
component NoteSheetGestureArea inherits SwipeGestureHandler {
    in property <length> inset-top: 0px;
    handle-swipe-down: true;
    property <duration> drag-start-time: 0ms;
    property <bool> drag-locked: false;
    property <bool> drag-horizontal: false;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();
    callback nav-drag-moved(length);
    // dx, average px/ms over the drag (0 if timing wasn't captured)
    callback nav-drag-swiped(length, float);
    callback nav-drag-cancelled();

    changed pressed-position => {
        root.drag-start-time = animation-tick();
        root.drag-locked = false;
    }
    moved => {
        // Ignore gestures that begin inside the status bar / notification area.
        if (self.swiping && self.pressed-position.y >= root.inset-top) {
            let dx = self.current-position.x - self.pressed-position.x;
            let dy = self.current-position.y - self.pressed-position.y;
            if (!root.drag-locked) {
                root.drag-locked = true;
                root.drag-horizontal = abs(dx) > abs(dy);
            }
            if (root.drag-horizontal) {
                root.nav-drag-moved(dx);
            } else {
                root.sheet-drag-moved(dy);
            }
        }
    }
    swiped => {
        if (self.pressed-position.y >= root.inset-top) {
            let elapsed-ms = max(1.0, (animation-tick() - root.drag-start-time) / 1ms);
            if (root.drag-horizontal) {
                let dx = self.current-position.x - self.pressed-position.x;
                root.nav-drag-swiped(dx, (dx / 1px) / elapsed-ms);
            } else {
                let dy = self.current-position.y - self.pressed-position.y;
                root.sheet-drag-swiped(dy, (dy / 1px) / elapsed-ms);
            }
        } else {
            if (root.drag-horizontal) {
                root.nav-drag-cancelled();
            } else {
                root.sheet-drag-cancelled();
            }
        }
    }
    cancelled => {
        if (root.drag-horizontal) {
            root.nav-drag-cancelled();
        } else {
            root.sheet-drag-cancelled();
        }
    }
}

// The note sheet's own real content, mirrored for whichever history
// neighbor is being dragged toward (see `EditorScreen`'s `swipe-nav-dx`
// carousel below) -- same title + `NoteBodyView` structure `edit-scope`'s
// own view-box uses, not a lightweight stand-in: `session.rs`'s
// `history_preview_items` (called from `sync_nav_state`) runs the real
// `classify`/`flow` pipeline for the adjacent note, cached per path so
// repeat visits through the same history don't re-parse. Only ever one of
// these exists at a time (see `nav-drag-moved`'s `swipe-nav-dx` sign gate
// on each instantiation below) -- back and forward are never visible
// together, so there's no reason to keep both mounted and animating.
component HistoryPreviewPanel inherits Rectangle {
    in property <string> title: "";
    in property <[NoteBodyItemView]> items: [];
    in property <length> text-font-size: 17px;

    background: Colors.page-background;
    clip: true;

    VerticalLayout {
        alignment: start;
        padding-left: Metrics.gutter;
        padding-right: Metrics.gutter;
        padding-top: Metrics.spacing-lg;
        padding-bottom: Metrics.spacing-3xl;
        spacing: Metrics.spacing-md;

        Text {
            text: root.title != "" ? root.title : @tr("Untitled");
            font-size: Metrics.font-headline;
            font-weight: 700;
            color: Palette.foreground;
            wrap: word-wrap;
        }

        NoteBodyView {
            width: 100%;
            items: root.items;
            text-font-size: root.text-font-size;
        }
    }
}

export component EditorScreen inherits Rectangle {
    in property <string> title;
    in property <bool> has-note: false;
    in property <int> note-count: 0;
    in property <bool> has-conflict: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    // Show the back arrow (a narrow window, where the list is another screen).
    in property <bool> show-back: false;
    in property <length> inset-top: 0px;
    // Whatever covers the bottom edge: the system bar, or the on-screen keyboard.
    in property <length> inset-bottom: 0px;
    in property <length> font-size: 17px;
    in property <string> status: "";
    in property <bool> status-is-error: false;
    in property <bool> syncing: false;
    in property <bool> remote-configured: false;
    in property <string> last-synced-at: "";
    // Properties view data (see `PropertiesView` in properties.slint) --
    // has-conflict/resolve-mine/resolve-theirs/open-conflict-sheet above
    // already exist for the inline conflict bar, reused here as-is.
    // Rename/Delete aren't among these: PropertiesView has no Actions
    // card of its own, since this screen's own header already has a
    // 3-dot overflow menu (note-menu-requested) for the same actions.
    in property <string> note-path: "";
    in property <int> char-count: 0;
    in property <int> word-count: 0;
    in property <int> line-count: 0;
    in property <int> conflict-total: 0;
    in property <string> conflict-a-preview: "";
    in property <string> conflict-b-preview: "";
    in property <string> conflict-a-label: "";
    in property <string> conflict-b-label: "";
    in property <string> conflict-a-button-label: "";
    in property <string> conflict-b-button-label: "";
    // Which of the note sheet's own views is showing: 0 Body, 1 Properties.
    // Purely a Slint-side UI concern -- nothing on the Rust side needs to
    // know or persist it. Resets to Body whenever a different note is
    // opened (note-path changes) and whenever edit mode is entered (see
    // `focus-editor` below): there's nothing to edit on the Properties
    // view, and the view switcher itself is hidden while editing anyway
    // (see the ViewSwitcher instantiation below).
    in-out property <int> note-view: 0;
    changed note-path => { root.note-view = 0; }
    // Browser-tab-style back/forward through previously-opened notes
    // (session.rs's BackForwardStack), surfaced here via NavPill below --
    // see that component's own doc comment for why it's a separate pill
    // from ViewSwitcher (directional chevrons vs. mode-selection icons).
    in property <bool> can-navigate-back: false;
    in property <bool> can-navigate-forward: false;
    // Title + real rendered content for the adjacent history entries
    // (session.rs's `sync_nav_state`/`history_preview_items`), shown by
    // `HistoryPreviewPanel` while mid-swipe below.
    in property <string> history-back-title: "";
    in property <[NoteBodyItemView]> history-back-items: [];
    in property <string> history-forward-title: "";
    in property <[NoteBodyItemView]> history-forward-items: [];
    callback navigate-back();
    callback navigate-forward();
    // Horizontal history-navigation swipe, alongside NavPill's tap-only
    // affordance (see components.slint's own doc comment on NavPill for why
    // this follows it rather than replacing it). Modeled on app.slint's
    // 5-tab swiper: a plain distance threshold decides the commit, no
    // velocity/fast-flick special case (unlike the sheet-dismiss/mini-card
    // gestures, which do need one -- this one is closer in spirit to
    // flipping through tabs than to a commit-or-cancel sheet drag).
    // Disabled outright while Properties view is showing (note-view == 1,
    // nothing there to carousel through) or while editing text has focus.
    property <length> swipe-nav-dx: 0px;
    property <bool> is-swiping-nav: false;
    // Set for exactly one property write -- the final, instant handoff
    // inside `finish-nav-commit` below -- so that one change to
    // `swipe-nav-dx` bypasses the 220ms ease the same way a live drag
    // does. Kept separate from `is-swiping-nav` (rather than reusing it)
    // since "actively dragging" and "snapping state after a completed
    // commit" are different moments that happen to want the same (0ms)
    // duration.
    property <bool> nav-commit-instant: false;
    animate swipe-nav-dx {
        duration: (root.is-swiping-nav || root.nav-commit-instant) ? 0ms : 220ms;
        easing: ease-out;
    }
    property <bool> nav-swipe-enabled: root.header-swipe-enabled
        && root.note-view == 0
        && (!root.edit-mode || !root.editor-has-focus);
    // -1 forward pending, 1 back pending, 0 none -- which direction
    // `nav-settle-timer` should finalize once the commit animation below
    // finishes.
    property <int> pending-nav-direction: 0;
    // `commit-nav-swipe` used to call `navigate-back()`/`navigate-forward()`
    // immediately on release, synchronously swapping `can-navigate-*` and
    // `edit-scope`'s real content (body/note-body-items) *while*
    // `swipe-nav-dx` was still mid-ease back to 0 -- the two
    // `HistoryPreviewPanel`s' own `if` conditions (gated on
    // `can-navigate-*`/the sign of `swipe-nav-dx`) could then flip mid-
    // animation too, which is what actually produced "the note appears
    // from the wrong side" (diagnosed, not fixed, in this task file's
    // "Phase 2 redesign" section -- fixed here).
    //
    // Fixed by splitting the commit into two phases instead of one:
    // 1. Past the threshold, animate `swipe-nav-dx` the rest of the way
    //    to a full `+-root.width` (not back to 0px) -- the *already-
    //    correct* `HistoryPreviewPanel` finishes sliding fully into the
    //    center, `edit-scope`'s still-old content finishes sliding fully
    //    off-screen. Nothing about `can-navigate-*`/`edit-scope`'s
    //    content changes during this phase, so there's nothing to flip.
    // 2. `nav-settle-timer`, with the same 220ms interval as that
    //    animation's own duration, fires `finish-nav-commit` once it's
    //    done: *then* call `navigate-back()`/`navigate-forward()` (the
    //    real content becomes what the preview was already showing --
    //    same title/`NoteBodyView` structure, so this is visually a
    //    no-op) and snap `swipe-nav-dx` back to 0px instantly
    //    (`nav-commit-instant`, above) in the same instant --
    //    `can-navigate-*` flips at the same moment the panels'
    //    `swipe-nav-dx > 0px`/`< 0px` gate goes false, so the panel that
    //    was covering the screen and `edit-scope` underneath it (now
    //    showing the same thing) swap with nothing visibly moving.
    nav-settle-timer := Timer {
        interval: 220ms;
        running: false;
        triggered => {
            root.finish-nav-commit();
        }
    }

    function commit-nav-swipe(dx: length) {
        root.is-swiping-nav = false;
        nav-settle-timer.running = false;
        if (dx > 40px && root.can-navigate-back) {
            root.pending-nav-direction = 1;
            root.swipe-nav-dx = root.width;
            nav-settle-timer.running = true;
        } else if (dx < -40px && root.can-navigate-forward) {
            root.pending-nav-direction = -1;
            root.swipe-nav-dx = -root.width;
            nav-settle-timer.running = true;
        } else {
            root.swipe-nav-dx = 0px;
        }
    }
    function finish-nav-commit() {
        nav-settle-timer.running = false;
        let direction = root.pending-nav-direction;
        root.pending-nav-direction = 0;
        root.nav-commit-instant = true;
        if (direction == 1) {
            root.navigate-back();
        } else if (direction == -1) {
            root.navigate-forward();
        }
        root.swipe-nav-dx = 0px;
        root.nav-commit-instant = false;
    }
    // 1.4x Metrics.fab -- a deliberate local bump for this one FAB, not
    // a change to the shared token (other FABs, e.g. FilesScreen's "+"
    // button, are unaffected).
    property <length> fab-size: Metrics.fab * 1.4;
    // ViewSwitcher/NavPill's own track height, duplicated here (matches
    // each component's `height:` binding in components.slint) so the
    // HorizontalLayout grouping them below can position itself without
    // depending on either child's size first.
    property <length> pill-height: Metrics.bubble-button-size + 2 * Metrics.spacing-xs;
    in-out property <string> body;
    // Derived from `body` (see `src/render/mod.rs`); drives the
    // view-mode display below in place of the raw `body` text.
    in property <[NoteBodyItemView]> note-body-items: [];
    // The width a flowed paragraph (`NoteBodyView`'s `FlowView` items) has
    // to wrap against: `editor-scroll`'s own viewport width minus the
    // gutter padding `view-layout`'s parent `VerticalLayout` applies on
    // both sides. Exposed so Rust can read it when (re-)computing
    // `note-body-items`, and so `reflow-note-body` below fires whenever it
    // changes (window resize, UI-scale change, sidebar toggle, ...) --
    // `note-body-items` only gets *set* from Rust, so nothing re-flows it
    // on its own just because the available width moved.
    out property <length> body-content-width: editor-scroll.visible-width - 2 * Metrics.gutter;
    callback reflow-note-body(length);
    changed body-content-width => {
        root.reflow-note-body(root.body-content-width);
    }
    in-out property <bool> edit-mode: false;
    out property <bool> editor-has-focus: root.edit-mode && editor.has-focus;
    out property <bool> scroll-at-top: editor-scroll.content-y >= -1px;
    in property <bool> header-swipe-enabled: true;
    // How far the sheet has animated open (1.0 = fully open, matches
    // app.slint's `sheet-progress`) and the pixel offset that follows from
    // it. Passed in rather than recomputed here because the travel
    // distance (`mini-card-resting-y`) is app.slint's own layout geometry.
    // header-gesture/body-gesture below are themselves always at a fixed
    // position -- only this offset, applied to their *content*, animates --
    // so their own pressed-position/current-position stay in a stable
    // frame. (They used to carry the animation themselves, nested inside
    // the thing that moved; that made `current - pressed` meaningless,
    // since an element dragged 1:1 with the finger reports an almost
    // constant local position throughout the whole gesture, regardless of
    // how far it actually travelled. Chasing that with compensating math
    // was fragile -- this is the actual fix.)
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();
    callback edited(string);
    callback undo();
    callback redo();
    callback back();
    callback collapse();
    callback new-note();
    callback dismiss-status();
    callback resolve-mine();
    callback resolve-theirs();
    callback jump-conflict();
    callback open-conflict-sheet();
    callback manual-sync();
    callback open-history();
    callback note-menu-requested();

    // Moves the caret after Rust restores text from the undo history.
    public function set-cursor(offset: int) {
        if (root.edit-mode) {
            editor.set-selection-offsets(offset, offset);
        }
    }

    // Claims focus on the text editor
    public function focus-editor() {
        root.edit-mode = true;
        root.note-view = 0;
        editor.focus();
    }

    // Dismisses focus from the text editor
    public function unfocus() {
        editor.clear-focus();
    }

    // Switches to view mode and dismisses focus
    public function view-mode() {
        editor.clear-focus();
        root.edit-mode = false;
    }

    // No background here: header-surface/body-surface each paint their own
    // (with the open/close opacity fade), and when they've slid away from
    // part of this area during the drag, that gap is meant to show
    // whatever's behind the sheet, not get papered over by an opaque root.

    header-gesture := NoteSheetGestureArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        inset-top: root.inset-top;
        enabled: root.header-swipe-enabled;
        handle-swipe-right: root.nav-swipe-enabled && root.can-navigate-back;
        handle-swipe-left: root.nav-swipe-enabled && root.can-navigate-forward;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }
        nav-drag-moved(dx) => {
            root.is-swiping-nav = true;
            root.swipe-nav-dx = clamp(dx, -root.width, root.width);
        }
        nav-drag-swiped(dx, v) => { root.commit-nav-swipe(dx); }
        nav-drag-cancelled => {
            root.is-swiping-nav = false;
            root.swipe-nav-dx = 0px;
        }

        header-surface := SheetSurface {
            is-header: true;
            sheet-progress: root.sheet-progress;
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            TopBar {
                inset-top: root.inset-top;
                bar-background: transparent;

                // Down chevron button to collapse sheet into mini-player
                BubbleButton {
                    icon: TablerIcons.chevron-down;
                    clicked => { root.collapse(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Sync status button: check when synced, alert on error, spinner while syncing, cloud when idle
                if root.remote-configured: BubbleButton {
                    icon: root.syncing ? TablerIcons.refresh
                        : root.status-is-error ? TablerIcons.alert-triangle
                        : root.status != "" ? TablerIcons.check
                        : TablerIcons.cloud;
                    tint: root.syncing ? Palette.accent-background
                        : root.status-is-error ? Colors.danger
                        : root.status != "" ? Colors.muted
                        : Colors.muted;
                    spinning: root.syncing;
                    clicked => { root.manual-sync(); }
                }

                // Version history button
                if root.has-note: BubbleButton {
                    icon: TablerIcons.history;
                    clicked => { root.open-history(); }
                }

                if root.has-note && root.edit-mode: UndoRedoBubble {
                    can-undo: root.can-undo;
                    can-redo: root.can-redo;
                    undo => { root.undo(); }
                    redo => { root.redo(); }
                }

                // Overflow menu (rename/delete) -- the Edit/Done toggle
                // that used to sit here moved to a bottom-right FAB
                // (below, in body-surface), matching FilesScreen's own
                // note-add FAB.
                if root.has-note: BubbleButton {
                    icon: TablerIcons.dots-vertical;
                    clicked => { root.note-menu-requested(); }
                }
            }
        }
    }

    // Body area: in-body title, text editor, and whatever banners apply --
    // this is "everything below the header", all tracking the same
    // sheet-y-offset as one unit via body-surface, same as before the
    // header/body split.
    body-gesture := NoteSheetGestureArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        // A note with nothing to scroll (or no note at all) has no scroll
        // position to gate on.
        enabled: root.header-swipe-enabled && (!root.has-note || root.scroll-at-top) && (!root.edit-mode || !root.editor-has-focus);
        handle-swipe-right: root.nav-swipe-enabled && root.can-navigate-back;
        handle-swipe-left: root.nav-swipe-enabled && root.can-navigate-forward;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }
        nav-drag-moved(dx) => {
            root.is-swiping-nav = true;
            root.swipe-nav-dx = clamp(dx, -root.width, root.width);
        }
        nav-drag-swiped(dx, v) => { root.commit-nav-swipe(dx); }
        nav-drag-cancelled => {
            root.is-swiping-nav = false;
            root.swipe-nav-dx = 0px;
        }

        body-surface := SheetSurface {
            is-header: false;
            sheet-progress: root.sheet-progress;
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            VerticalLayout {
                width: 100%;
                height: 100%;

                if root.status != "" && root.status-is-error: Rectangle {
                    height: 38px;
                    background: Colors.danger.with-alpha(0.18);
                    HorizontalLayout {
                        padding-left: Metrics.gutter;
                        padding-right: 4px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.status;
                            font-size: 13px;
                            color: Colors.danger;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        IconButton {
                            icon: TablerIcons.x;
                            tint: Colors.danger;
                            clicked => { root.dismiss-status(); }
                        }
                    }
                }

                if root.has-conflict: Rectangle {
                    height: 42px;
                    background: Colors.warning.with-alpha(0.18);
                    HorizontalLayout {
                        padding-left: Metrics.gutter;
                        padding-right: Metrics.gutter;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: @tr("Conflict");
                            font-size: 13px;
                            font-weight: 700;
                            color: Colors.warning;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        PillButton {
                            text: @tr("Open Resolution");
                            fill: Colors.warning;
                            pressed-fill: Colors.warning.darker(15%);
                            text-color: #ffffff;
                            bold: true;
                            clicked => { root.open-conflict-sheet(); }
                        }

                        PillButton {
                            text: @tr("Next");
                            clicked => { root.jump-conflict(); }
                        }

                        PillButton {
                            text: @tr("Keep Mine");
                            fill: Colors.warning;
                            pressed-fill: Colors.warning.darker(15%);
                            text-color: #ffffff;
                            clicked => { root.resolve-mine(); }
                        }

                        PillButton {
                            text: @tr("Keep Theirs");
                            fill: Palette.foreground.with-alpha(0.12);
                            pressed-fill: Palette.foreground.with-alpha(0.22);
                            clicked => { root.resolve-theirs(); }
                        }
                    }
                }

                if !root.has-note: Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            padding-left: 24px;
                            padding-right: 24px;
                            max-width: 320px;

                            Text {
                                text: root.note-count == 0 ? @tr("No notes yet") : @tr("No note selected");
                                font-size: 20px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                color: Palette.foreground;
                            }

                            Text {
                                text: root.note-count == 0
                                    ? @tr("Create your first note to start writing.")
                                    : @tr("Choose a note from the list, or create a new one.");
                                font-size: 14px;
                                horizontal-alignment: center;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 8px;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: create-btn-layout.preferred-width + 36px;
                                    height: 44px;
                                    border-radius: 22px;
                                    background: create-touch.pressed ? Palette.accent-background.darker(10%) : Palette.accent-background;

                                    create-btn-layout := HorizontalLayout {
                                        alignment: center;
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        Text {
                                            text: @tr("+ New Note");
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: Palette.accent-foreground;
                                            vertical-alignment: center;
                                        }
                                    }

                                    create-touch := TouchArea {
                                        clicked => { root.new-note(); }
                                    }
                                }
                            }
                        }
                    }
                }

                body-container := Rectangle {
                    visible: root.has-note;
                    vertical-stretch: root.has-note ? 1 : 0;
                    width: 100%;
                    // `edit-scope` slides fully off to one side on a
                    // committed drag (up to +-its own width) -- clip so
                    // that doesn't spill past this sheet's own bounds,
                    // same reasoning as content-box's own clip in
                    // app.slint for its 5-tab swiper.
                    clip: true;

                    // The "back" (past) neighbor sits here, fully opaque,
                    // fixed at the same resting position `edit-scope`
                    // itself rests at -- never animated, never slides in.
                    // `edit-scope` (declared after this, so it paints on
                    // top and fully covers it at rest) is the only thing
                    // that moves: dragging right slides it out of the way
                    // to reveal more of this already-complete panel
                    // underneath, the way a card peels back to reveal the
                    // one beneath it in a stack, rather than something
                    // new sliding in from off-screen. Fixes a real
                    // complaint (title took a full off-screen-to-on-
                    // screen drag to become legible when this used to
                    // slide in like `forward`'s panel still does below) --
                    // deliberately back-only, not symmetric with forward:
                    // the user's own framing was "the *past* note doesn't
                    // move, it's already sitting there" (a stack/depth
                    // metaphor that only makes sense for what's behind
                    // you), not a general back/forward symmetry -- `forward`
                    // keeps its original off-screen slide-in.
                    //
                    // Only mounted while actually being dragged toward
                    // (`swipe-nav-dx > 0px`), same as before -- no reason
                    // to keep it in the tree (even doing nothing, fixed in
                    // place) outside of the one drag that's revealing it.
                    if root.note-view == 0 && root.can-navigate-back && root.swipe-nav-dx > 0px: HistoryPreviewPanel {
                        x: 0px;
                        width: parent.width;
                        height: parent.height;
                        title: root.history-back-title;
                        items: root.history-back-items;
                        text-font-size: root.font-size;
                    }

                    edit-scope := FocusScope {
                        visible: root.note-view == 0;
                        // Moves for a back-direction drag (dragging the
                        // current note out of the way to reveal the fixed
                        // panel above); stays put for a forward-direction
                        // one (dx < 0px) -- the forward panel is the thing
                        // that moves there, sliding in on top of this
                        // fixed frame instead, per the user's own framing:
                        // the *older* note in either pair stays fixed, the
                        // *newer* one moves (back: current is the newer of
                        // the two, so it moves; forward: the target is the
                        // newer one, so it moves instead).
                        x: max(0px, root.swipe-nav-dx);
                        width: 100%;
                        height: 100%;
                        // `FocusScope` paints nothing of its own, and
                        // neither does `AppScrollView` below (no
                        // `background` of its own either) -- this used to
                        // be fine because nothing was ever positioned
                        // directly underneath this frame's own bounds at
                        // the same time. That's no longer true: the back
                        // `HistoryPreviewPanel` above now sits fixed at
                        // this exact frame's resting position, so without
                        // an opaque layer of its own here, its content
                        // shows straight through every gap in this frame's
                        // own content (anywhere not actually covered by
                        // text) instead of being properly occluded.
                        Rectangle {
                            background: Colors.page-background;
                            width: 100%;
                            height: 100%;
                            // Depth cue for the back-direction reveal:
                            // this frame is the one moving/elevated (the
                            // fixed back panel sits flush underneath,
                            // casting none itself), so a shadow leaning
                            // toward its own leading (left) edge reads as
                            // "lifting away to reveal what's beneath",
                            // same blur/color convention `SheetSurface`
                            // already uses elsewhere in this file -- only
                            // an offset axis away (x, not y), since the
                            // travel here is horizontal. Gated on
                            // `swipe-nav-dx > 0px` (only while an actual
                            // back-reveal is happening) rather than always
                            // on, so it doesn't look like a stray shadow
                            // around the note view the rest of the time.
                            drop-shadow-blur: root.swipe-nav-dx > 0px ? 10px * Metrics.ui-scale : 0px;
                            drop-shadow-offset-x: -6px * Metrics.ui-scale;
                            drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;
                        }

                        capture-key-pressed(event) => {
                            if (event.modifiers.control && (event.text == "z" || event.text == "Z") && !event.modifiers.shift) {
                                root.undo();
                                return accept;
                            }
                            if (event.modifiers.control && (event.text == "y" || event.text == "Y" || ((event.text == "z" || event.text == "Z") && event.modifiers.shift))) {
                                root.redo();
                                return accept;
                            }
                            return reject;
                        }

                        editor-scroll := AppScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                width: 100%;
                                alignment: start;
                                padding-left: Metrics.gutter;
                                padding-right: Metrics.gutter;
                                padding-top: Metrics.spacing-lg;
                                padding-bottom: Metrics.spacing-3xl;
                                spacing: Metrics.spacing-md;
                                min-height: editor-scroll.visible-height + 1px;

                                // In-body note title (Notion / Apple Notes style)
                                Text {
                                    text: root.title != "" ? root.title : @tr("Untitled");
                                    font-size: Metrics.font-headline;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                }

                                // View mode display: hides `@element(...)` marker
                                // syntax behind a `NoteBodyView` (see
                                // `src/render/mod.rs`), with a double-tap
                                // detector over the whole area same as before.
                                view-box := Rectangle {
                                    visible: !root.edit-mode;
                                    height: !root.edit-mode ? max(160px, max(view-layout.preferred-height, editor-scroll.visible-height - 120px)) : 0px;

                                    view-layout := VerticalLayout {
                                        alignment: start;
                                        spacing: Metrics.spacing-sm;

                                        if root.body == "": Text {
                                            width: 100%;
                                            text: @tr("Tap Edit or double-tap here to write.");
                                            font-size: root.font-size;
                                            color: Colors.muted;
                                            wrap: word-wrap;
                                        }

                                        NoteBodyView {
                                            width: 100%;
                                            items: root.note-body-items;
                                            text-font-size: root.font-size;
                                        }
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        property <duration> last-tap-time: 0ms;
                                        property <length> last-tap-x: 0px;
                                        property <length> last-tap-y: 0px;

                                        clicked => {
                                            let now = animation-tick();
                                            let dt = now - self.last-tap-time;
                                            let dx = abs(self.pressed-x - self.last-tap-x);
                                            let dy = abs(self.pressed-y - self.last-tap-y);
                                            if (self.last-tap-time > 0ms && dt >= 0ms && dt < 600ms && dx < 80px * Metrics.ui-scale && dy < 80px * Metrics.ui-scale) {
                                                root.focus-editor();
                                                self.last-tap-time = 0ms;
                                            } else {
                                                self.last-tap-time = now;
                                                self.last-tap-x = self.pressed-x;
                                                self.last-tap-y = self.pressed-y;
                                            }
                                        }
                                        double-clicked => {
                                            root.focus-editor();
                                        }
                                    }
                                }

                                editor := TextInput {
                                    visible: root.edit-mode;
                                    enabled: root.has-note && root.edit-mode;
                                    font-size: root.font-size;
                                    text <=> root.body;
                                    color: Palette.foreground;
                                    selection-background-color: Palette.accent-background.with-alpha(0.3);
                                    selection-foreground-color: Palette.foreground;
                                    single-line: false;
                                    wrap: word-wrap;
                                    height: root.edit-mode ? max(160px, max(self.preferred-height, editor-scroll.visible-height - 120px)) : 0px;
                                    edited => { root.edited(self.text); }
                                    cursor-position-changed(cpos) => {
                                        let cpos-screen-y = editor.y + cpos.y;
                                        if (cpos-screen-y + editor-scroll.content-y < 0px) {
                                            editor-scroll.content-y = min(
                                                0px,
                                                editor-scroll.visible-height - cpos-screen-y - 32px,
                                                max(editor-scroll.visible-height - self.height, -cpos-screen-y),
                                            );
                                        } else if (cpos-screen-y + editor-scroll.content-y > editor-scroll.visible-height - 32px) {
                                            editor-scroll.content-y = min(0px, max(editor-scroll.visible-height - self.height, editor-scroll.visible-height - cpos-screen-y - 32px));
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.note-view == 0 && root.can-navigate-forward && root.swipe-nav-dx < 0px: HistoryPreviewPanel {
                        x: parent.width + root.swipe-nav-dx;
                        width: parent.width;
                        height: parent.height;
                        title: root.history-forward-title;
                        items: root.history-forward-items;
                        text-font-size: root.font-size;
                        // Depth cue mirroring edit-scope's own back-reveal
                        // shadow above: this panel is the moving/elevated
                        // one for a forward drag (the fixed current note
                        // sits flush underneath), so the same leading-edge
                        // shadow treatment applies -- unconditional here,
                        // since this whole panel only exists while
                        // `swipe-nav-dx < 0px` already (see the `if` above).
                        drop-shadow-blur: 10px * Metrics.ui-scale;
                        drop-shadow-offset-x: -6px * Metrics.ui-scale;
                        drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;
                    }

                    PropertiesView {
                        visible: root.note-view == 1;
                        width: 100%;
                        height: 100%;
                        inset-bottom: root.inset-bottom;
                        has-note: root.has-note;
                        note-title: root.title;
                        note-path: root.note-path;
                        char-count: root.char-count;
                        word-count: root.word-count;
                        line-count: root.line-count;
                        has-conflict: root.has-conflict;
                        conflict-total: root.conflict-total;
                        conflict-a-preview: root.conflict-a-preview;
                        conflict-b-preview: root.conflict-b-preview;
                        conflict-a-label: root.conflict-a-label;
                        conflict-b-label: root.conflict-b-label;
                        conflict-a-button-label: root.conflict-a-button-label;
                        conflict-b-button-label: root.conflict-b-button-label;
                        resolve-mine => { root.resolve-mine(); }
                        resolve-theirs => { root.resolve-theirs(); }
                        open-conflict-sheet => { root.open-conflict-sheet(); }
                    }
                }
            }

            // Edit/Done FAB -- moved out of the header (see the overflow
            // menu above). Lives inside body-surface, not as a bare
            // child of EditorScreen, so it inherits the sheet's own
            // opacity fade and y-offset (SheetSurface's `sheet-progress`/
            // `root.sheet-y-offset`) -- a child outside this surface
            // would stay fully visible even while the sheet is collapsed
            // into the mini-card. Can't reuse origami-mobile's `Fab`
            // directly: its icon is hardcoded to `TablerIcons.plus`, not a
            // parameter, so this matches its visual recipe (size,
            // shape, color, shadow) by hand instead.
            if root.has-note && root.note-view == 0: Rectangle {
                x: parent.width - self.width - Metrics.gutter;
                y: parent.height - self.height - Metrics.gutter;
                width: root.fab-size;
                height: root.fab-size;
                border-radius: self.width / 2;
                background: Palette.accent-background;
                drop-shadow-blur: 8px * Metrics.ui-scale;
                drop-shadow-offset-y: 2px * Metrics.ui-scale;
                drop-shadow-color: #00000055;

                Icon {
                    source: root.edit-mode ? TablerIcons.check : TablerIcons.pencil;
                    color: Palette.accent-foreground;
                    width: Metrics.icon-lg * 1.4;
                    height: Metrics.icon-lg * 1.4;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    clicked => {
                        if (root.edit-mode) {
                            root.view-mode();
                        } else {
                            root.focus-editor();
                        }
                    }
                }
            }

            // Note history back/forward navigation, left-aligned at the
            // body's bottom edge. Always shown when not in edit mode
            // (dimmed/untappable when there's nowhere to go -- see NavPill's
            // own doc comment).
            if !root.edit-mode: NavPill {
                x: Metrics.gutter;
                y: parent.height - root.pill-height - Metrics.gutter;
                can-back: root.can-navigate-back;
                can-forward: root.can-navigate-forward;
                back => { root.navigate-back(); }
                forward => { root.navigate-forward(); }
            }

            // Note sheet view switcher (Body / Properties, ...) centered at the
            // body's bottom edge. Hidden when editing (where that area is
            // destined to become a toolbar) and gated behind has-note.
            if !root.edit-mode && root.has-note: ViewSwitcher {
                x: (parent.width - self.width) / 2;
                y: parent.height - root.pill-height - Metrics.gutter;
                icons: [TablerIcons.note, TablerIcons.info-circle];
                selected: root.note-view;
                changed(i) => { root.note-view = i; }
            }
        }
    }

    // Pushes content above the keyboard or system bar when present. Fixed
    // at the true bottom of the screen -- not part of either gesture
    // surface, since dragging is disabled whenever the keyboard is up
    // anyway (app.slint gates header-swipe-enabled on keyboard == 0px).
    if root.inset-bottom > 0px: Rectangle {
        x: 0px;
        y: root.height - root.inset-bottom;
        width: 100%;
        height: root.inset-bottom;
        background: Colors.surface;
    }
}
