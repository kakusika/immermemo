import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origami-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origami-icons/icons.slint";
import { BubbleButton } from "@origami-mobile/widgets.slint";

// A `SwipeGestureHandler` that only recognizes a downward drag and turns
// its raw `moved`/`swiped`/`cancelled` signals into the (dy,
// average-downward-px/ms) shape a note-sheet-style "drag down to
// dismiss" surface wants -- the same conversion `EditorScreen`'s own
// header/body gesture areas need, and what each full-screen sheet
// (`VaultSheet`, `HistorySheet`, `VaultHistorySheet`, `IconPickerSheet`)
// needs too. Wrap whatever should react to the drag as this component's
// child, same as wrapping it in a plain `SwipeGestureHandler` directly;
// the caller still owns `x`/`y`/`width`/`height`/`enabled` and decides
// what `sheet-drag-moved`/`-swiped`/`-cancelled` mean (forward them to
// the sheet-wide drag/progress state, same as `App`'s
// `SheetDragState`/`is-dragging-sheet` consumers already do).
export component SheetDragArea inherits SwipeGestureHandler {
    in property <length> inset-top: 0px;
    handle-swipe-down: true;
    property <duration> drag-start-time: 0ms;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();

    changed pressed-position => {
        root.drag-start-time = animation-tick();
    }
    moved => {
        // Ignore swipes that begin inside the status bar / notification area.
        if (self.swiping && self.pressed-position.y >= root.inset-top) {
            let dy = self.current-position.y - self.pressed-position.y;
            root.sheet-drag-moved(dy);
        }
    }
    swiped => {
        if (self.pressed-position.y >= root.inset-top) {
            let dy = self.current-position.y - self.pressed-position.y;
            let elapsed-ms = max(1.0, (animation-tick() - root.drag-start-time) / 1ms);
            root.sheet-drag-swiped(dy, (dy / 1px) / elapsed-ms);
        } else {
            root.sheet-drag-cancelled();
        }
    }
    cancelled => {
        root.sheet-drag-cancelled();
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    callback clicked();

    horizontal-stretch: 1;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 3px * Metrics.ui-scale;
        padding-top: 4px * Metrics.ui-scale;
        padding-bottom: 4px * Metrics.ui-scale;

        // Centered pill indicator
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 60px * Metrics.ui-scale;
                height: 32px * Metrics.ui-scale;
                border-radius: self.height / 2;
                background: root.active ? Palette.accent-background.with-alpha(0.18) : transparent;
                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                Icon {
                    source: root.icon;
                    color: root.active ? Palette.accent-background : Colors.muted;
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate color {
                        duration: 120ms;
                        easing: ease-out;
                    }
                }

                if root.badge-count > 0: Rectangle {
                    x: parent.width - self.width - 4px * Metrics.ui-scale;
                    y: 2px * Metrics.ui-scale;
                    width: root.badge-count > 9 ? 18px * Metrics.ui-scale : 14px * Metrics.ui-scale;
                    height: 14px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.badge-count > 99 ? "99+" : root.badge-count;
                            font-size: Metrics.font-badge;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.badge-count == 0 && root.badge-dot: Rectangle {
                    x: parent.width - 12px * Metrics.ui-scale;
                    y: 3px * Metrics.ui-scale;
                    width: 7px * Metrics.ui-scale;
                    height: 7px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;
                }
            }
        }

        Text {
            text: root.label;
            font-size: Metrics.font-sm;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Palette.accent-background : Colors.muted;
            horizontal-alignment: center;
            animate color {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }
}

// Floating Mini-Player Note Card shown above the bottom nav bar
export component MiniNoteCard inherits Rectangle {
    in property <string> title: "";
    in property <string> preview: "";
    in property <bool> has-conflict: false;
    in property <bool> syncing: false;
    in property <bool> remote-configured: true;
    in property <string> status: "";
    in property <bool> status-is-error: false;
    callback clicked();
    callback expand();
    callback sync();

    height: Metrics.mini-card-height;
    background: Colors.surface-elevated;
    border-radius: Metrics.radius-lg;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    // Background tap target to open note sheet
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px * Metrics.ui-scale;
        padding-right: 8px * Metrics.ui-scale;
        spacing: 8px * Metrics.ui-scale;

        // Left note icon badge (vertically centered)
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px * Metrics.ui-scale;
                height: 36px * Metrics.ui-scale;
                border-radius: Metrics.radius-md;
                background: root.has-conflict
                    ? Colors.warning.with-alpha(0.18)
                    : Palette.accent-background.with-alpha(0.18);

                Icon {
                    source: root.has-conflict ? TablerIcons.alert-triangle : TablerIcons.note;
                    color: root.has-conflict ? Colors.warning : Palette.accent-background;
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Center title & excerpt
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title != "" ? root.title : @tr("Untitled");
                font-size: Metrics.font-body;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.has-conflict: Text {
                text: @tr("Conflict detected");
                font-size: Metrics.font-caption;
                color: Colors.warning;
                overflow: elide;
            }

            if !root.has-conflict && root.preview != "": Text {
                text: root.preview;
                font-size: Metrics.font-caption;
                color: Colors.muted;
                overflow: elide;
            }
        }

        // Right sync status button (vertically centered)
        if root.remote-configured: VerticalLayout {
            alignment: center;

            BubbleButton {
                icon: root.syncing ? TablerIcons.refresh
                    : root.status-is-error ? TablerIcons.alert-triangle
                    : root.status != "" ? TablerIcons.check
                    : TablerIcons.cloud;
                tint: root.syncing ? Palette.accent-background
                    : root.status-is-error ? Colors.danger
                    : root.status != "" ? Colors.muted
                    : Colors.muted;
                spinning: root.syncing;
                clicked => { root.sync(); }
            }
        }
    }
}

export component BottomNavBar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in property <length> inset-bottom: 0px;
    in property <int> conflict-count: 0;
    in property <bool> current-has-conflict: false;
    callback tab-selected(int);

    height: Metrics.bottom-bar-height + root.inset-bottom;
    background: Colors.surface-elevated;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: -2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #00000088 : #00000018;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: Metrics.bottom-bar-height;
        padding-left: 0px;
        padding-right: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        NavItem {
            icon: TablerIcons.home;
            label: @tr("Home");
            active: root.active-tab == 0;
            clicked => {
                root.active-tab = 0;
                root.tab-selected(0);
            }
        }

        NavItem {
            icon: TablerIcons.files;
            label: @tr("Library");
            active: root.active-tab == 1;
            badge-count: root.conflict-count;
            clicked => {
                root.active-tab = 1;
                root.tab-selected(1);
            }
        }

        NavItem {
            icon: TablerIcons.search;
            label: @tr("Search");
            active: root.active-tab == 2;
            clicked => {
                root.active-tab = 2;
                root.tab-selected(2);
            }
        }

        NavItem {
            icon: TablerIcons.settings;
            label: @tr("Settings");
            active: root.active-tab == 3;
            clicked => {
                root.active-tab = 3;
                root.tab-selected(3);
            }
        }
    }
}

// Icon-only segmented switcher for the note sheet's own views (Body,
// Properties, ...). Unlike `SegmentedControl` (text, full-width,
// Settings-style) this is a compact, self-sized pill group -- a mode
// switch for *the currently open note's* content, not a page-wide
// setting. Sits next to `NavPill` as one group at the body's bottom
// edge (see `EditorScreen`) -- not tied to the Edit/Done FAB's own
// position, so it doesn't go orphaned when the FAB itself disappears
// (Properties view has nothing to edit). Sizing mirrors
// `BubbleButton`'s bubble-in-a-touch-target recipe: each segment's
// visible pill is a square the track's own height, which is
// Metrics.bubble-button-size -- the same visual size as the header's
// own BubbleButtons, matched on request after an earlier pass first
// tried a full Metrics.touch cell and found it inconsistent.
export component ViewSwitcher inherits Rectangle {
    in property <[image]> icons;
    in property <int> selected: 0;
    callback changed(int);

    // Each cell is Metrics.bubble-button-size, with Metrics.spacing-xs
    // as the track's margin on every side -- equal padding top/bottom
    // and left/right, unlike a first pass at this that only padded
    // left/right.
    height: Metrics.bubble-button-size + 2 * Metrics.spacing-xs;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Colors.surface-elevated;
    drop-shadow-blur: 8px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    row := HorizontalLayout {
        padding: Metrics.spacing-xs;
        spacing: Metrics.spacing-xs;

        for icon[i] in root.icons: Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: i == root.selected ? Palette.accent-background.with-alpha(0.18) : transparent;
            animate background {
                duration: 150ms;
                easing: ease-out;
            }

            Icon {
                source: icon;
                color: i == root.selected ? Palette.accent-background : Colors.muted;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                animate color {
                    duration: 120ms;
                    easing: ease-out;
                }
            }

            TouchArea {
                clicked => { root.changed(i); }
            }
        }
    }
}

// Back/forward through the note history (session.rs's
// BackForwardStack), grouped with ViewSwitcher as one pair at the
// note sheet body's bottom edge (see `EditorScreen`) -- deliberately
// drawn with directional chevrons (not mode-selection icons) so the
// pill's own shape signals "this is the swipeable one", distinct from
// ViewSwitcher's Body/Properties toggle. Swiping the body itself to
// navigate isn't wired up yet (still just this pill, tap-only); the
// chevrons already read as "this direction, swipe or tap" either way,
// so that can follow later without changing what this communicates.
// Unlike the mini card's own reveal chevrons (which hide entirely when
// a direction has nowhere to go), both sides always render here --
// dimmed and untappable instead -- since this is a persistent, always-
// visible control rather than something revealed mid-gesture: hiding
// a side here would look like the pill itself is broken/missing a
// piece, not like "nothing to do that way".
export component NavPill inherits Rectangle {
    in property <bool> can-back: false;
    in property <bool> can-forward: false;
    callback back();
    callback forward();

    height: Metrics.bubble-button-size + 2 * Metrics.spacing-xs;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Colors.surface-elevated;
    drop-shadow-blur: 8px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    row := HorizontalLayout {
        padding: Metrics.spacing-xs;
        spacing: Metrics.spacing-xs;

        Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: root.can-back && back-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Icon {
                source: TablerIcons.chevron-left;
                color: root.can-back ? Colors.muted : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            back-touch := TouchArea {
                enabled: root.can-back;
                clicked => { root.back(); }
            }
        }

        Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: root.can-forward && forward-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Icon {
                source: TablerIcons.chevron-right;
                color: root.can-forward ? Colors.muted : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            forward-touch := TouchArea {
                enabled: root.can-forward;
                clicked => { root.forward(); }
            }
        }
    }
}
