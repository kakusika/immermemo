import { Palette } from "std-widgets.slint";

// A 24x24 icon drawn as a stroked path, so no icon font has to exist on the
// device.
// IMPORTANT SLINT LAYOUT RULE: In a HorizontalLayout, fixed-height elements like
// Icon or badges will default to y: 0 (top-aligned) because HorizontalLayout lacks
// cross-axis alignment. Always wrap an Icon or badge in `VerticalLayout { alignment: center; ... }`
// when placing it alongside text in a HorizontalLayout to guarantee vertical centering.
export component Icon inherits Path {
    in property <string> shape;
    in property <color> tint: Palette.foreground;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.shape;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

