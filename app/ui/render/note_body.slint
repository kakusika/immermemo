import { Palette } from "std-widgets.slint";
import { Metrics } from "@origiri-mobile/tokens.slint";
import { RenderedBlock, RenderedBlockView } from "rendered_block.slint";
import { RichTextLine, FlowView } from "flow_view.slint";

// One item of the note body's view-mode display: either a classified
// block (`RenderedBlockView`, one shape per whole block -- a plain
// paragraph, or a standalone element between paragraphs) or a paragraph
// that had at least one inline element and needed to flow as one or more
// lines (`FlowView`) instead of stacking each split fragment as its own
// row. `immermemo_editor::note_body_items` decides which; see its doc
// comment for why a flat `[RenderedBlock]` alone isn't enough.
export struct NoteBodyItemView {
    is-flow: bool,
    heading-level: int,
    depth: int,
    prefix: string,
    block: RenderedBlock,
    lines: [RichTextLine],
}

export component NoteBodyView inherits VerticalLayout {
    in property <[NoteBodyItemView]> items;
    in property <length> text-font-size;
    callback link-clicked(string);
    callback task-toggled(int);

    alignment: start;
    spacing: Metrics.spacing-xs;

    for item[idx] in root.items: HorizontalLayout {
        padding-left: item.depth * (16px * Metrics.ui-scale);
        padding-top: item.heading-level == 1 ? Metrics.spacing-md
            : item.heading-level == 2 ? Metrics.spacing-sm
            : item.heading-level >= 3 ? Metrics.spacing-xs
            : 0px;
        spacing: Metrics.spacing-xs;

        property <length> item-font-size: item.heading-level == 1 ? root.text-font-size * 1.5
            : item.heading-level == 2 ? root.text-font-size * 1.3
            : item.heading-level >= 3 ? root.text-font-size * 1.15
            : root.text-font-size;
        property <int> item-font-weight: item.heading-level > 0 ? 700 : 400;

        if item.prefix != "": VerticalLayout {
            alignment: start;
            Text {
                text: item.prefix;
                font-size: item-font-size;
                font-weight: 600;
                color: Palette.foreground.with-alpha(0.6);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;

            if !item.is-flow: RenderedBlockView {
                width: 100%;
                block: item.block;
                text-font-size: item-font-size;
                text-font-weight: item-font-weight;
                link-clicked(target) => { root.link-clicked(target); }
                task-toggled => { root.task-toggled(idx); }
            }

            if item.is-flow: FlowView {
                width: 100%;
                lines: item.lines;
                font-size: item-font-size;
                font-weight: item-font-weight;
                text-color: Palette.foreground;
                link-clicked(target) => { root.link-clicked(target); }
            }
        }
    }
}
