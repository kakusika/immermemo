import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import {
    BubbleButton,
    IconButton,
    TopBar,
    Fab,
    AppScrollView,
    SegmentedControl,
    IconTile,
} from "@origiri-mobile/widgets.slint";
import { LongPressRippleArea } from "../widgets/long_press_ripple.slint";
import { NoteIconContent, NoteIconView } from "../widgets/note_icon.slint";
import { DirectoryTile } from "../widgets/directory_tile.slint";
import { SelectionAdapter } from "../adapters/selection.slint";
import { DailyCalendarView } from "../widgets/daily_calendar.slint";

// One row of the Directory page's List view, or one tile of its Grid
// view -- both are the direct contents of whichever folder is currently
// browsed (see `app/src/directory.rs`'s `build_folder_entries`).
// `note-index` is `-1` for a folder row/tile (folders have no index of
// their own, only a `key` derived from splitting titles on `/`).
export struct DirectoryEntry {
    is-folder: bool,
    key: string,
    display: string,
    note-index: int,
    has-conflict: bool,
    // A note's `@meta{ icon: ... }`, resolved (see
    // `immermemo::session::to_entry_view`). `empty` for a folder entry, or a
    // note with no such meta -- `file`/`folder` (TablerIcons) stand in for
    // either below.
    icon: NoteIconView,
    path: string,
    is-selected: bool,
}

// One tappable segment of the breadcrumb trail above the browsed folder's
// contents -- `key` is what a tap navigates to, `display` is just that
// segment's own name. See `DirectoryBreadcrumb` below.
export struct BreadcrumbSegment {
    key: string,
    display: string,
}

// The folder-browsing context above List/Grid's contents: a breadcrumb
// trail that jumps to any specific ancestor folder, its first entry
// always the vault root itself (shown as a home icon, `seg.key == ""` --
// the only way back to it now that there's no separate always-present
// root button). Shared by both view modes -- they browse the same
// folder-at-a-time state, just render its contents differently.
// `alignment: start` keeps the trail packed to the left at its own
// natural width -- without it, `HorizontalLayout`'s default `stretch`
// alignment spreads its children across the whole row instead of packing
// them together.
component DirectoryBreadcrumb inherits HorizontalLayout {
    in property <[BreadcrumbSegment]> segments;
    callback go-to(string);

    alignment: start;
    spacing: Metrics.spacing-xs;

    for seg[i] in root.segments: HorizontalLayout {
        spacing: Metrics.spacing-xs;

        if i > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: TablerIcons.chevron-right;
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                color: Colors.muted;
            }
        }

        Rectangle {
            crumb-touch := TouchArea {
                clicked => { root.go-to(seg.key); }
            }

            VerticalLayout {
                alignment: center;

                if seg.key == "": Icon {
                    source: TablerIcons.home;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                    color: crumb-touch.pressed ? Palette.foreground : Colors.muted;
                }

                if seg.key != "": Text {
                    text: seg.display;
                    font-size: Metrics.font-sub;
                    font-weight: i == root.segments.length - 1 ? 700 : 600;
                    color: i == root.segments.length - 1
                        ? Palette.foreground
                        : (crumb-touch.pressed ? Palette.foreground : Colors.muted);
                }
            }
        }
    }
}

// Android native Material 3 list item for folder and note entries:
// - Left: rounded container with icon (squircle background), or checkmark when selected
// - Center: title text with conflict indicator if applicable
// - Right: 3-dot overflow menu icon (dots-vertical) or selection checkbox
component DirectoryRow inherits Rectangle {
    in property <bool> is-folder: false;
    in property <NoteIconView> icon;
    in property <string> display-text: "";
    in property <bool> highlighted: false;
    in property <bool> has-conflict: false;
    in property <bool> show-menu: true;
    in property <bool> long-press-enabled: true;
    in property <bool> is-selected: false;
    in property <bool> selection-mode: false;
    callback clicked();
    callback menu-clicked();
    callback long-pressed();

    height: 56px * Metrics.ui-scale;

    highlight-rect := LongPressRippleArea {
        x: Metrics.spacing-xs;
        y: 2px * Metrics.ui-scale;
        width: parent.width - 2 * Metrics.spacing-xs;
        height: parent.height - 4px * Metrics.ui-scale;
        border-radius: 12px * Metrics.ui-scale;
        base-background: root.is-selected
            ? Palette.accent-background.with-alpha(0.18)
            : (root.highlighted ? Palette.accent-background.with-alpha(0.18) : transparent);
        long-press-enabled: root.long-press-enabled;
        clicked => { root.clicked(); }
        long-pressed => { root.long-pressed(); }

        HorizontalLayout {
            padding-left: Metrics.spacing-sm + 2px * Metrics.ui-scale;
            padding-right: Metrics.spacing-xs;
            spacing: Metrics.spacing-md;

            // Leading rounded background container with icon OR checkmark
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px * Metrics.ui-scale;
                    height: 40px * Metrics.ui-scale;
                    border-radius: 10px * Metrics.ui-scale;
                    background: root.is-folder
                        ? Palette.accent-background.with-alpha(0.14)
                        : (root.is-selected
                        ? Palette.accent-background
                        : (root.highlighted
                        ? Palette.accent-background.with-alpha(0.24)
                        : Palette.foreground.with-alpha(0.06)));
                    animate background { duration: 150ms; }

                    if root.is-folder: Icon {
                        source: TablerIcons.folder;
                        width: 20px * Metrics.ui-scale;
                        height: 20px * Metrics.ui-scale;
                        color: Palette.accent-background;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if !root.is-selected && !root.is-folder: NoteIconContent {
                        width: parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        icon: root.icon;
                        fallback: TablerIcons.file-text;
                        tint: root.highlighted ? Palette.accent-background : Palette.foreground;
                        glyph-size: 20px * Metrics.ui-scale;
                    }

                    if root.is-selected && !root.is-folder: Icon {
                        source: TablerIcons.check;
                        width: 22px * Metrics.ui-scale;
                        height: 22px * Metrics.ui-scale;
                        color: Palette.accent-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Title
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                Text {
                    text: root.display-text;
                    font-size: Metrics.font-body;
                    font-weight: root.is-folder ? 600 : (root.is-selected ? 600 : (root.highlighted ? 600 : 400));
                    color: (root.is-selected || root.highlighted) ? Palette.accent-background : Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Conflict indicator dot
            if root.has-conflict: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px * Metrics.ui-scale;
                    height: 8px * Metrics.ui-scale;
                    border-radius: 4px * Metrics.ui-scale;
                    background: Colors.warning;
                }
            }

            // Trailing 3-dot overflow menu (normal mode)
            if root.show-menu && !root.selection-mode: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px * Metrics.ui-scale;
                    height: 40px * Metrics.ui-scale;
                    border-radius: 20px * Metrics.ui-scale;
                    background: menu-touch.pressed ? Palette.foreground.with-alpha(0.12) : transparent;
                    animate background { duration: 100ms; }

                    Icon {
                        source: TablerIcons.dots-vertical;
                        width: Metrics.icon-md;
                        height: Metrics.icon-md;
                        color: Colors.muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    menu-touch := TouchArea {
                        clicked => {
                            root.menu-clicked();
                        }
                    }
                }
            }

            // Trailing checkbox (selection mode)
            if !root.is-folder && root.selection-mode: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px * Metrics.ui-scale;
                    height: 24px * Metrics.ui-scale;
                    border-radius: 12px * Metrics.ui-scale;
                    border-width: 2px * Metrics.ui-scale;
                    border-color: root.is-selected ? Palette.accent-background : Colors.muted.with-alpha(0.6);
                    background: root.is-selected ? Palette.accent-background : transparent;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    if root.is-selected: Icon {
                        source: TablerIcons.check;
                        width: 14px * Metrics.ui-scale;
                        height: 14px * Metrics.ui-scale;
                        color: Palette.accent-foreground;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}


export component FilesScreen inherits Rectangle {
    in property <int> current: -1;
    in property <string> status;
    in property <bool> syncing;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <bool> highlight-current: false;
    in property <bool> remote-configured: false;
    // 0: section hub (Directory/List/Diary tiles), 1: Directory. in-out
    // so the app-level Back action can pop it, same shape as
    // sheets/settings/settings.slint's own `page` -- see app.slint's handle-back().
    in-out property <int> page: 0;
    // Directory's own view-mode switch: 0 = List, 1 = Grid. Both browse
    // the same folder-at-a-time state (`folder-entries`/`breadcrumb`, see
    // `app/src/directory.rs`'s `build_folder_entries`/
    // `build_breadcrumb`) and only ever carry a `note-index` into the
    // same flat note list every other action already indexes by -- they
    // differ purely in how they render one folder's contents.
    in-out property <int> directory-mode: 0;
    in-out property <bool> calendar-show-month-picker: false;
    in property <[DirectoryEntry]> folder-entries: [];
    in property <[BreadcrumbSegment]> breadcrumb: [];

    callback select(int);
    callback new-note();
    callback sync();
    callback open-settings();
    callback note-menu-requested(int);
    callback navigate-folder(string);
    callback trigger-haptic();
    callback trigger-heavy-haptic();

    background: Colors.page-background;

    VerticalLayout {
        TopBar {
            inset-top: root.inset-top;
            bar-background: transparent;

            if root.page != 0: IconButton {
                icon: TablerIcons.x;
                clicked => { root.page = 0; }
            }

            Text {
                horizontal-stretch: 1;
                text: root.page == 1 ? @tr("Directory")
                    : root.page == 2 ? @tr("Daily Notes")
                    : root.page == 3 ? @tr("Starred")
                    : root.page == 4 ? @tr("Recent")
                    : root.page == 5 ? @tr("Graph View")
                    : root.page == 6 ? @tr("All Notes")
                    : root.page == 7 ? @tr("Tasks")
                    : @tr("Library");
                font-size: Metrics.font-title;
                font-weight: 700;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
            }

            BubbleButton {
                icon: TablerIcons.refresh;
                enabled: !root.syncing;
                tint: root.syncing ? Palette.accent-background : Palette.foreground;
                clicked => { root.sync(); }
            }
        }

        // Top spacing
        Rectangle {
            height: Metrics.spacing-xs + 2px * Metrics.ui-scale;
        }

        if root.page == 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: Metrics.spacing-sm;
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;
                spacing: Metrics.spacing-sm;

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.folder;
                        label-text: @tr("Directory");
                        clicked => { root.page = 1; }
                    }

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.calendar;
                        label-text: @tr("Daily Notes");
                        clicked => { root.page = 2; }
                    }
                }

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.star;
                        label-text: @tr("Starred");
                        clicked => { root.page = 3; }
                    }

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.clock;
                        label-text: @tr("Recent");
                        clicked => { root.page = 4; }
                    }
                }

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.git-fork;
                        label-text: @tr("Graph View");
                        clicked => { root.page = 5; }
                    }

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.list;
                        label-text: @tr("All Notes");
                        clicked => { root.page = 6; }
                    }
                }

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;

                    IconTile {
                        tile-height: 88px * Metrics.ui-scale;
                        icon: TablerIcons.checkbox;
                        label-text: @tr("Tasks");
                        clicked => { root.page = 7; }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        background: transparent;
                    }
                }
            }
        }

        if root.page == 1 && root.breadcrumb.length > 0: DirectoryBreadcrumb {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-bottom: Metrics.spacing-sm;
            segments: root.breadcrumb;
            go-to(key) => { root.navigate-folder(key); }
        }

        if root.page == 1: HorizontalLayout {
            padding-left: Metrics.gutter;
            padding-right: Metrics.gutter;
            padding-bottom: Metrics.spacing-sm;

            SegmentedControl {
                options: [@tr("List"), @tr("Grid")];
                selected: root.directory-mode;
                changed(i) => { root.directory-mode = i; }
            }
        }

        if root.page == 1 && root.folder-entries.length == 0: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-md;
                Icon {
                    source: TablerIcons.files;
                    color: Colors.muted.with-alpha(0.5);
                    width: Metrics.icon-xl;
                    height: Metrics.icon-xl;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: root.breadcrumb.length > 0 ? @tr("This folder is empty") : @tr("No notes yet");
                    font-size: Metrics.font-body;
                    font-weight: 600;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }

                if root.breadcrumb.length == 0: Text {
                    text: @tr("Tap + below to create your first note");
                    font-size: Metrics.font-sub;
                    color: Colors.muted;
                    horizontal-alignment: center;
                }
            }
        }

        // List view
        if root.page == 1 && root.directory-mode == 0 && root.folder-entries.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;

                for entry[i] in root.folder-entries: DirectoryRow {
                    is-folder: entry.is-folder;
                    icon: entry.icon;
                    display-text: entry.display;
                    highlighted: !entry.is-folder && root.highlight-current && entry.note-index == root.current;
                    has-conflict: !entry.is-folder && entry.has-conflict;
                    show-menu: !entry.is-folder && !SelectionAdapter.selection-mode;
                    long-press-enabled: !entry.is-folder;
                    is-selected: entry.is-selected;
                    selection-mode: SelectionAdapter.selection-mode;
                    clicked => {
                        if (entry.is-folder) {
                            root.navigate-folder(entry.key);
                        } else if (SelectionAdapter.selection-mode) {
                            SelectionAdapter.toggle(entry.path);
                        } else {
                            root.select(entry.note-index);
                        }
                    }
                    menu-clicked => {
                        root.trigger-heavy-haptic();
                        root.note-menu-requested(entry.note-index);
                    }
                    long-pressed => {
                        root.trigger-heavy-haptic();
                        if (!entry.is-folder) {
                            if (!SelectionAdapter.selection-mode) {
                                SelectionAdapter.select-only(entry.path);
                            } else {
                                SelectionAdapter.toggle(entry.path);
                            }
                        }
                    }
                }
            }
        }

        // Grid view
        if root.page == 1 && root.directory-mode == 1 && root.folder-entries.length > 0: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;
                spacing: Metrics.spacing-sm;

                GridLayout {
                    spacing: Metrics.spacing-sm;

                    for entry[i] in root.folder-entries: DirectoryTile {
                        row: i / 3;
                        col: Math.mod(i, 3);
                        tile-height: 96px * Metrics.ui-scale;
                        is-folder: entry.is-folder;
                        icon: entry.icon;
                        label-text: entry.display;
                        highlighted: (!entry.is-folder && entry.is-selected)
                            || (!entry.is-folder && root.highlight-current && entry.note-index == root.current);
                        long-press-enabled: !entry.is-folder;
                        clicked => {
                            if (entry.is-folder) {
                                root.navigate-folder(entry.key);
                            } else if (SelectionAdapter.selection-mode) {
                                SelectionAdapter.toggle(entry.path);
                            } else {
                                root.select(entry.note-index);
                            }
                        }
                        long-pressed => {
                            root.trigger-heavy-haptic();
                            if (!entry.is-folder) {
                                if (!SelectionAdapter.selection-mode) {
                                    SelectionAdapter.select-only(entry.path);
                                } else {
                                    SelectionAdapter.toggle(entry.path);
                                }
                            }
                        }

                        if entry.has-conflict: Rectangle {
                            width: Metrics.spacing-sm;
                            height: Metrics.spacing-sm;
                            border-radius: Metrics.spacing-sm / 2;
                            background: Colors.warning;
                        }

                        if !entry.is-folder && SelectionAdapter.selection-mode: Rectangle {
                            width: 20px * Metrics.ui-scale;
                            height: 20px * Metrics.ui-scale;
                            border-radius: 10px * Metrics.ui-scale;
                            border-width: 1.5px * Metrics.ui-scale;
                            border-color: entry.is-selected ? Palette.accent-background : Colors.muted.with-alpha(0.6);
                            background: entry.is-selected ? Palette.accent-background : transparent;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            if entry.is-selected: Icon {
                                source: TablerIcons.check;
                                width: 12px * Metrics.ui-scale;
                                height: 12px * Metrics.ui-scale;
                                color: Palette.accent-foreground;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
        }

        // Daily Notes: Interactive calendar
        if root.page == 2: AppScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: Metrics.spacing-xs;
                padding-bottom: root.inset-bottom + Metrics.bottom-bar-height + Metrics.spacing-lg;
                spacing: Metrics.spacing-sm;

                DailyCalendarView {
                    show-month-picker <=> root.calendar-show-month-picker;
                }

                // Compact Daily Note action card
                Rectangle {
                    background: Colors.surface-elevated;
                    border-radius: Metrics.radius-lg;
                    border-width: 1px;
                    border-color: Palette.color-scheme == ColorScheme.dark
                        ? Palette.foreground.with-alpha(0.08)
                        : Palette.foreground.with-alpha(0.06);

                    HorizontalLayout {
                        padding: Metrics.spacing-md;
                        spacing: Metrics.spacing-sm;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px * Metrics.ui-scale;
                            alignment: center;

                            Text {
                                text: @tr("Daily Journal");
                                font-size: Metrics.font-sub;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Text {
                                text: @tr("Write today's note");
                                font-size: Metrics.font-caption;
                                color: Colors.muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px * Metrics.ui-scale;
                                height: 36px * Metrics.ui-scale;
                                border-radius: 18px * Metrics.ui-scale;
                                background: add-touch.pressed
                                    ? Palette.accent-background.with-alpha(0.24)
                                    : Palette.accent-background.with-alpha(0.12);
                                animate background { duration: 100ms; }

                                add-touch := TouchArea {
                                    clicked => { root.new-note(); }
                                }

                                Icon {
                                    source: TablerIcons.plus;
                                    width: Metrics.icon-sm;
                                    height: Metrics.icon-sm;
                                    color: Palette.accent-background;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Other sections placeholder (Starred, Recent, Graph, All Notes, Tasks)
        if root.page >= 3: Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: Metrics.spacing-lg;
                padding-left: Metrics.gutter * 2;
                padding-right: Metrics.gutter * 2;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 72px * Metrics.ui-scale;
                        height: 72px * Metrics.ui-scale;
                        border-radius: self.width / 2;
                        background: Palette.accent-background.with-alpha(0.12);

                        Icon {
                            source: root.page == 3 ? TablerIcons.star
                                : root.page == 4 ? TablerIcons.clock
                                : root.page == 5 ? TablerIcons.git-fork
                                : root.page == 6 ? TablerIcons.list
                                : TablerIcons.checkbox;
                            color: Palette.accent-background;
                            width: Metrics.icon-xl;
                            height: Metrics.icon-xl;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                VerticalLayout {
                    spacing: Metrics.spacing-xs;
                    alignment: center;

                    Text {
                        text: root.page == 3 ? @tr("Starred Notes")
                            : root.page == 4 ? @tr("Recent Notes")
                            : root.page == 5 ? @tr("Graph View")
                            : root.page == 6 ? @tr("All Notes")
                            : @tr("Task View");
                        font-size: Metrics.font-title;
                        font-weight: 700;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.page == 3 ? @tr("Pinned and frequently referenced master notes.")
                            : root.page == 4 ? @tr("Chronological timeline of your recent note edits.")
                            : root.page == 5 ? @tr("Visual interactive graph of note connections and backlinks.")
                            : root.page == 6 ? @tr("Alphabetical index of all notes across the vault.")
                            : @tr("Aggregated task checklists across all notes.");
                        font-size: Metrics.font-sub;
                        color: Colors.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 28px * Metrics.ui-scale;
                        border-radius: 14px * Metrics.ui-scale;
                        background: Palette.foreground.with-alpha(0.06);

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;

                            Text {
                                text: @tr("Placeholder · Coming Soon");
                                font-size: Metrics.font-sm;
                                font-weight: 600;
                                color: Colors.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.page == 1: Fab {
        x: parent.width - self.width - Metrics.gutter;
        y: parent.height - self.height - Metrics.gutter - root.inset-bottom;
        clicked => { root.new-note(); }
    }
}
