import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { BubbleButton } from "@origiri-mobile/widgets.slint";
import { LongPressRippleArea } from "widgets/long_press_ripple.slint";
export { LongPressRippleArea }

// A `SwipeGestureHandler` that only recognizes a downward drag and turns
// its raw `moved`/`swiped`/`cancelled` signals into the (dy,
// average-downward-px/ms) shape a note-sheet-style "drag down to
// dismiss" surface wants -- the same conversion `EditorScreen`'s own
// header/body gesture areas need, and what each full-screen sheet
// (`VaultSheet`, `HistorySheet`, `VaultHistorySheet`, `IconPickerSheet`)
// needs too. Wrap whatever should react to the drag as this component's
// child, same as wrapping it in a plain `SwipeGestureHandler` directly;
// the caller still owns `x`/`y`/`width`/`height`/`enabled` and decides
// what `sheet-drag-moved`/`-swiped`/`-cancelled` mean (forward them to
// the sheet-wide drag/progress state, same as `App`'s
// `SheetDragState`/`is-dragging-sheet` consumers already do).
export component SheetDragArea inherits SwipeGestureHandler {
    in property <length> inset-top: 0px;
    handle-swipe-down: true;
    property <duration> drag-start-time: 0ms;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();

    changed pressed-position => {
        root.drag-start-time = animation-tick();
    }
    moved => {
        // Ignore swipes that begin inside the status bar / notification area.
        if (self.swiping && self.pressed-position.y >= root.inset-top) {
            let dy = self.current-position.y - self.pressed-position.y;
            root.sheet-drag-moved(dy);
        }
    }
    swiped => {
        if (self.pressed-position.y >= root.inset-top) {
            let dy = self.current-position.y - self.pressed-position.y;
            let elapsed-ms = max(1.0, (animation-tick() - root.drag-start-time) / 1ms);
            root.sheet-drag-swiped(dy, (dy / 1px) / elapsed-ms);
        } else {
            root.sheet-drag-cancelled();
        }
    }
    cancelled => {
        root.sheet-drag-cancelled();
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <int> badge-count: 0;
    in property <bool> badge-dot: false;
    callback clicked();

    horizontal-stretch: 1;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 3px * Metrics.ui-scale;
        padding-top: 1px * Metrics.ui-scale;
        padding-bottom: 1px * Metrics.ui-scale;

        // Centered pill indicator
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 60px * Metrics.ui-scale;
                height: 36px * Metrics.ui-scale;
                border-radius: self.height / 2;
                background: root.active ? Colors.primary-container : transparent;
                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                Icon {
                    source: root.icon;
                    color: root.active ? Colors.primary : Colors.muted;
                    width: 28px * Metrics.ui-scale;
                    height: 28px * Metrics.ui-scale;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate color {
                        duration: 120ms;
                        easing: ease-out;
                    }
                }

                if root.badge-count > 0: Rectangle {
                    x: parent.width - self.width - 2px * Metrics.ui-scale;
                    y: 1px * Metrics.ui-scale;
                    width: root.badge-count > 9 ? 18px * Metrics.ui-scale : 14px * Metrics.ui-scale;
                    height: 14px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.badge-count > 99 ? "99+" : root.badge-count;
                            font-size: Metrics.font-badge;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.badge-count == 0 && root.badge-dot: Rectangle {
                    x: parent.width - 10px * Metrics.ui-scale;
                    y: 2px * Metrics.ui-scale;
                    width: 7px * Metrics.ui-scale;
                    height: 7px * Metrics.ui-scale;
                    border-radius: self.height / 2;
                    background: Colors.warning;
                }
            }
        }

        Text {
            text: root.label;
            font-size: Metrics.font-sm;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Colors.primary : Colors.muted;
            horizontal-alignment: center;
            animate color {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }
}

// Floating Mini-Player Note Card shown above the bottom nav bar
export component MiniNoteCard inherits Rectangle {
    in property <string> title: "";
    in property <string> preview: "";
    in property <bool> has-conflict: false;
    in property <bool> syncing: false;
    in property <bool> remote-configured: true;
    in property <string> status: "";
    in property <bool> status-is-error: false;
    callback clicked();
    callback expand();
    callback sync();

    height: Metrics.mini-card-height;
    background: Colors.surface-elevated;
    border-radius: Metrics.radius-lg;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    // Background tap target to open note sheet
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px * Metrics.ui-scale;
        padding-right: 8px * Metrics.ui-scale;
        spacing: 8px * Metrics.ui-scale;

        // Left note icon badge (vertically centered)
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px * Metrics.ui-scale;
                height: 36px * Metrics.ui-scale;
                border-radius: Metrics.radius-md;
                background: root.has-conflict
                    ? Colors.warning.with-alpha(0.18)
                    : Palette.accent-background.with-alpha(0.18);

                Icon {
                    source: root.has-conflict ? TablerIcons.alert-triangle : TablerIcons.note;
                    color: root.has-conflict ? Colors.warning : Palette.accent-background;
                    width: Metrics.icon-md;
                    height: Metrics.icon-md;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Center title & excerpt
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title != "" ? root.title : @tr("Untitled");
                font-size: Metrics.font-body;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.has-conflict: Text {
                text: @tr("Conflict detected");
                font-size: Metrics.font-caption;
                color: Colors.warning;
                overflow: elide;
            }

            if !root.has-conflict && root.preview != "": Text {
                text: root.preview;
                font-size: Metrics.font-caption;
                color: Colors.muted;
                overflow: elide;
            }
        }

        // Right sync status button (vertically centered)
        if root.remote-configured: VerticalLayout {
            alignment: center;

            BubbleButton {
                icon: root.syncing ? TablerIcons.refresh
                    : root.status-is-error ? TablerIcons.alert-triangle
                    : root.status != "" ? TablerIcons.check
                    : TablerIcons.cloud;
                tint: root.syncing ? Palette.accent-background
                    : root.status-is-error ? Colors.danger
                    : root.status != "" ? Colors.muted
                    : Colors.muted;
                spinning: root.syncing;
                clicked => { root.sync(); }
            }
        }
    }
}

export component BottomNavBar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in property <length> inset-bottom: 0px;
    in property <int> conflict-count: 0;
    in property <bool> current-has-conflict: false;
    in property <bool> has-home: true;
    in property <bool> has-search: true;
    in property <bool> has-library: true;
    in property <bool> has-directory: false;
    in property <bool> has-daily: false;
    in property <bool> has-starred: false;
    in property <bool> has-recent: false;
    in property <bool> has-graph: false;
    in property <bool> has-new-note: true;
    in property <bool> has-sync: true;
    in property <bool> has-switch-vault: true;
    in property <bool> has-settings: true;
    in property <[int]> nav-order: [0, 1, 8, 2, 9, 10, 11, 3, 4, 5, 6, 7];
    in-out property <int> files-page: 0;
    callback action-triggered(int);
    callback open-more();

    pure function check-enabled(id: int) -> bool {
        if (id == 0) { return root.has-home; }
        if (id == 1) { return root.has-search; }
        if (id == 2) { return root.has-library; }
        if (id == 3) { return root.has-directory; }
        if (id == 4) { return root.has-daily; }
        if (id == 5) { return root.has-starred; }
        if (id == 6) { return root.has-recent; }
        if (id == 7) { return root.has-graph; }
        if (id == 8) { return root.has-new-note; }
        if (id == 9) { return root.has-sync; }
        if (id == 10) { return root.has-switch-vault; }
        if (id == 11) { return root.has-settings; }
        return false;
    }

    property <int> cum-0: root.check-enabled(root.nav-order[0]) ? 1 : 0;
    property <int> cum-1: root.cum-0 + (root.check-enabled(root.nav-order[1]) ? 1 : 0);
    property <int> cum-2: root.cum-1 + (root.check-enabled(root.nav-order[2]) ? 1 : 0);
    property <int> cum-3: root.cum-2 + (root.check-enabled(root.nav-order[3]) ? 1 : 0);
    property <int> cum-4: root.cum-3 + (root.check-enabled(root.nav-order[4]) ? 1 : 0);
    property <int> cum-5: root.cum-4 + (root.check-enabled(root.nav-order[5]) ? 1 : 0);
    property <int> cum-6: root.cum-5 + (root.check-enabled(root.nav-order[6]) ? 1 : 0);
    property <int> cum-7: root.cum-6 + (root.check-enabled(root.nav-order[7]) ? 1 : 0);
    property <int> cum-8: root.cum-7 + (root.check-enabled(root.nav-order[8]) ? 1 : 0);
    property <int> cum-9: root.cum-8 + (root.check-enabled(root.nav-order[9]) ? 1 : 0);
    property <int> cum-10: root.cum-9 + (root.check-enabled(root.nav-order[10]) ? 1 : 0);
    property <int> cum-11: root.cum-10 + (root.check-enabled(root.nav-order[11]) ? 1 : 0);
    property <int> total-items: root.cum-11;
    property <bool> has-overflow: root.total-items >= 5;

    pure function cum-at(pos: int) -> int {
        if (pos == 0) { return root.cum-0; }
        if (pos == 1) { return root.cum-1; }
        if (pos == 2) { return root.cum-2; }
        if (pos == 3) { return root.cum-3; }
        if (pos == 4) { return root.cum-4; }
        if (pos == 5) { return root.cum-5; }
        if (pos == 6) { return root.cum-6; }
        if (pos == 7) { return root.cum-7; }
        if (pos == 8) { return root.cum-8; }
        if (pos == 9) { return root.cum-9; }
        if (pos == 10) { return root.cum-10; }
        return root.cum-11;
    }

    pure function item-overflows(id: int) -> bool {
        if (root.nav-order[0] == id) { return root.cum-0 > 4; }
        if (root.nav-order[1] == id) { return root.cum-1 > 4; }
        if (root.nav-order[2] == id) { return root.cum-2 > 4; }
        if (root.nav-order[3] == id) { return root.cum-3 > 4; }
        if (root.nav-order[4] == id) { return root.cum-4 > 4; }
        if (root.nav-order[5] == id) { return root.cum-5 > 4; }
        if (root.nav-order[6] == id) { return root.cum-6 > 4; }
        if (root.nav-order[7] == id) { return root.cum-7 > 4; }
        if (root.nav-order[8] == id) { return root.cum-8 > 4; }
        if (root.nav-order[9] == id) { return root.cum-9 > 4; }
        if (root.nav-order[10] == id) { return root.cum-10 > 4; }
        if (root.nav-order[11] == id) { return root.cum-11 > 4; }
        return false;
    }

    // Exported overflow flags indicating which items overflow into the More modal
    out property <bool> overflow-home: root.has-overflow && root.has-home && root.item-overflows(0);
    out property <bool> overflow-search: root.has-overflow && root.has-search && root.item-overflows(1);
    out property <bool> overflow-library: root.has-overflow && root.has-library && root.item-overflows(2);
    out property <bool> overflow-directory: root.has-overflow && root.has-directory && root.item-overflows(3);
    out property <bool> overflow-daily: root.has-overflow && root.has-daily && root.item-overflows(4);
    out property <bool> overflow-starred: root.has-overflow && root.has-starred && root.item-overflows(5);
    out property <bool> overflow-recent: root.has-overflow && root.has-recent && root.item-overflows(6);
    out property <bool> overflow-graph: root.has-overflow && root.has-graph && root.item-overflows(7);
    out property <bool> overflow-new-note: root.has-overflow && root.has-new-note && root.item-overflows(8);
    out property <bool> overflow-sync: root.has-overflow && root.has-sync && root.item-overflows(9);
    out property <bool> overflow-switch-vault: root.has-overflow && root.has-switch-vault && root.item-overflows(10);
    out property <bool> overflow-settings: root.has-overflow && root.has-settings && root.item-overflows(11);

    property <bool> more-active: (
        (root.overflow-home && root.active-tab == 0) ||
        (root.overflow-search && root.active-tab == 1) ||
        (root.overflow-library && root.active-tab == 2 && (root.files-page == 0 || root.files-page == 6 || root.files-page == 7)) ||
        (root.overflow-directory && root.active-tab == 2 && root.files-page == 1) ||
        (root.overflow-daily && root.active-tab == 2 && root.files-page == 2) ||
        (root.overflow-starred && root.active-tab == 2 && root.files-page == 3) ||
        (root.overflow-recent && root.active-tab == 2 && root.files-page == 4) ||
        (root.overflow-graph && root.active-tab == 2 && root.files-page == 5)
    );
    property <int> more-badge-count: (root.overflow-library) ? root.conflict-count : 0;

    property <length> extra-inset-bottom: max(0px, root.inset-bottom - 6px * Metrics.ui-scale);
    height: Metrics.bottom-bar-height + root.extra-inset-bottom;
    background: Colors.surface-elevated;
    drop-shadow-blur: 10px * Metrics.ui-scale;
    drop-shadow-offset-y: -2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #00000088 : #00000018;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: Metrics.bottom-bar-height;
        padding-left: 0px;
        padding-right: 0px;
        padding-bottom: 0px;
        spacing: 0px;

        for id[pos] in root.nav-order: HorizontalLayout {
            if id == 0 && root.has-home && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.home;
                label: @tr("Home");
                active: root.active-tab == 0;
                clicked => {
                    root.action-triggered(0);
                }
            }

            if id == 1 && root.has-search && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.search;
                label: @tr("Search");
                active: root.active-tab == 1;
                clicked => {
                    root.action-triggered(1);
                }
            }

            if id == 2 && root.has-library && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.files;
                label: @tr("Library");
                active: root.active-tab == 2 && (root.files-page == 0 || root.files-page == 6 || root.files-page == 7 || (!root.has-directory && root.files-page == 1) || (!root.has-daily && root.files-page == 2) || (!root.has-starred && root.files-page == 3) || (!root.has-recent && root.files-page == 4) || (!root.has-graph && root.files-page == 5));
                badge-count: root.conflict-count;
                clicked => {
                    root.action-triggered(2);
                }
            }

            if id == 3 && root.has-directory && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.folder;
                label: @tr("Directory");
                active: root.active-tab == 2 && root.files-page == 1;
                clicked => {
                    root.action-triggered(3);
                }
            }

            if id == 4 && root.has-daily && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.calendar;
                label: @tr("Daily");
                active: root.active-tab == 2 && root.files-page == 2;
                clicked => {
                    root.action-triggered(4);
                }
            }

            if id == 5 && root.has-starred && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.star;
                label: @tr("Starred");
                active: root.active-tab == 2 && root.files-page == 3;
                clicked => {
                    root.action-triggered(5);
                }
            }

            if id == 6 && root.has-recent && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.clock;
                label: @tr("Recent");
                active: root.active-tab == 2 && root.files-page == 4;
                clicked => {
                    root.action-triggered(6);
                }
            }

            if id == 7 && root.has-graph && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.git-fork;
                label: @tr("Graph");
                active: root.active-tab == 2 && root.files-page == 5;
                clicked => {
                    root.action-triggered(7);
                }
            }

            if id == 8 && root.has-new-note && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.plus;
                label: @tr("New");
                active: false;
                clicked => {
                    root.action-triggered(8);
                }
            }

            if id == 9 && root.has-sync && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.cloud;
                label: @tr("Sync");
                active: false;
                clicked => {
                    root.action-triggered(9);
                }
            }

            if id == 10 && root.has-switch-vault && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.folder;
                label: @tr("Vault");
                active: false;
                clicked => {
                    root.action-triggered(10);
                }
            }

            if id == 11 && root.has-settings && (!root.has-overflow || root.cum-at(pos) <= 4): NavItem {
                icon: TablerIcons.settings;
                label: @tr("Settings");
                active: false;
                clicked => {
                    root.action-triggered(11);
                }
            }
        }

        if root.has-overflow: NavItem {
            icon: TablerIcons.menu-2;
            label: @tr("More");
            active: root.more-active;
            badge-count: root.more-badge-count;
            clicked => {
                root.open-more();
            }
        }
    }
}

export component IconActionRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> tint: Palette.foreground;
    callback clicked();

    height: Metrics.touch;
    border-radius: Metrics.radius-sm + 2px * Metrics.ui-scale;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Metrics.gutter;
        padding-right: Metrics.gutter;
        spacing: Metrics.spacing-md;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                color: root.tint;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
            }
        }

        Text {
            text: root.text;
            color: root.tint;
            font-size: Metrics.font-body + 1px * Metrics.ui-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Icon-only segmented switcher for the note sheet's own views (Body,
// Properties, ...). Unlike `SegmentedControl` (text, full-width,
// Settings-style) this is a compact, self-sized pill group -- a mode
// switch for *the currently open note's* content, not a page-wide
// setting. Sits next to `NavPill` as one group at the body's bottom
// edge (see `EditorScreen`) -- not tied to the Edit/Done FAB's own
// position, so it doesn't go orphaned when the FAB itself disappears
// (Properties view has nothing to edit). Sizing mirrors
// `BubbleButton`'s bubble-in-a-touch-target recipe: each segment's
// visible pill is a square the track's own height, which is
// Metrics.bubble-button-size -- the same visual size as the header's
// own BubbleButtons, matched on request after an earlier pass first
// tried a full Metrics.touch cell and found it inconsistent.
export component ViewSwitcher inherits Rectangle {
    in property <[image]> icons;
    in property <int> selected: 0;
    callback changed(int);

    // Each cell is Metrics.bubble-button-size, with Metrics.spacing-xs
    // as the track's margin on every side -- equal padding top/bottom
    // and left/right, unlike a first pass at this that only padded
    // left/right.
    height: Metrics.bubble-button-size + 2 * Metrics.spacing-xs;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Colors.surface-elevated;
    drop-shadow-blur: 8px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    row := HorizontalLayout {
        padding: Metrics.spacing-xs;
        spacing: Metrics.spacing-xs;

        for icon[i] in root.icons: Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: i == root.selected ? Palette.accent-background.with-alpha(0.18) : transparent;
            animate background {
                duration: 150ms;
                easing: ease-out;
            }

            Icon {
                source: icon;
                color: i == root.selected ? Palette.accent-background : Colors.muted;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                animate color {
                    duration: 120ms;
                    easing: ease-out;
                }
            }

            TouchArea {
                clicked => { root.changed(i); }
            }
        }
    }
}

// Back/forward through the note history (session.rs's
// BackForwardStack), grouped with ViewSwitcher as one pair at the
// note sheet body's bottom edge (see `EditorScreen`) -- deliberately
// drawn with directional chevrons (not mode-selection icons) so the
// pill's own shape signals "this is the swipeable one", distinct from
// ViewSwitcher's Body/Properties toggle. Swiping the body itself to
// navigate isn't wired up yet (still just this pill, tap-only); the
// chevrons already read as "this direction, swipe or tap" either way,
// so that can follow later without changing what this communicates.
// Unlike the mini card's own reveal chevrons (which hide entirely when
// a direction has nowhere to go), both sides always render here --
// dimmed and untappable instead -- since this is a persistent, always-
// visible control rather than something revealed mid-gesture: hiding
// a side here would look like the pill itself is broken/missing a
// piece, not like "nothing to do that way".
export component NavPill inherits Rectangle {
    in property <bool> can-back: false;
    in property <bool> can-forward: false;
    callback back();
    callback forward();

    height: Metrics.bubble-button-size + 2 * Metrics.spacing-xs;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: Colors.surface-elevated;
    drop-shadow-blur: 8px * Metrics.ui-scale;
    drop-shadow-offset-y: 2px * Metrics.ui-scale;
    drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000a0 : #00000024;

    row := HorizontalLayout {
        padding: Metrics.spacing-xs;
        spacing: Metrics.spacing-xs;

        Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: root.can-back && back-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Icon {
                source: TablerIcons.chevron-left;
                color: root.can-back ? Colors.muted : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            back-touch := TouchArea {
                enabled: root.can-back;
                clicked => { root.back(); }
            }
        }

        Rectangle {
            width: Metrics.bubble-button-size;
            border-radius: self.height / 2;
            background: root.can-forward && forward-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
            animate background {
                duration: 120ms;
                easing: ease-out;
            }

            Icon {
                source: TablerIcons.chevron-right;
                color: root.can-forward ? Colors.muted : Colors.muted.with-alpha(0.35);
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            forward-touch := TouchArea {
                enabled: root.can-forward;
                clicked => { root.forward(); }
            }
        }
    }
}

// Callout / Speech bubble component floating above target elements.
// Borderless, elevated surface with a pointer tail pointing towards the target.
export component CalloutBubble inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    in property <color> icon-color: root.text-color;
    in property <color> text-color: #ffffff;
    in property <bool> icon-on-right: false;
    in property <bool> tail-on-right: false;
    in property <length> tail-offset-x: 18px * Metrics.ui-scale;
    in property <length> tail-width: 14px * Metrics.ui-scale;
    in property <length> tail-height: 10px * Metrics.ui-scale;
    in property <bool> show-tail: true;
    in property <color> bubble-background: #f59e0b;
    out property <length> preferred-bubble-width: content-layout.preferred-width;

    // Outer container sizing and defaults
    height: 42px * Metrics.ui-scale;
    background: transparent;

    // Main bubble body (floating elevated card without border)
    body := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width > 0px ? parent.width : content-layout.preferred-width;
        height: parent.height - (root.show-tail ? root.tail-height : 0px);
        border-radius: self.height / 2;
        background: root.bubble-background;
        drop-shadow-blur: 10px * Metrics.ui-scale;
        drop-shadow-offset-y: 2px * Metrics.ui-scale;
        drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000aa : #00000024;

        content-layout := HorizontalLayout {
            padding-left: root.icon-on-right ? 14px * Metrics.ui-scale : 12px * Metrics.ui-scale;
            padding-right: root.icon-on-right ? 12px * Metrics.ui-scale : 14px * Metrics.ui-scale;
            spacing: 6px * Metrics.ui-scale;

            if !root.icon-on-right && root.icon.width > 0: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.icon;
                    color: root.icon-color;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                }
            }

            Text {
                text: root.text;
                font-size: Metrics.font-sub;
                font-weight: 600;
                color: root.text-color;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if root.icon-on-right && root.icon.width > 0: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.icon;
                    color: root.icon-color;
                    width: Metrics.icon-sm;
                    height: Metrics.icon-sm;
                }
            }
        }
    }

    // Downward pointer tail pointing to target
    if root.show-tail: Path {
        x: root.tail-on-right
            ? (body.width - root.tail-offset-x - root.tail-width)
            : root.tail-offset-x;
        y: body.height - 1px;
        width: root.tail-width;
        height: root.tail-height;
        viewbox-width: 14;
        viewbox-height: 10;
        commands: "M 0 0 L 14 0 L 7 10 Z";
        fill: root.bubble-background;
    }
}
