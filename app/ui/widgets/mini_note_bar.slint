import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { MiniNoteCard } from "../components.slint";

// Mini note card container (anchored above the bottom nav bar).
// Fixed at resting position so upward swipe gesture coordinates never shift.
// Fades out quickly as sheet progress increases (editor sheet expands over it).
// Encapsulates horizontal back/forward history reveal rubber-banding and
// upward swipe-to-open gesture detection.
export component MiniNoteBar inherits Rectangle {
    in property <string> title: "";
    in property <string> preview: "";
    in property <bool> has-conflict: false;
    in property <bool> syncing: false;
    in property <bool> remote-configured: false;
    in property <string> status: "";
    in property <bool> status-is-error: false;

    in property <bool> can-navigate-back: false;
    in property <bool> can-navigate-forward: false;
    in property <string> history-back-title: "";
    in property <string> history-forward-title: "";

    in property <length> resting-y: 0px;
    in property <float> sheet-progress: 0.0;
    in property <float> fast-swipe-velocity: 0.6;
    in property <bool> gesture-enabled: true;

    callback open-sheet();
    callback sync();
    callback navigate-back();
    callback navigate-forward();
    callback trigger-haptic();

    callback sheet-drag-started();
    callback sheet-drag-moved(float);
    callback sheet-drag-ended(float, bool); // velocity, should_open
    callback sheet-drag-cancelled();

    // Internal gesture & reveal states
    property <duration> mini-drag-start-time: 0ms;
    property <bool> mini-drag-locked: false;
    property <bool> mini-drag-horizontal: false;

    in-out property <length> mini-card-reveal-dx: 0px;
    in-out property <bool> is-dragging-mini-reveal: false;
    property <length> mini-card-reveal-max: Metrics.touch * 1.3;

    animate mini-card-reveal-dx {
        duration: root.is-dragging-mini-reveal ? 0ms : 200ms;
        easing: ease-out;
    }

    pure function rubber-band(dx: length, limit: length) -> length {
        let coefficient = 0.55;
        let ratio = (abs(dx) / limit) * coefficient;
        let eased = limit * (ratio / (1.0 + ratio));
        return dx < 0px ? -eased : eased;
    }

    property <float> mini-card-reveal-threshold: 0.42;
    property <float> mini-reveal-back-progress: root.mini-card-reveal-dx > 0px
        ? clamp((root.mini-card-reveal-dx / root.mini-card-reveal-max) / root.mini-card-reveal-threshold, 0.0, 1.0)
        : 0.0;
    property <float> mini-reveal-forward-progress: root.mini-card-reveal-dx < 0px
        ? clamp((-root.mini-card-reveal-dx / root.mini-card-reveal-max) / root.mini-card-reveal-threshold, 0.0, 1.0)
        : 0.0;
    property <bool> mini-reveal-back-committable: root.can-navigate-back && root.mini-reveal-back-progress >= 1.0;
    property <bool> mini-reveal-forward-committable: root.can-navigate-forward && root.mini-reveal-forward-progress >= 1.0;

    changed mini-reveal-back-committable => {
        if (root.mini-reveal-back-committable) {
            root.trigger-haptic();
        }
    }
    changed mini-reveal-forward-committable => {
        if (root.mini-reveal-forward-committable) {
            root.trigger-haptic();
        }
    }

    property <length> back-bounce-x: root.mini-reveal-back-committable ? 8px * Metrics.ui-scale : 0px;
    property <length> forward-bounce-x: root.mini-reveal-forward-committable ? -8px * Metrics.ui-scale : 0px;

    animate back-bounce-x {
        duration: 240ms;
        easing: cubic-bezier(0.34, 1.8, 0.64, 1.0);
    }
    animate forward-bounce-x {
        duration: 240ms;
        easing: cubic-bezier(0.34, 1.8, 0.64, 1.0);
    }

    property <length> back-pill-size: root.mini-reveal-back-committable
        ? 38px * Metrics.ui-scale
        : (28px * Metrics.ui-scale + 4px * Metrics.ui-scale * root.mini-reveal-back-progress);
    property <length> forward-pill-size: root.mini-reveal-forward-committable
        ? 38px * Metrics.ui-scale
        : (28px * Metrics.ui-scale + 4px * Metrics.ui-scale * root.mini-reveal-forward-progress);

    animate back-pill-size, forward-pill-size {
        duration: 240ms;
        easing: cubic-bezier(0.34, 1.8, 0.64, 1.0);
    }

    property <bool> show-bubble: (root.mini-reveal-back-committable || root.mini-reveal-forward-committable)
        && root.is-dragging-mini-reveal;
    property <string> bubble-title: root.mini-reveal-back-committable
        ? (root.history-back-title != "" ? root.history-back-title : @tr("Previous Note"))
        : (root.history-forward-title != "" ? root.history-forward-title : @tr("Next Note"));
    property <bool> is-back-direction: root.mini-card-reveal-dx >= 0px;
    property <image> bubble-icon: root.mini-reveal-back-committable
        ? TablerIcons.chevron-left
        : TablerIcons.chevron-right;

    SwipeGestureHandler {
        width: 100%;
        height: 100%;
        enabled: root.gesture-enabled;
        handle-swipe-up: true;
        handle-swipe-right: true;
        handle-swipe-left: true;

        changed pressed-position => {
            root.mini-drag-start-time = animation-tick();
            root.mini-drag-locked = false;
        }

        moved => {
            if (self.swiping) {
                let dx = self.current-position.x - self.pressed-position.x;
                let dy = self.current-position.y - self.pressed-position.y;
                if (!root.mini-drag-locked) {
                    root.mini-drag-locked = true;
                    root.mini-drag-horizontal = abs(dx) > abs(dy);
                }
                if (root.mini-drag-horizontal) {
                    root.is-dragging-mini-reveal = true;
                    root.mini-card-reveal-dx = root.rubber-band(dx, root.mini-card-reveal-max);
                } else {
                    root.sheet-drag-started();
                    let upward = max(0px, -dy);
                    let travel = max(100px, root.resting-y);
                    root.sheet-drag-moved(clamp(upward / travel, 0.0, 1.0));
                }
            }
        }

        swiped => {
            if (root.mini-drag-horizontal) {
                let dx = self.current-position.x - self.pressed-position.x;
                let elapsed-ms = max(1.0, (animation-tick() - root.mini-drag-start-time) / 1ms);
                let velocity = (dx / 1px) / elapsed-ms;
                let fast = abs(velocity) > root.fast-swipe-velocity * Metrics.ui-scale;
                if (dx > 0 && root.can-navigate-back && (root.mini-reveal-back-committable || fast)) {
                    root.trigger-haptic();
                    root.navigate-back();
                } else if (dx < 0 && root.can-navigate-forward && (root.mini-reveal-forward-committable || fast)) {
                    root.trigger-haptic();
                    root.navigate-forward();
                }
                root.is-dragging-mini-reveal = false;
                root.mini-card-reveal-dx = 0px;
            } else {
                let dy = self.current-position.y - self.pressed-position.y;
                let elapsed-ms = max(1.0, (animation-tick() - root.mini-drag-start-time) / 1ms);
                let velocity = (-dy / 1px) / elapsed-ms;
                let should-open = velocity > root.fast-swipe-velocity * Metrics.ui-scale;
                root.sheet-drag-ended(velocity, should-open);
            }
        }

        cancelled => {
            if (root.mini-drag-horizontal) {
                root.is-dragging-mini-reveal = false;
                root.mini-card-reveal-dx = 0px;
            } else {
                root.sheet-drag-cancelled();
            }
        }

        MiniNoteCard {
            x: 12px * Metrics.ui-scale + root.mini-card-reveal-dx;
            width: parent.width - 24px * Metrics.ui-scale;
            height: Metrics.mini-card-height;
            y: 20px * Metrics.ui-scale - root.sheet-progress * root.resting-y;
            opacity: max(0.0, 1.0 - root.sheet-progress * 10.0);
            title: root.title;
            preview: root.preview;
            has-conflict: root.has-conflict;
            syncing: root.syncing;
            remote-configured: root.remote-configured;
            status: root.status;
            status-is-error: root.status-is-error;
            clicked => { root.open-sheet(); }
            sync => { root.sync(); }
        }

        // History back affordance (pinned close to the left edge with bounce physics)
        VerticalLayout {
            x: 4px * Metrics.ui-scale + root.back-bounce-x;
            y: 20px * Metrics.ui-scale;
            width: 44px * Metrics.ui-scale;
            height: Metrics.mini-card-height;
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: root.back-pill-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.can-navigate-back
                        ? (root.mini-reveal-back-committable
                            ? Palette.accent-background.with-alpha(0.24)
                            : Palette.accent-background.with-alpha(0.14 * root.mini-reveal-back-progress))
                        : transparent;

                    if root.can-navigate-back: Icon {
                        source: TablerIcons.chevron-left;
                        color: Palette.accent-background;
                        width: root.mini-reveal-back-committable
                            ? Metrics.icon-md * 1.35 : Metrics.icon-md;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        opacity: root.mini-reveal-back-progress;
                        animate width, height {
                            duration: 240ms;
                            easing: cubic-bezier(0.34, 1.8, 0.64, 1.0);
                        }
                    }
                }
            }
        }

        // History forward affordance (pinned close to the right edge with bounce physics)
        VerticalLayout {
            x: parent.width - 48px * Metrics.ui-scale + root.forward-bounce-x;
            y: 20px * Metrics.ui-scale;
            width: 44px * Metrics.ui-scale;
            height: Metrics.mini-card-height;
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: root.forward-pill-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.can-navigate-forward
                        ? (root.mini-reveal-forward-committable
                            ? Palette.accent-background.with-alpha(0.24)
                            : Palette.accent-background.with-alpha(0.14 * root.mini-reveal-forward-progress))
                        : transparent;

                    if root.can-navigate-forward: Icon {
                        source: TablerIcons.chevron-right;
                        color: Palette.accent-background;
                        width: root.mini-reveal-forward-committable
                            ? Metrics.icon-md * 1.35 : Metrics.icon-md;
                        height: self.width;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        opacity: root.mini-reveal-forward-progress;
                        animate width, height {
                            duration: 240ms;
                            easing: cubic-bezier(0.34, 1.8, 0.64, 1.0);
                        }
                    }
                }
            }
        }

        // History target note bubble (speech bubble floating above the mini card when triggered)
        history-bubble := Rectangle {
            x: root.is-back-direction
                ? (16px * Metrics.ui-scale + max(0px, root.mini-card-reveal-dx * 0.12))
                : (parent.width - self.width - 16px * Metrics.ui-scale + min(0px, root.mini-card-reveal-dx * 0.12));
            y: root.show-bubble ? (-16px * Metrics.ui-scale) : (8px * Metrics.ui-scale);
            height: 32px * Metrics.ui-scale;
            width: min(bubble-layout.preferred-width + 24px * Metrics.ui-scale, parent.width - 32px * Metrics.ui-scale);
            border-radius: self.height / 2;
            background: Colors.surface-elevated;
            border-width: 1.5px;
            border-color: Palette.accent-background.with-alpha(0.35);
            drop-shadow-blur: 10px * Metrics.ui-scale;
            drop-shadow-offset-y: 2px * Metrics.ui-scale;
            drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? #000000aa : #00000024;
            opacity: root.show-bubble ? 1.0 : 0.0;
            clip: true;

            animate y, opacity {
                duration: 200ms;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1.0);
            }

            bubble-layout := HorizontalLayout {
                padding-left: 10px * Metrics.ui-scale;
                padding-right: 12px * Metrics.ui-scale;
                spacing: 6px * Metrics.ui-scale;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: root.bubble-icon;
                        color: Palette.accent-background;
                        width: Metrics.icon-sm;
                        height: Metrics.icon-sm;
                    }
                }

                Text {
                    text: root.bubble-title;
                    font-size: Metrics.font-sub;
                    font-weight: 600;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
