import { Palette, LineEdit, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import {
    IconButton,
    TopBar,
    ActionRow,
    AppScrollView,
    SegmentedControl,
    Card,
    Section,
    Divider,
} from "@origiri-mobile/widgets.slint";
import { SheetDragArea } from "../components.slint";

// A tappable row for the Settings list: icon, label, and a trailing
// chevron to show it drills into its own sub-page.
component CategoryRow inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    callback clicked();

    height: Metrics.touch + 8px * Metrics.ui-scale;
    border-radius: Metrics.radius-sm + 2px * Metrics.ui-scale;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: Metrics.spacing-md;
        padding-right: Metrics.spacing-md;
        spacing: Metrics.spacing-md;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                color: Palette.accent-background;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label-text;
            font-size: Metrics.font-body;
            vertical-alignment: center;
            color: Palette.foreground;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: TablerIcons.chevron-right;
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                color: Colors.muted;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A toggle row for selecting which transfer items to include in export.
component TransferToggleRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    in property <bool> is-warning: false;
    callback toggled(bool);

    min-height: Metrics.touch;
    border-radius: Metrics.radius-sm;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: Metrics.spacing-sm;
        padding-right: Metrics.spacing-sm;
        spacing: Metrics.spacing-md;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Palette.accent-background;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: Metrics.font-body;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Palette.foreground;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Metrics.font-sm;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: root.checked ? Palette.accent-background : Colors.muted;
                background: root.checked ? Palette.accent-background : transparent;
                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                if root.checked: Icon {
                    source: TablerIcons.check;
                    width: 16px;
                    height: 16px;
                    color: Palette.accent-foreground;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A full-screen sheet for application settings: a grouped list of rows
// (Interface; Other -- Sync & Remote, Vaults, Transfer & Share; Info -- About), each
// drilling into its own sub-page -- the common "grouped list -> detail"
// settings shape, chosen so new settings have an obvious home instead of
// piling onto one long flat page.
export component SettingsSheet inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();

    // Remote sync properties
    in property <bool> has-token;
    in-out property <string> url-draft;
    in-out property <string> token-draft;
    in property <bool> syncing: false;
    in property <string> sync-status: "";

    // Vault properties
    in property <string> current-vault-name: "";
    in property <string> current-vault-path: "";

    // Appearance properties
    // 0: Small (14px), 1: Medium (17px), 2: Large (20px)
    in-out property <int> font-size-choice: 1;
    // 0: System, 1: Light, 2: Dark
    in-out property <int> theme-choice: 0;
    // 0: show (default), 1: hide while editing a note, 2: always hide
    in-out property <int> status-bar-choice: 0;

    // App info
    in property <string> app-version: "0.1.0";
    in property <bool> show-back: true;

    // Transfer & Share properties
    in property <image> qr-image;
    in-out property <bool> export-include-interface: true;
    in-out property <bool> export-include-remote: true;
    in-out property <bool> export-include-token: false;
    in property <bool> transfer-copied: false;
    in-out property <string> import-draft: "";
    in property <bool> import-preview-ready: false;
    in property <bool> preview-has-interface: false;
    in property <bool> preview-has-remote: false;
    in property <string> preview-remote-url: "";
    in property <bool> preview-has-token: false;
    in property <string> import-status-message: "";
    in property <bool> import-status-is-error: false;
    in-out property <int> transfer-tab: 0;

    callback close();
    callback save-remote(string, string);
    callback sync();
    callback open-vaults();
    callback status-bar-changed(int);
    callback font-size-changed(int);
    callback theme-changed(int);
    callback refresh-transfer-qr();
    callback export-options-changed(bool, bool, bool);
    callback copy-transfer-link();
    callback paste-import-clipboard();
    callback review-import(string);
    callback apply-import();
    callback cancel-import-preview();

    // Cloud Provider Sync properties
    in property <bool> github-connected: false;
    in property <string> github-username: "";
    in property <string> github-repo-name: "";
    in property <bool> github-auth-pending: false;
    in property <string> github-user-code: "";
    in property <string> github-verification-uri: "";
    in property <string> github-auth-status: "";

    in property <bool> forgejo-connected: false;
    in property <string> forgejo-username: "";
    in property <string> forgejo-instance: "";
    in property <string> forgejo-repo-name: "";
    in property <bool> forgejo-connecting: false;
    in property <string> forgejo-status-message: "";
    in property <bool> forgejo-status-is-error: false;

    in property <bool> gitlab-connected: false;
    in property <string> gitlab-username: "";
    in property <string> gitlab-instance: "";
    in property <string> gitlab-repo-name: "";
    in property <bool> gitlab-connecting: false;
    in property <string> gitlab-status-message: "";
    in property <bool> gitlab-status-is-error: false;

    in-out property <int> sync-provider-tab: 0; // 0: GitHub, 1: Forgejo / Gitea, 2: GitLab
    in-out property <string> forgejo-instance-draft: "https://codeberg.org";
    in-out property <string> forgejo-token-draft: "";
    in-out property <string> forgejo-repo-draft: "immermemo-notes";

    in-out property <string> gitlab-instance-draft: "https://gitlab.com";
    in-out property <string> gitlab-token-draft: "";
    in-out property <string> gitlab-repo-draft: "immermemo-notes";

    in-out property <bool> show-advanced-remote: false;

    callback connect-github();
    callback open-github-browser();
    callback cancel-github-auth();
    callback disconnect-github();

    callback connect-forgejo(string, string, string);
    callback disconnect-forgejo();

    callback connect-gitlab(string, string, string);
    callback disconnect-gitlab();

    in property <bool> ssh-key-present: false;
    in property <string> ssh-public-key: "";
    in property <bool> ssh-key-copied: false;

    callback generate-ssh-key();
    callback copy-ssh-public-key();


    // 0: list, 1: Interface, 2: Sync & Remote, 3: Vaults, 4: About, 5: Transfer & Share.
    // in-out so the app-level Back action (hardware button / edge-swipe
    // gesture) can pop a sub-page back to the list -- see app.slint's
    // handle-back().
    in-out property <int> page: 0;

    property <length> scroll-content-y: 0px;
    property <bool> scroll-at-top: root.scroll-content-y >= -1px;

    background: Colors.page-background;


    header-gesture := SheetDragArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        inset-top: root.inset-top;
        enabled: root.page == 0;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        TopBar {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;
            inset-top: root.inset-top;
            bar-background: transparent;

            if root.page != 0: IconButton {
                icon: TablerIcons.chevron-left;
                clicked => { root.page = 0; }
            }
            if root.page == 0 && root.show-back: IconButton {
                icon: TablerIcons.chevron-down;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.page == 1 ? @tr("Interface")
                    : root.page == 2 ? @tr("Sync & Remote")
                    : root.page == 3 ? @tr("Vaults")
                    : root.page == 4 ? @tr("About")
                    : root.page == 5 ? @tr("Transfer & Share")
                    : @tr("Settings");
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                color: Palette.foreground;
            }

        }
    }

    body-gesture := SheetDragArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        enabled: root.scroll-at-top && root.page == 0;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        VerticalLayout {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            AppScrollView {
                vertical-stretch: 1;
                content-y <=> root.scroll-content-y;

                // --------------------------------------------------------
            // List: Interface / Other (Sync & Remote, Vaults) / Info (About)
            // --------------------------------------------------------
            if root.page == 0: VerticalLayout {
                // Without this, a VerticalLayout shorter than its Flickable
                // dumps all the leftover space onto one section instead of
                // leaving it below the content -- see home.slint's content
                // VerticalLayout for the full explanation.
                alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 24px;

                    Card {
                        content-padding: Metrics.spacing-xs;
                        content-spacing: 0px;

                        CategoryRow {
                            icon: TablerIcons.settings;
                            label-text: @tr("Interface");
                            clicked => { root.page = 1; }
                        }
                    }

                    Section {
                        title: @tr("Other");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.cloud;
                                label-text: @tr("Sync & Remote");
                                clicked => { root.page = 2; }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.files;
                                label-text: @tr("Vaults");
                                clicked => { root.page = 3; }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.qrcode;
                                label-text: @tr("Transfer & Share");
                                clicked => {
                                    root.page = 5;
                                    root.refresh-transfer-qr();
                                }
                            }

                        }
                    }

                    Section {
                        title: @tr("Info");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.info-circle;
                                label-text: @tr("About");
                                clicked => { root.page = 4; }
                            }
                        }
                    }
                }

                // --------------------------------------------------------
            // Interface (theme, font size, UI scale)
            // --------------------------------------------------------
            if root.page == 1: VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;

                    Card {
                        content-spacing: Metrics.spacing-lg;

                        // Theme Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Theme");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                selected: root.theme-choice;
                                changed(i) => {
                                    root.theme-choice = i;
                                    root.theme-changed(i);
                                }
                            }
                        }

                        Divider { }

                        // Font Size Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Editor Font Size");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: [@tr("Small (14)"), @tr("Medium (17)"), @tr("Large (20)")];
                                selected: root.font-size-choice;
                                changed(i) => {
                                    root.font-size-choice = i;
                                    root.font-size-changed(i);
                                }
                            }
                        }

                        Divider { }

                        // UI Scale Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("UI Scale");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: ["90%", "100%", "110%", "125%"];
                                selected: Metrics.ui-scale < 0.95 ? 0 : (Metrics.ui-scale <= 1.05 ? 1 : (Metrics.ui-scale <= 1.18 ? 2 : 3));
                                changed(i) => {
                                    Metrics.ui-scale = [0.9, 1.0, 1.1, 1.25][i];
                                }
                            }
                        }

                        Divider { }

                        // Status Bar Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Status Bar");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Hide it while editing a note (for a less distracting full-screen view), or everywhere in the app.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            SegmentedControl {
                                options: [@tr("Show"), @tr("Hide While Editing"), @tr("Always Hide")];
                                selected: root.status-bar-choice;
                                changed(i) => {
                                    root.status-bar-choice = i;
                                    root.status-bar-changed(i);
                                }
                            }
                        }
                    }
                }

                // --------------------------------------------------------
            // Sync & Remote
            // --------------------------------------------------------
            if root.page == 2: VerticalLayout {
                alignment: start;
                padding-left: Metrics.gutter;
                padding-right: Metrics.gutter;
                padding-top: 16px;
                padding-bottom: root.inset-bottom + 24px;
                spacing: 16px;

                // Card 1: Cloud Account Sync (Primary)
                Card {
                    content-spacing: Metrics.spacing-md;

                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: root.gitlab-connected ? TablerIcons.brand-gitlab : (root.forgejo-connected ? TablerIcons.brand-git : TablerIcons.brand-github);
                                width: Metrics.icon-lg;
                                height: Metrics.icon-lg;
                                color: Palette.accent-background;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.gitlab-connected ? @tr("GitLab Sync") : (root.forgejo-connected ? @tr("Forgejo / Gitea Sync") : (root.github-connected ? @tr("GitHub Sync") : @tr("Cloud Git Sync")));
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }
                            Text {
                                text: @tr("Automatic multi-device synchronization and backup.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Divider { }

                    // State A: GitHub Connected
                    if root.github-connected: VerticalLayout {
                        spacing: Metrics.spacing-sm;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.check;
                                    width: 16px;
                                    height: 16px;
                                    color: Palette.color-scheme == ColorScheme.dark ? #55dd88 : #119944;
                                }
                            }
                            Text {
                                text: @tr("Connected as @{} on GitHub", root.github-username);
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        if root.github-repo-name != "": Text {
                            text: @tr("Repository: {} (Private)", root.github-repo-name);
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        if root.sync-status != "": Text {
                            text: root.sync-status;
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: @tr("Disconnect");
                                clicked => { root.disconnect-github(); }
                            }
                            Button {
                                text: root.syncing ? @tr("Syncing...") : @tr("Sync Now");
                                primary: true;
                                enabled: !root.syncing;
                                clicked => { root.sync(); }
                            }
                        }
                    }

                    // State B: Forgejo Connected
                    if root.forgejo-connected: VerticalLayout {
                        spacing: Metrics.spacing-sm;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.check;
                                    width: 16px;
                                    height: 16px;
                                    color: Palette.color-scheme == ColorScheme.dark ? #55dd88 : #119944;
                                }
                            }
                            Text {
                                text: @tr("Connected as @{} on {}", root.forgejo-username, root.forgejo-instance);
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        if root.forgejo-repo-name != "": Text {
                            text: @tr("Repository: {} (Private)", root.forgejo-repo-name);
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        if root.sync-status != "": Text {
                            text: root.sync-status;
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: @tr("Disconnect");
                                clicked => { root.disconnect-forgejo(); }
                            }
                            Button {
                                text: root.syncing ? @tr("Syncing...") : @tr("Sync Now");
                                primary: true;
                                enabled: !root.syncing;
                                clicked => { root.sync(); }
                            }
                        }
                    }

                    // State B2: GitLab Connected
                    if root.gitlab-connected: VerticalLayout {
                        spacing: Metrics.spacing-sm;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.check;
                                    width: 16px;
                                    height: 16px;
                                    color: Palette.color-scheme == ColorScheme.dark ? #55dd88 : #119944;
                                }
                            }
                            Text {
                                text: @tr("Connected as @{} on {}", root.gitlab-username, root.gitlab-instance);
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                        }

                        if root.gitlab-repo-name != "": Text {
                            text: @tr("Repository: {} (Private)", root.gitlab-repo-name);
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: @tr("Disconnect");
                                clicked => { root.disconnect-gitlab(); }
                            }
                            Button {
                                text: root.syncing ? @tr("Syncing...") : @tr("Sync Now");
                                primary: true;
                                enabled: !root.syncing;
                                clicked => { root.sync(); }
                            }
                        }
                    }

                    // State C: Not Connected (Provider Selection)
                    if !root.github-connected && !root.forgejo-connected && !root.gitlab-connected: VerticalLayout {
                        spacing: Metrics.spacing-md;

                        SegmentedControl {
                            options: [@tr("GitHub"), @tr("Forgejo / Gitea"), @tr("GitLab")];
                            selected: root.sync-provider-tab;
                            changed(i) => { root.sync-provider-tab = i; }
                        }

                        // Tab 0: GitHub
                        if root.sync-provider-tab == 0: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            if !root.github-auth-pending: VerticalLayout {
                                spacing: Metrics.spacing-md;
                                Text {
                                    text: @tr("Sign in to automatically create and sync a private notes repository.");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    Button {
                                        text: @tr("Connect with GitHub");
                                        primary: true;
                                        clicked => { root.connect-github(); }
                                    }
                                }
                            }

                            if root.github-auth-pending: VerticalLayout {
                                spacing: Metrics.spacing-md;
                                Text {
                                    text: @tr("Confirm this one-time code on GitHub:");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 52px;
                                    border-radius: Metrics.radius-md;
                                    background: Palette.foreground.with-alpha(0.06);

                                    Text {
                                        text: root.github-user-code;
                                        font-size: 22px;
                                        font-weight: 700;
                                        color: Palette.accent-background;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.github-auth-status != "" ? root.github-auth-status : @tr("Waiting for browser authorization...");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    Button {
                                        text: @tr("Cancel");
                                        clicked => { root.cancel-github-auth(); }
                                    }
                                    Button {
                                        text: @tr("Open in Browser");
                                        primary: true;
                                        clicked => { root.open-github-browser(); }
                                    }
                                }
                            }
                        }

                        // Tab 1: Forgejo / Gitea
                        if root.sync-provider-tab == 1: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Connect Codeberg or your self-hosted Forgejo/Gitea instance using a Personal Access Token.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("Instance URL");
                                    font-size: 13px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: "https://codeberg.org";
                                    text <=> root.forgejo-instance-draft;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("Personal Access Token");
                                    font-size: 13px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: @tr("Token with repo and user permissions");
                                    text <=> root.forgejo-token-draft;
                                    input-type: password;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("Repository Name");
                                    font-size: 13px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: "immermemo-notes";
                                    text <=> root.forgejo-repo-draft;
                                }
                            }

                            if root.forgejo-status-message != "": Text {
                                text: root.forgejo-status-message;
                                color: root.forgejo-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: root.forgejo-connecting ? @tr("Connecting...") : @tr("Connect Account");
                                    primary: true;
                                    enabled: !root.forgejo-connecting && root.forgejo-token-draft != "";
                                    clicked => {
                                        root.connect-forgejo(
                                            root.forgejo-instance-draft,
                                            root.forgejo-token-draft,
                                            root.forgejo-repo-draft,
                                        );
                                    }
                                }
                            }
                        }

                        // Tab 2: GitLab
                        if root.sync-provider-tab == 2: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Connect to GitLab.com or a self-hosted instance using a Personal Access Token with api scope.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("GitLab Instance URL");
                                    font-size: 12px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: "https://gitlab.com";
                                    text <=> root.gitlab-instance-draft;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("Personal Access Token (api scope)");
                                    font-size: 12px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: @tr("Token with api permission");
                                    text <=> root.gitlab-token-draft;
                                    input-type: password;
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: @tr("Repository Name");
                                    font-size: 12px;
                                    color: Colors.muted;
                                }
                                LineEdit {
                                    height: Metrics.touch;
                                    placeholder-text: "immermemo-notes";
                                    text <=> root.gitlab-repo-draft;
                                }
                            }

                            if root.gitlab-status-message != "": Text {
                                text: root.gitlab-status-message;
                                color: root.gitlab-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: root.gitlab-connecting ? @tr("Connecting...") : @tr("Connect Account");
                                    primary: true;
                                    enabled: !root.gitlab-connecting && root.gitlab-token-draft != "";
                                    clicked => {
                                        root.connect-gitlab(
                                            root.gitlab-instance-draft,
                                            root.gitlab-token-draft,
                                            root.gitlab-repo-draft,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }

                // Card 2: Custom Git Remote (Self-hosted / Advanced)
                Card {
                    content-spacing: Metrics.spacing-md;

                    ActionRow {
                        text: root.show-advanced-remote ? @tr("Hide Custom Git Remote ▲") : @tr("Custom Git Remote (Self-hosted) ▼");
                        tint: Colors.muted;
                        clicked => { root.show-advanced-remote = !root.show-advanced-remote; }
                    }

                    if root.show-advanced-remote: VerticalLayout {
                        spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: @tr("Remote repository URL");
                                font-size: 13px;
                                color: Colors.muted;
                            }

                            LineEdit {
                                height: Metrics.touch;
                                placeholder-text: @tr("https://github.com/you/notes.git");
                                text <=> root.url-draft;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: @tr("Access token");
                                font-size: 13px;
                                color: Colors.muted;
                            }

                            LineEdit {
                                height: Metrics.touch;
                                placeholder-text: root.has-token ? @tr("Leave blank to keep the saved token") : @tr("Personal access token");
                                input-type: password;
                                text <=> root.token-draft;
                            }
                        }

                        if root.sync-status != "": Text {
                            text: root.sync-status;
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Button {
                                text: root.syncing ? @tr("Syncing...") : @tr("Sync Now");
                                enabled: !root.syncing;
                                clicked => { root.sync(); }
                            }

                            Button {
                                text: @tr("Save Remote");
                                primary: true;
                                clicked => { root.save-remote(root.url-draft, root.token-draft); }
                            }
                        }
                    }
                }

                // Card 3: In-App SSH Key
                Card {
                    content-spacing: Metrics.spacing-md;

                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: TablerIcons.key;
                                width: Metrics.icon-lg;
                                height: Metrics.icon-lg;
                                color: Palette.accent-background;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: @tr("In-App SSH Key");
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }
                            Text {
                                text: @tr("Enables Git over SSH synchronization on mobile and desktop without external agents.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Divider { }

                    if root.ssh-key-present: VerticalLayout {
                        spacing: Metrics.spacing-md;

                        Text {
                            text: @tr("Copy this public key and add it to your GitHub, GitLab, or Forgejo SSH Keys:");
                            font-size: Metrics.font-sm;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            min-height: 48px;
                            border-radius: Metrics.radius-md;
                            background: Palette.foreground.with-alpha(0.06);
                            border-width: 1px;
                            border-color: Palette.foreground.with-alpha(0.12);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.ssh-public-key;
                                    font-size: 11px;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Button {
                                text: @tr("Regenerate Key");
                                clicked => { root.generate-ssh-key(); }
                            }

                            Button {
                                text: root.ssh-key-copied ? @tr("Copied!") : @tr("Copy Public Key");
                                primary: true;
                                clicked => { root.copy-ssh-public-key(); }
                            }
                        }
                    }

                    if !root.ssh-key-present: VerticalLayout {
                        spacing: Metrics.spacing-md;

                        Text {
                            text: @tr("Generate a secure Ed25519 SSH keypair directly inside the app to sync with SSH remotes (git@...).");
                            font-size: Metrics.font-sm;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                text: @tr("Generate SSH Key");
                                primary: true;
                                clicked => { root.generate-ssh-key(); }
                            }
                        }
                    }
                }
            }


                // --------------------------------------------------------
            // Vaults
            // --------------------------------------------------------
            if root.page == 3: VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;

                    Card {
                        content-spacing: Metrics.spacing-sm;

                        HorizontalLayout {
                            Text {
                                text: @tr("Active Vault");
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: root.current-vault-name != "" ? root.current-vault-name : @tr("Default");
                                font-size: 15px;
                                color: Palette.accent-background;
                                vertical-alignment: center;
                            }
                        }

                        if root.current-vault-path != "": Text {
                            text: root.current-vault-path;
                            font-size: 12px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Divider { }

                        ActionRow {
                            text: @tr("Manage & Switch Vaults →");
                            tint: Palette.accent-background;
                            clicked => { root.open-vaults(); }
                        }
                    }
                }

                // --------------------------------------------------------
            // About
            // --------------------------------------------------------
            if root.page == 4: VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;

                    Card {
                        content-spacing: Metrics.spacing-sm;

                        Text {
                            text: @tr("Immermemo v{}", root.app-version);
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: @tr("A mobile note app for writing Tomet (.tmt) notes, synced over git without git touching user files.");
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        Text {
                            text: @tr("AST-level three-way merge with conflict tracking (@conflict).");
                            font-size: 12px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }
                    }
                }

                // --------------------------------------------------------
                // Transfer & Share
                // --------------------------------------------------------
                if root.page == 5: VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    SegmentedControl {
                        options: [@tr("Export (Show QR)"), @tr("Import")];
                        selected: root.transfer-tab;
                        changed(i) => {
                            root.transfer-tab = i;
                            if (i == 0) {
                                root.refresh-transfer-qr();
                            }
                        }
                    }

                    if root.transfer-tab == 0: VerticalLayout {
                        spacing: 16px;

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Select items to include:");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            TransferToggleRow {
                                icon: TablerIcons.settings;
                                title: @tr("Appearance & UI");
                                subtitle: @tr("Theme, font size, and UI scale");
                                checked: root.export-include-interface;
                                toggled(c) => {
                                    root.export-include-interface = c;
                                    root.export-options-changed(root.export-include-interface, root.export-include-remote, root.export-include-token);
                                }
                            }

                            Divider { }

                            TransferToggleRow {
                                icon: TablerIcons.cloud;
                                title: @tr("Remote Sync URL");
                                subtitle: @tr("Active vault remote git repository URL");
                                checked: root.export-include-remote;
                                toggled(c) => {
                                    root.export-include-remote = c;
                                    root.export-options-changed(root.export-include-interface, root.export-include-remote, root.export-include-token);
                                }
                            }

                            Divider { }

                            TransferToggleRow {
                                icon: TablerIcons.lock-share;
                                title: @tr("Include Access Token");
                                subtitle: @tr("⚠️ Contains sensitive personal credentials");
                                checked: root.export-include-token;
                                is-warning: true;
                                toggled(c) => {
                                    root.export-include-token = c;
                                    root.export-options-changed(root.export-include-interface, root.export-include-remote, root.export-include-token);
                                }
                            }
                        }

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Scan with another device:");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 220px;
                                    height: 220px;
                                    border-radius: Metrics.radius-md;
                                    background: white;
                                    clip: true;

                                    Image {
                                        width: 200px;
                                        height: 200px;
                                        source: root.qr-image;
                                        image-fit: contain;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: root.transfer-copied ? @tr("Copied to Clipboard!") : @tr("Copy Transfer Link");
                                    clicked => { root.copy-transfer-link(); }
                                }
                            }
                        }
                    }

                    if root.transfer-tab == 1: VerticalLayout {
                        spacing: 16px;

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Import Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Paste an immermemo:// transfer link or payload below:");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            LineEdit {
                                height: Metrics.touch;
                                placeholder-text: @tr("immermemo://import#... or JSON");
                                text <=> root.import-draft;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: @tr("Paste Clipboard");
                                    clicked => { root.paste-import-clipboard(); }
                                }

                                Button {
                                    text: @tr("Review & Apply");
                                    primary: true;
                                    enabled: root.import-draft != "";
                                    clicked => { root.review-import(root.import-draft); }
                                }
                            }

                            if root.import-status-message != "": Text {
                                text: root.import-status-message;
                                font-size: 13px;
                                color: root.import-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                wrap: word-wrap;
                            }
                        }

                        if root.import-preview-ready: Card {
                            content-spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Settings Ready to Import");
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Divider { }

                            if root.preview-has-interface: ActionRow {
                                text: @tr("✓ Appearance & UI settings");
                            }

                            if root.preview-has-remote: ActionRow {
                                text: @tr("✓ Remote URL: ") + root.preview-remote-url;
                            }

                            if root.preview-has-token: ActionRow {
                                text: @tr("⚠️ Access Token (will update saved token)");
                                tint: Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500;
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: @tr("Cancel");
                                    clicked => { root.cancel-import-preview(); }
                                }

                                Button {
                                    text: @tr("Apply Settings");
                                    primary: true;
                                    clicked => { root.apply-import(); }
                                }
                            }
                        }
                    }
                }

            }
        }
    }
}
