import { SettingsAdapter, AccountData, VaultData } from "../adapters/settings.slint";
import { Palette, LineEdit, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import {
    IconButton,
    TopBar,
    ActionRow,
    AppScrollView,
    SegmentedControl,
    Card,
    Section,
    Divider,
} from "@origiri-mobile/widgets.slint";
import { SheetDragArea } from "../components.slint";

// A tappable row for the Settings list: icon, label, and a trailing
// chevron to show it drills into its own sub-page.
component CategoryRow inherits Rectangle {
    in property <image> icon;
    in property <string> label-text;
    callback clicked();

    height: Metrics.touch + 8px * Metrics.ui-scale;
    border-radius: Metrics.radius-sm + 2px * Metrics.ui-scale;
    background: touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: Metrics.spacing-md;
        padding-right: Metrics.spacing-md;
        spacing: Metrics.spacing-md;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                color: Palette.accent-background;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label-text;
            font-size: Metrics.font-body;
            vertical-alignment: center;
            color: Palette.foreground;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: TablerIcons.chevron-right;
                width: Metrics.icon-sm;
                height: Metrics.icon-sm;
                color: Colors.muted;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A toggle row for selecting which transfer items to include in export.
component TransferToggleRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle: "";
    in-out property <bool> checked: false;
    in property <bool> is-warning: false;
    callback toggled(bool);

    min-height: Metrics.touch;
    border-radius: Metrics.radius-sm;
    background: touch.pressed ? Palette.foreground.with-alpha(0.06) : transparent;
    animate background {
        duration: 150ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: Metrics.spacing-sm;
        padding-right: Metrics.spacing-sm;
        spacing: Metrics.spacing-md;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: Metrics.icon-md;
                height: Metrics.icon-md;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Palette.accent-background;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: Metrics.font-body;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Palette.foreground;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Metrics.font-sm;
                color: root.is-warning ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                border-width: 1.5px;
                border-color: root.checked ? Palette.accent-background : Colors.muted;
                background: root.checked ? Palette.accent-background : transparent;
                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                if root.checked: Icon {
                    source: TablerIcons.check;
                    width: 16px;
                    height: 16px;
                    color: Palette.accent-foreground;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A row for configuring bottom navigation bar items:
// - Left: isolated drag handle area & icon (grip-vertical)
// - Middle: item icon, title
// - Right: settings icon (to the left of eye) and eye visibility toggle (omitted for Home)
component NavToggleRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in-out property <bool> checked: false;
    in property <bool> show-eye: true;
    in property <bool> show-settings: true;
    in property <bool> is-dragging: false;
    callback toggled(bool);
    callback settings-clicked();

    min-height: Metrics.touch;
    border-radius: Metrics.radius-sm;
    background: transparent;

    HorizontalLayout {
        padding-left: Metrics.spacing-xs;
        padding-right: Metrics.spacing-xs;
        spacing: Metrics.spacing-sm;

        // 1. Left: Isolated Drag Handle Area
        VerticalLayout {
            alignment: center;
            drag-handle := Rectangle {
                width: 28px;
                height: 36px;
                border-radius: Metrics.radius-sm;
                background: root.is-dragging ? Palette.foreground.with-alpha(0.12) : transparent;

                Icon {
                    source: TablerIcons.grip-vertical;
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    color: root.is-dragging ? Palette.accent-background : Colors.muted.with-alpha(0.65);
                }
            }
        }

        // 2. Navigation Item Icon
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                Icon {
                    source: root.icon;
                    width: 24px;
                    height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    color: (!root.show-eye || root.checked) ? Palette.accent-background : Colors.muted;
                }
            }
        }

        // 3. Navigation Item Title
        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: Metrics.font-body + 1px;
            font-weight: (!root.show-eye || root.checked) ? 600 : 400;
            vertical-alignment: center;
            color: (!root.show-eye || root.checked) ? Palette.foreground : Colors.muted;
        }

        // 4. Settings icon button (to the left of the eye)
        if root.show-settings: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Metrics.radius-sm;
                background: settings-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
                animate background { duration: 120ms; }

                Icon {
                    source: TablerIcons.settings;
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    color: settings-touch.pressed ? Palette.foreground : Colors.muted;
                }

                settings-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-clicked();
                    }
                }
            }
        }

        // 5. Eye visibility toggle icon button (omitted for Home!)
        if root.show-eye: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Metrics.radius-sm;
                background: eye-touch.pressed ? Palette.foreground.with-alpha(0.08) : transparent;
                animate background { duration: 120ms; }

                Icon {
                    source: root.checked ? TablerIcons.eye : TablerIcons.eye-off;
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    color: root.checked ? Palette.accent-background : Colors.muted.with-alpha(0.55);
                }

                eye-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.checked = !root.checked;
                        root.toggled(root.checked);
                    }
                }
            }
        }

        // 6. Spacer placeholder when show-eye is false so settings icon stays aligned
        if !root.show-eye: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
            }
        }
    }
}

// Helper component that binds a bottom nav row by its item ID
component BottomNavConfigItem inherits Rectangle {
    in property <int> item-id;
    in property <int> item-index;
    in property <bool> is-dragging: false;
    in property <length> drag-dy: 0px;
    callback drag-started();
    callback drag-moved(length);
    callback drag-ended(length);
    callback open-directory();
    callback open-daily();
    callback open-starred();
    callback open-recent();
    callback open-graph();

    min-height: Metrics.touch;
    z: root.is-dragging ? 100 : 0;

    // Ghost placeholder shown in the original slot during drag
    if root.is-dragging: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: Metrics.radius-sm;
        background: Palette.foreground.with-alpha(0.04);
        border-width: 1px;
        border-color: Palette.accent-background.with-alpha(0.25);
    }

    // Row content: stays in-place normally, floats smoothly with drag-dy when dragged
    row-content := Rectangle {
        x: 0px;
        y: root.is-dragging ? root.drag-dy : 0px;
        width: 100%;
        height: 100%;
        border-radius: Metrics.radius-sm;
        background: root.is-dragging ? Palette.background : transparent;
        drop-shadow-blur: root.is-dragging ? 16px : 0px;
        drop-shadow-offset-y: root.is-dragging ? 4px : 0px;
        drop-shadow-color: root.is-dragging ? (Palette.color-scheme == ColorScheme.dark ? #000000dd : #00000030) : transparent;

        if root.item-id == 0: NavToggleRow {
            icon: TablerIcons.home;
            title: @tr("Home");
            checked: true;
            show-eye: false;
            show-settings: true;
            is-dragging: root.is-dragging;
        }

        if root.item-id == 1: NavToggleRow {
            icon: TablerIcons.search;
            title: @tr("Search");
            checked <=> SettingsAdapter.nav-show-search;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 2: NavToggleRow {
            icon: TablerIcons.files;
            title: @tr("Library");
            checked <=> SettingsAdapter.nav-show-library;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 3: NavToggleRow {
            icon: TablerIcons.folder;
            title: @tr("Directory");
            checked <=> SettingsAdapter.nav-show-directory;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            settings-clicked => { root.open-directory(); }
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 4: NavToggleRow {
            icon: TablerIcons.calendar;
            title: @tr("Daily Notes");
            checked <=> SettingsAdapter.nav-show-daily;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            settings-clicked => { root.open-daily(); }
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 5: NavToggleRow {
            icon: TablerIcons.star;
            title: @tr("Starred");
            checked <=> SettingsAdapter.nav-show-starred;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            settings-clicked => { root.open-starred(); }
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 6: NavToggleRow {
            icon: TablerIcons.clock;
            title: @tr("Recent");
            checked <=> SettingsAdapter.nav-show-recent;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            settings-clicked => { root.open-recent(); }
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 7: NavToggleRow {
            icon: TablerIcons.git-fork;
            title: @tr("Graph View");
            checked <=> SettingsAdapter.nav-show-graph;
            show-eye: true;
            show-settings: true;
            is-dragging: root.is-dragging;
            settings-clicked => { root.open-graph(); }
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 8: NavToggleRow {
            icon: TablerIcons.plus;
            title: @tr("New Note");
            checked <=> SettingsAdapter.nav-show-new-note;
            show-eye: true;
            show-settings: false;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 9: NavToggleRow {
            icon: TablerIcons.cloud;
            title: @tr("Sync");
            checked <=> SettingsAdapter.nav-show-sync;
            show-eye: true;
            show-settings: false;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 10: NavToggleRow {
            icon: TablerIcons.folder;
            title: @tr("Switch Vault");
            checked <=> SettingsAdapter.nav-show-switch-vault;
            show-eye: true;
            show-settings: false;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }

        if root.item-id == 11: NavToggleRow {
            icon: TablerIcons.settings;
            title: @tr("Settings");
            checked <=> SettingsAdapter.nav-show-settings;
            show-eye: true;
            show-settings: false;
            is-dragging: root.is-dragging;
            toggled(c) => { SettingsAdapter.bottom-bar-changed(); }
        }
    }

    // Drag handle touch area placed strictly over the left grip handle
    drag-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: 36px;
        height: 100%;
        mouse-cursor: grab;
        moved => {
            let dy = self.mouse-y - self.pressed-y;
            root.drag-moved(dy);
        }
        changed pressed => {
            if (self.pressed) {
                root.drag-started();
            } else {
                let dy = self.mouse-y - self.pressed-y;
                root.drag-ended(dy);
            }
        }
    }
}

// A full-screen sheet for application settings: a grouped list of rows
// (Interface; Other -- Sync & Remote, Vaults, Transfer & Share; Info -- About), each
// drilling into its own sub-page -- the common "grouped list -> detail"
// settings shape, chosen so new settings have an obvious home instead of
// piling onto one long flat page.
export component SettingsSheet inherits Rectangle {
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;
    in property <float> sheet-progress: 1.0;
    in property <length> sheet-y-offset: 0px;
    callback sheet-drag-moved(length);
    // dy, average downward px/ms over the drag (0 if timing wasn't captured)
    callback sheet-drag-swiped(length, float);
    callback sheet-drag-cancelled();

    callback close();
    in property <bool> show-back: true;
    in-out property <int> directory-mode: 0;

    // 0: list, 1: Appearance, 2: Accounts, 3: Vaults, 4: About, 5: Transfer & Share, 6: Advanced, 7: Navigation & Views.
    // 11: Bottom Navigation, 12: Directory, 13: Daily Notes, 14: Starred, 15: Recent, 16: Graph View.
    // in-out so the app-level Back action (hardware button / edge-swipe
    // gesture) can pop a sub-page back to the list -- see app.slint's
    // handle-back().
    in-out property <int> page: 0;
    in-out property <int> previous-page: 7;
    property <int> active-drag-idx: -1;
    property <length> active-drag-dy: 0px;

    public function go-back() -> bool {
        if (root.page >= 12 && root.previous-page == 11) {
            root.page = 11;
            root.previous-page = 7;
            return true;
        } else if (root.page >= 11) {
            root.page = 7;
            root.previous-page = 7;
            return true;
        } else if (root.page != 0) {
            root.page = 0;
            return true;
        }
        return false;
    }

    property <length> scroll-content-y: 0px;
    property <bool> scroll-at-top: root.scroll-content-y >= -1px;

    background: Colors.page-background;


    header-gesture := SheetDragArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.inset-top + Metrics.bar-height;
        inset-top: root.inset-top;
        enabled: root.page == 0;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        TopBar {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;
            inset-top: root.inset-top;
            bar-background: transparent;

            if root.page != 0: IconButton {
                icon: TablerIcons.chevron-left;
                clicked => { root.go-back(); }
            }
            if root.page == 0 && root.show-back: IconButton {
                icon: TablerIcons.chevron-down;
                clicked => { root.close(); }
            }

            Text {
                horizontal-stretch: 1;
                text: root.page == 1 ? @tr("Appearance")
                    : root.page == 2 ? @tr("Accounts")
                    : root.page == 3 ? @tr("Vaults")
                    : root.page == 4 ? @tr("About")
                    : root.page == 5 ? @tr("Transfer & Share")
                    : root.page == 6 ? @tr("Advanced")
                    : root.page == 7 ? @tr("Navigation & Views")
                    : root.page == 11 ? @tr("Bottom Navigation Bar")
                    : root.page == 12 ? @tr("Directory")
                    : root.page == 13 ? @tr("Daily Notes")
                    : root.page == 14 ? @tr("Starred")
                    : root.page == 15 ? @tr("Recent")
                    : root.page == 16 ? @tr("Graph View")
                    : @tr("Settings");
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                color: Palette.foreground;
            }

        }
    }

    body-gesture := SheetDragArea {
        x: 0px;
        y: root.inset-top + Metrics.bar-height;
        width: 100%;
        height: root.height - (root.inset-top + Metrics.bar-height) - root.inset-bottom;
        enabled: root.scroll-at-top && root.page == 0;
        sheet-drag-moved(dy) => { root.sheet-drag-moved(dy); }
        sheet-drag-swiped(dy, v) => { root.sheet-drag-swiped(dy, v); }
        sheet-drag-cancelled => { root.sheet-drag-cancelled(); }

        VerticalLayout {
            y: root.sheet-y-offset;
            width: 100%;
            height: 100%;

            // --------------------------------------------------------
            // List: Vaults & Sync / Appearance / Navigation & Views / Other & Info
            // --------------------------------------------------------
            if root.page == 0: AppScrollView {
                vertical-stretch: 1;
                content-y <=> root.scroll-content-y;

                VerticalLayout {
                // Without this, a VerticalLayout shorter than its Flickable
                // dumps all the leftover space onto one section instead of
                // leaving it below the content -- see home.slint's content
                // VerticalLayout for the full explanation.
                alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 24px;

                    Section {
                        title: @tr("Vaults & Sync");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.files;
                                label-text: @tr("Vaults");
                                clicked => { root.page = 3; }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.user;
                                label-text: @tr("Accounts");
                                clicked => { root.page = 2; }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.qrcode;
                                label-text: @tr("Transfer & Share");
                                clicked => {
                                    root.page = 5;
                                    SettingsAdapter.refresh-transfer-qr();
                                }
                            }
                        }
                    }

                    Section {
                        title: @tr("Appearance");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.palette;
                                label-text: @tr("Appearance");
                                clicked => { root.page = 1; }
                            }
                        }
                    }

                    Section {
                        title: @tr("Navigation & Views");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.layout-bottombar;
                                label-text: @tr("Navigation & Views");
                                clicked => { root.page = 7; }
                            }
                        }
                    }

                    Section {
                        title: @tr("Other & Info");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.adjustments;
                                label-text: @tr("Advanced");
                                clicked => { root.page = 6; }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.info-circle;
                                label-text: @tr("About");
                                clicked => { root.page = 4; }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Appearance Subpage (Theme, Font Size, UI Scale, Status Bar)
            // --------------------------------------------------------
            if root.page == 1: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-lg;

                        // Theme Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Theme");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                selected: SettingsAdapter.theme-choice;
                                changed(i) => {
                                    SettingsAdapter.theme-choice = i;
                                    SettingsAdapter.theme-changed(i);
                                }
                            }
                        }

                        Divider { }

                        // Font Size Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Editor Font Size");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: [@tr("Small (14)"), @tr("Medium (17)"), @tr("Large (20)")];
                                selected: SettingsAdapter.font-size-choice;
                                changed(i) => {
                                    SettingsAdapter.font-size-choice = i;
                                    SettingsAdapter.font-size-changed(i);
                                }
                            }
                        }

                        Divider { }

                        // UI Scale Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("UI Scale");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            SegmentedControl {
                                options: ["90%", "100%", "110%", "125%"];
                                selected: Metrics.ui-scale < 0.95 ? 0 : (Metrics.ui-scale <= 1.05 ? 1 : (Metrics.ui-scale <= 1.18 ? 2 : 3));
                                changed(i) => {
                                    Metrics.ui-scale = [0.9, 1.0, 1.1, 1.25][i];
                                }
                            }
                        }

                        Divider { }

                        // Status Bar Selector
                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Status Bar");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Hide it while editing a note (for a less distracting full-screen view), or everywhere in the app.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            SegmentedControl {
                                options: [@tr("Show"), @tr("Hide While Editing"), @tr("Always Hide")];
                                selected: SettingsAdapter.status-bar-choice;
                                changed(i) => {
                                    SettingsAdapter.status-bar-choice = i;
                                    SettingsAdapter.status-bar-changed(i);
                                }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Navigation & Views Menu (Bottom Nav, Page Settings)
            // --------------------------------------------------------
            if root.page == 7: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 24px;

                    Section {
                        title: @tr("Navigation");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.layout-bottombar;
                                label-text: @tr("Bottom Navigation Bar");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 11;
                                }
                            }
                        }
                    }

                    Section {
                        title: @tr("Page Settings");

                        Card {
                            content-padding: Metrics.spacing-xs;
                            content-spacing: 0px;

                            CategoryRow {
                                icon: TablerIcons.folder;
                                label-text: @tr("Directory");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 12;
                                }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.calendar;
                                label-text: @tr("Daily Notes");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 13;
                                }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.star;
                                label-text: @tr("Starred");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 14;
                                }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.clock;
                                label-text: @tr("Recent");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 15;
                                }
                            }

                            Divider { }

                            CategoryRow {
                                icon: TablerIcons.git-fork;
                                label-text: @tr("Graph View");
                                clicked => {
                                    root.previous-page = 7;
                                    root.page = 16;
                                }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Bottom Navigation Subpage
            // --------------------------------------------------------
            if root.page == 11: AppScrollView {
                vertical-stretch: 1;
                enabled: root.active-drag-idx < 0;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: @tr("Bottom Navigation Bar");
                                font-size: Metrics.font-sub;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Text {
                                text: @tr("Choose which items appear on the bottom navigation bar.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }

                        Divider { }

                        for id[idx] in SettingsAdapter.nav-order: BottomNavConfigItem {
                            item-id: id;
                            item-index: idx;
                            is-dragging: root.active-drag-idx == idx;
                            drag-dy: root.active-drag-idx == idx ? root.active-drag-dy : 0px;
                            drag-started => {
                                root.active-drag-idx = idx;
                                root.active-drag-dy = 0px;
                            }
                            drag-moved(dy) => {
                                root.active-drag-dy = dy;
                            }
                            drag-ended(dy) => {
                                let steps = round(root.active-drag-dy / 52px);
                                if (steps != 0) {
                                    let target = clamp(idx + steps, 0, SettingsAdapter.nav-order.length - 1);
                                    if (target != idx) {
                                        SettingsAdapter.move-nav-item(idx, target);
                                    }
                                }
                                root.active-drag-idx = -1;
                                root.active-drag-dy = 0px;
                            }
                            open-directory => {
                                root.previous-page = 11;
                                root.page = 12;
                            }
                            open-daily => {
                                root.previous-page = 11;
                                root.page = 13;
                            }
                            open-starred => {
                                root.previous-page = 11;
                                root.page = 14;
                            }
                            open-recent => {
                                root.previous-page = 11;
                                root.page = 15;
                            }
                            open-graph => {
                                root.previous-page = 11;
                                root.page = 16;
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Directory Subpage
            // --------------------------------------------------------
            if root.page == 12: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-lg;

                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Default View");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Choose how folder contents are displayed by default.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            SegmentedControl {
                                options: [@tr("List"), @tr("Grid")];
                                selected: root.directory-mode;
                                changed(i) => {
                                    root.directory-mode = i;
                                }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Daily Notes Subpage
            // --------------------------------------------------------
            if root.page == 13: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Daily Notes Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Settings for daily notes and calendar view will appear here.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Starred Subpage
            // --------------------------------------------------------
            if root.page == 14: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Starred Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Settings for starred and favorite notes will appear here.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Recent Subpage
            // --------------------------------------------------------
            if root.page == 15: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Recent Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Settings for edit history and timeline will appear here.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Graph View Subpage
            // --------------------------------------------------------
            if root.page == 16: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        VerticalLayout {
                            spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Graph View Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Settings for interactive note graph will appear here.");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Accounts
            // --------------------------------------------------------
            if root.page == 2: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    // 1. Current Vault Sync Header (Compact)
                    Card {
                        content-spacing: Metrics.spacing-sm;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    Text {
                                        text: @tr("Vault: ") + SettingsAdapter.current-vault-name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                    }
                                    if SettingsAdapter.current-vault-account-label != "": Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: Palette.accent-background.with-alpha(0.12);
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: SettingsAdapter.current-vault-account-label;
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: Palette.accent-background;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if SettingsAdapter.sync-status != "": Text {
                                    text: SettingsAdapter.sync-status;
                                    font-size: 12px;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }
                            }

                            Button {
                                text: SettingsAdapter.syncing ? @tr("Syncing...") : @tr("Sync Now");
                                primary: true;
                                enabled: !SettingsAdapter.syncing;
                                clicked => { SettingsAdapter.sync(); }
                            }
                        }
                    }

                    // 2. Connected Accounts Card
                    Card {
                        content-spacing: Metrics.spacing-md;

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: @tr("Connected Accounts");
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                            }
                        }

                        if SettingsAdapter.accounts.length == 0: Text {
                            text: @tr("No accounts connected yet.");
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        for acc in SettingsAdapter.accounts: Rectangle {
                            height: 56px;
                            border-radius: Metrics.radius-md;
                            background: Palette.foreground.with-alpha(0.04);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: center;

                                Icon {
                                    source: acc.provider == "gitlab" ? TablerIcons.brand-gitlab : (acc.provider == "forgejo" ? TablerIcons.brand-git : (acc.provider == "git" ? TablerIcons.git-fork : TablerIcons.brand-github));
                                    width: 22px;
                                    height: 22px;
                                    color: Palette.accent-background;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        Text {
                                            text: acc.username != "" ? ("@" + acc.username) : acc.id;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: Palette.foreground;
                                        }
                                        if SettingsAdapter.current-vault-account-id == acc.id: Rectangle {
                                            height: 18px;
                                            border-radius: 4px;
                                            background: Palette.accent-background.with-alpha(0.15);
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: @tr("Active");
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    color: Palette.accent-background;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: acc.provider + " · " + acc.instance-url;
                                        font-size: 11px;
                                        color: Colors.muted;
                                    }
                                }

                                Button {
                                    text: @tr("+ Vault");
                                    clicked => {
                                        SettingsAdapter.create-vault-from-account(acc.id, "immermemo-notes");
                                    }
                                }

                                IconButton {
                                    icon: TablerIcons.trash;
                                    clicked => { SettingsAdapter.delete-account(acc.id); }
                                }
                            }
                        }

                        Divider { }

                        // "+ Add Account" Toggle Button
                        if !SettingsAdapter.adding-account: HorizontalLayout {
                            alignment: center;
                            Button {
                                text: @tr("+ Add Account");
                                primary: SettingsAdapter.accounts.length == 0;
                                clicked => { SettingsAdapter.adding-account = true; }
                            }
                        }

                        // Add Account Section (when toggled on)
                        if SettingsAdapter.adding-account: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: @tr("Add Account");
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: TablerIcons.x;
                                    clicked => { SettingsAdapter.adding-account = false; }
                                }
                            }

                            SegmentedControl {
                                options: [@tr("GitHub"), @tr("Forgejo / Gitea"), @tr("GitLab"), @tr("Custom Git")];
                                selected: SettingsAdapter.sync-provider-tab;
                                changed(i) => { SettingsAdapter.sync-provider-tab = i; }
                            }

                            // Tab 0: GitHub
                            if SettingsAdapter.sync-provider-tab == 0: VerticalLayout {
                                spacing: Metrics.spacing-md;

                                if !SettingsAdapter.github-auth-pending: VerticalLayout {
                                    spacing: Metrics.spacing-md;
                                    Text {
                                        text: @tr("Sign in to automatically create and sync a private notes repository.");
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        alignment: end;
                                        Button {
                                            text: @tr("Connect with GitHub");
                                            primary: true;
                                            clicked => { SettingsAdapter.connect-github(); }
                                        }
                                    }
                                }

                                if SettingsAdapter.github-auth-pending: VerticalLayout {
                                    spacing: Metrics.spacing-md;
                                    Text {
                                        text: @tr("Confirm this one-time code on GitHub:");
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }

                                    Rectangle {
                                        height: 52px;
                                        border-radius: Metrics.radius-md;
                                        background: Palette.foreground.with-alpha(0.06);

                                        Text {
                                            text: SettingsAdapter.github-user-code;
                                            font-size: 22px;
                                            font-weight: 700;
                                            color: Palette.accent-background;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: SettingsAdapter.github-auth-status != "" ? SettingsAdapter.github-auth-status : @tr("Waiting for browser authorization...");
                                        font-size: Metrics.font-sm;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: end;
                                        Button {
                                            text: @tr("Cancel");
                                            clicked => { SettingsAdapter.cancel-github-auth(); }
                                        }
                                        Button {
                                            text: @tr("Open in Browser");
                                            primary: true;
                                            clicked => { SettingsAdapter.open-github-browser(); }
                                        }
                                    }
                                }
                            }

                            // Tab 1: Forgejo / Gitea
                            if SettingsAdapter.sync-provider-tab == 1: VerticalLayout {
                                spacing: Metrics.spacing-md;

                                Text {
                                    text: @tr("Connect Codeberg or your self-hosted Forgejo/Gitea instance using a Personal Access Token.");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Instance URL");
                                        font-size: 13px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: "https://codeberg.org";
                                        text <=> SettingsAdapter.forgejo-instance-draft;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Personal Access Token");
                                        font-size: 13px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: @tr("Token with repo and user permissions");
                                        text <=> SettingsAdapter.forgejo-token-draft;
                                        input-type: password;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Repository Name");
                                        font-size: 13px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: "immermemo-notes";
                                        text <=> SettingsAdapter.forgejo-repo-draft;
                                    }
                                }

                                if SettingsAdapter.forgejo-status-message != "": Text {
                                    text: SettingsAdapter.forgejo-status-message;
                                    color: SettingsAdapter.forgejo-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    Button {
                                        text: SettingsAdapter.forgejo-connecting ? @tr("Connecting...") : @tr("Connect Account");
                                        primary: true;
                                        enabled: !SettingsAdapter.forgejo-connecting && SettingsAdapter.forgejo-token-draft != "";
                                        clicked => {
                                            SettingsAdapter.connect-forgejo(
                                                SettingsAdapter.forgejo-instance-draft,
                                                SettingsAdapter.forgejo-token-draft,
                                                SettingsAdapter.forgejo-repo-draft,
                                            );
                                        }
                                    }
                                }
                            }

                            // Tab 2: GitLab
                            if SettingsAdapter.sync-provider-tab == 2: VerticalLayout {
                                spacing: Metrics.spacing-md;

                                Text {
                                    text: @tr("Connect to GitLab.com or a self-hosted instance using a Personal Access Token with api scope.");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("GitLab Instance URL");
                                        font-size: 12px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: "https://gitlab.com";
                                        text <=> SettingsAdapter.gitlab-instance-draft;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Personal Access Token (api scope)");
                                        font-size: 12px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: @tr("Token with api permission");
                                        text <=> SettingsAdapter.gitlab-token-draft;
                                        input-type: password;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Repository Name");
                                        font-size: 12px;
                                        color: Colors.muted;
                                    }
                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: "immermemo-notes";
                                        text <=> SettingsAdapter.gitlab-repo-draft;
                                    }
                                }

                                if SettingsAdapter.gitlab-status-message != "": Text {
                                    text: SettingsAdapter.gitlab-status-message;
                                    color: SettingsAdapter.gitlab-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    Button {
                                        text: SettingsAdapter.gitlab-connecting ? @tr("Connecting...") : @tr("Connect Account");
                                        primary: true;
                                        enabled: !SettingsAdapter.gitlab-connecting && SettingsAdapter.gitlab-token-draft != "";
                                        clicked => {
                                            SettingsAdapter.connect-gitlab(
                                                SettingsAdapter.gitlab-instance-draft,
                                                SettingsAdapter.gitlab-token-draft,
                                                SettingsAdapter.gitlab-repo-draft,
                                            );
                                        }
                                    }
                                }
                            }

                            // Tab 3: Custom Git Remote
                            if SettingsAdapter.sync-provider-tab == 3: VerticalLayout {
                                spacing: Metrics.spacing-md;

                                Text {
                                    text: @tr("Connect an arbitrary Git repository over HTTPS or SSH.");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Remote repository URL");
                                        font-size: 13px;
                                        color: Colors.muted;
                                    }

                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: @tr("https://git.example.com/notes.git or git@...");
                                        text <=> SettingsAdapter.url-draft;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: @tr("Access token (if using HTTPS)");
                                        font-size: 13px;
                                        color: Colors.muted;
                                    }

                                    LineEdit {
                                        height: Metrics.touch;
                                        placeholder-text: SettingsAdapter.has-token ? @tr("Leave blank to keep the saved token") : @tr("Personal access token");
                                        input-type: password;
                                        text <=> SettingsAdapter.token-draft;
                                    }
                                }

                                if SettingsAdapter.url-draft != "" && (SettingsAdapter.url-draft.starts-with("git@") || SettingsAdapter.url-draft.starts-with("ssh://")): HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: @tr("Using SSH? Ensure your public key is registered on the server.");
                                        font-size: 12px;
                                        color: Colors.muted;
                                        wrap: word-wrap;
                                    }
                                    Button {
                                        text: @tr("SSH Key");
                                        clicked => { root.page = 6; }
                                    }
                                }

                                if SettingsAdapter.sync-status != "": Text {
                                    text: SettingsAdapter.sync-status;
                                    font-size: 13px;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;

                                    Button {
                                        text: @tr("Save Remote");
                                        primary: true;
                                        clicked => {
                                            SettingsAdapter.save-remote(SettingsAdapter.url-draft, SettingsAdapter.token-draft);
                                            SettingsAdapter.adding-account = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Vaults
            // --------------------------------------------------------
            if root.page == 3: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    Card {
                        content-spacing: Metrics.spacing-md;

                        HorizontalLayout {
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.folder;
                                    width: Metrics.icon-md;
                                    height: Metrics.icon-md;
                                    color: Palette.accent-background;
                                }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: @tr("Vaults");
                                font-size: 16px;
                                font-weight: 600;
                                color: Palette.foreground;
                                vertical-alignment: center;
                            }
                            Text {
                                text: @tr("{} vaults", SettingsAdapter.vaults.length);
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                vertical-alignment: center;
                            }
                        }

                        Divider { }

                        for v[idx] in SettingsAdapter.vaults: VerticalLayout {
                            spacing: 0px;

                            if idx > 0: Rectangle {
                                height: 1px;
                                background: Colors.separator;
                            }

                            Rectangle {
                                min-height: 56px;
                                border-radius: Metrics.radius-md;
                                background: v.is-current
                                    ? Palette.accent-background.with-alpha(0.08)
                                    : transparent;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 6px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 8px;

                                    // Left: folder icon
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: v.is-current ? TablerIcons.folder-check : TablerIcons.folder;
                                            width: 22px;
                                            height: 22px;
                                            color: v.is-current ? Palette.accent-background : Colors.muted;
                                        }
                                    }

                                    // Center: vault name and subtitle (stretches to take available width)
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;

                                            Text {
                                                text: v.name;
                                                font-size: 15px;
                                                font-weight: v.is-current ? 600 : 500;
                                                color: v.is-current ? Palette.accent-background : Palette.foreground;
                                                vertical-alignment: center;
                                            }

                                            if v.is-current: Rectangle {
                                                border-radius: 4px;
                                                background: Palette.accent-background.with-alpha(0.18);
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    padding-top: 2px;
                                                    padding-bottom: 2px;
                                                    Text {
                                                        text: @tr("In Use");
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Palette.accent-background;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        if v.subtitle != "": Text {
                                            text: v.subtitle;
                                            font-size: 12px;
                                            color: Colors.muted;
                                            overflow: elide;
                                        }
                                    }

                                    // Right: checkmark for active vault (same width as IconButton for vertical alignment)
                                    if v.is-current: Rectangle {
                                        width: Metrics.touch;
                                        Icon {
                                            source: TablerIcons.check;
                                            width: 20px;
                                            height: 20px;
                                            color: Palette.accent-background;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    // Right: action buttons for other vaults
                                    if !v.is-current: HorizontalLayout {
                                        spacing: 2px;
                                        alignment: center;

                                        Button {
                                            text: @tr("Switch");
                                            clicked => {
                                                SettingsAdapter.switch-vault(v.original-index);
                                            }
                                        }

                                        if SettingsAdapter.vaults.length > 1: IconButton {
                                            icon: TablerIcons.trash;
                                            clicked => {
                                                SettingsAdapter.delete-vault(v.original-index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Button {
                        text: @tr("+ Add Vault");
                        primary: true;
                        clicked => {
                            SettingsAdapter.add-vault();
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // About
            // --------------------------------------------------------
            if root.page == 4: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;

                    Card {
                        content-spacing: Metrics.spacing-sm;

                        Text {
                            text: @tr("Immermemo v{}", SettingsAdapter.app-version);
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }

                        Text {
                            text: @tr("A mobile note app for writing Tomet (.tmt) notes, synced over git without git touching user files.");
                            font-size: 13px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 4px;
                        }

                        Text {
                            text: @tr("AST-level three-way merge with conflict tracking (@conflict).");
                            font-size: 12px;
                            color: Colors.muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // --------------------------------------------------------
            // Transfer & Share
            // --------------------------------------------------------
            if root.page == 5: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    SegmentedControl {
                        options: [@tr("Export (Show QR)"), @tr("Import")];
                        selected: SettingsAdapter.transfer-tab;
                        changed(i) => {
                            SettingsAdapter.transfer-tab = i;
                            if (i == 0) {
                                SettingsAdapter.refresh-transfer-qr();
                            }
                        }
                    }

                    if SettingsAdapter.transfer-tab == 0: VerticalLayout {
                        spacing: 16px;

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Select items to include:");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            TransferToggleRow {
                                icon: TablerIcons.settings;
                                title: @tr("Appearance & UI");
                                subtitle: @tr("Theme, font size, and UI scale");
                                checked: SettingsAdapter.export-include-interface;
                                toggled(c) => {
                                    SettingsAdapter.export-include-interface = c;
                                    SettingsAdapter.export-options-changed(SettingsAdapter.export-include-interface, SettingsAdapter.export-include-remote, SettingsAdapter.export-include-token);
                                }
                            }

                            Divider { }

                            TransferToggleRow {
                                icon: TablerIcons.cloud;
                                title: @tr("Remote Sync URL");
                                subtitle: @tr("Active vault remote git repository URL");
                                checked: SettingsAdapter.export-include-remote;
                                toggled(c) => {
                                    SettingsAdapter.export-include-remote = c;
                                    SettingsAdapter.export-options-changed(SettingsAdapter.export-include-interface, SettingsAdapter.export-include-remote, SettingsAdapter.export-include-token);
                                }
                            }

                            Divider { }

                            TransferToggleRow {
                                icon: TablerIcons.lock-share;
                                title: @tr("Include Access Token");
                                subtitle: @tr("⚠️ Contains sensitive personal credentials");
                                checked: SettingsAdapter.export-include-token;
                                is-warning: true;
                                toggled(c) => {
                                    SettingsAdapter.export-include-token = c;
                                    SettingsAdapter.export-options-changed(SettingsAdapter.export-include-interface, SettingsAdapter.export-include-remote, SettingsAdapter.export-include-token);
                                }
                            }
                        }

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Scan with another device:");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 220px;
                                    height: 220px;
                                    border-radius: Metrics.radius-md;
                                    background: white;
                                    clip: true;

                                    Image {
                                        width: 200px;
                                        height: 200px;
                                        source: SettingsAdapter.qr-image;
                                        image-fit: contain;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: SettingsAdapter.transfer-copied ? @tr("Copied to Clipboard!") : @tr("Copy Transfer Link");
                                    clicked => { SettingsAdapter.copy-transfer-link(); }
                                }
                            }
                        }
                    }

                    if SettingsAdapter.transfer-tab == 1: VerticalLayout {
                        spacing: 16px;

                        Card {
                            content-spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Import Settings");
                                font-size: Metrics.font-sub;
                                color: Colors.muted;
                            }

                            Text {
                                text: @tr("Paste an immermemo:// transfer link or payload below:");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            LineEdit {
                                height: Metrics.touch;
                                placeholder-text: @tr("immermemo://import#... or JSON");
                                text <=> SettingsAdapter.import-draft;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: @tr("Paste Clipboard");
                                    clicked => { SettingsAdapter.paste-import-clipboard(); }
                                }

                                Button {
                                    text: @tr("Review & Apply");
                                    primary: true;
                                    enabled: SettingsAdapter.import-draft != "";
                                    clicked => { SettingsAdapter.review-import(SettingsAdapter.import-draft); }
                                }
                            }

                            if SettingsAdapter.import-status-message != "": Text {
                                text: SettingsAdapter.import-status-message;
                                font-size: 13px;
                                color: SettingsAdapter.import-status-is-error ? (Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500) : Colors.muted;
                                wrap: word-wrap;
                            }
                        }

                        if SettingsAdapter.import-preview-ready: Card {
                            content-spacing: Metrics.spacing-sm;

                            Text {
                                text: @tr("Settings Ready to Import");
                                font-size: 15px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }

                            Divider { }

                            if SettingsAdapter.preview-has-interface: ActionRow {
                                text: @tr("✓ Appearance & UI settings");
                            }

                            if SettingsAdapter.preview-has-remote: ActionRow {
                                text: @tr("✓ Remote URL: ") + SettingsAdapter.preview-remote-url;
                            }

                            if SettingsAdapter.preview-has-token: ActionRow {
                                text: @tr("⚠️ Access Token (will update saved token)");
                                tint: Palette.color-scheme == ColorScheme.dark ? #ffaa55 : #cc5500;
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: @tr("Cancel");
                                    clicked => { SettingsAdapter.cancel-import-preview(); }
                                }

                                Button {
                                    text: @tr("Apply Settings");
                                    primary: true;
                                    clicked => { SettingsAdapter.apply-import(); }
                                }
                            }
                        }
                    }
                }

            }

            // --------------------------------------------------------
            // Advanced Settings (In-App SSH Key, etc.)
            // --------------------------------------------------------
            if root.page == 6: AppScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    alignment: start;
                    padding-left: Metrics.gutter;
                    padding-right: Metrics.gutter;
                    padding-top: 16px;
                    padding-bottom: root.inset-bottom + 24px;
                    spacing: 16px;

                    // In-App SSH Key Card
                    Card {
                        content-spacing: Metrics.spacing-md;

                        HorizontalLayout {
                            spacing: Metrics.spacing-md;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: TablerIcons.key;
                                    width: Metrics.icon-lg;
                                    height: Metrics.icon-lg;
                                    color: Palette.accent-background;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: @tr("In-App SSH Key");
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: @tr("Enables Git over SSH synchronization on mobile and desktop without external agents.");
                                    font-size: Metrics.font-sm;
                                    color: Colors.muted;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Divider { }

                        if SettingsAdapter.ssh-key-present: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Copy this public key and add it to your GitHub, GitLab, or Forgejo SSH Keys:");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                min-height: 48px;
                                border-radius: Metrics.radius-md;
                                background: Palette.foreground.with-alpha(0.06);
                                border-width: 1px;
                                border-color: Palette.foreground.with-alpha(0.12);

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: SettingsAdapter.ssh-public-key;
                                        font-size: 11px;
                                        color: Palette.foreground;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;

                                Button {
                                    text: @tr("Regenerate Key");
                                    clicked => { SettingsAdapter.generate-ssh-key(); }
                                }

                                Button {
                                    text: SettingsAdapter.ssh-key-copied ? @tr("Copied!") : @tr("Copy Public Key");
                                    primary: true;
                                    clicked => { SettingsAdapter.copy-ssh-public-key(); }
                                }
                            }
                        }

                        if !SettingsAdapter.ssh-key-present: VerticalLayout {
                            spacing: Metrics.spacing-md;

                            Text {
                                text: @tr("Generate a secure Ed25519 SSH keypair directly inside the app to sync with SSH remotes (git@...).");
                                font-size: Metrics.font-sm;
                                color: Colors.muted;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: end;
                                Button {
                                    text: @tr("Generate SSH Key");
                                    primary: true;
                                    clicked => { SettingsAdapter.generate-ssh-key(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
