import { WrappedText } from "widgets.slint";
import { SettingsAdapter } from "../../adapters/settings.slint";
import { Palette, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { Card, Divider } from "@origiri-mobile/widgets.slint";
import { SettingsPage } from "page.slint";

export component AdvancedPage inherits SettingsPage {
    // In-App SSH Key Card
    Card {
        content-spacing: Metrics.spacing-md;

        HorizontalLayout {
            spacing: Metrics.spacing-md;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: TablerIcons.key;
                    width: Metrics.icon-lg;
                    height: Metrics.icon-lg;
                    color: Palette.accent-background;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("In-App SSH Key");
                    font-size: 16px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                WrappedText {
                    text: @tr("Enables Git over SSH synchronization on mobile and desktop without external agents.");
                    font-size: Metrics.font-sm;
                    text-color: Colors.muted;
                                    }
            }
        }

        Divider { }

        if SettingsAdapter.ssh-key-present: VerticalLayout {
            spacing: Metrics.spacing-md;

            WrappedText {
                text: @tr("Copy this public key and add it to your GitHub, GitLab, or Forgejo SSH Keys:");
                font-size: Metrics.font-sm;
                text-color: Colors.muted;
                            }

            Rectangle {
                min-height: 48px;
                border-radius: Metrics.radius-md;
                background: Palette.foreground.with-alpha(0.06);
                border-width: 1px;
                border-color: Palette.foreground.with-alpha(0.12);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: SettingsAdapter.ssh-public-key;
                        font-size: 11px;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Regenerate Key");
                    clicked => { SettingsAdapter.generate-ssh-key(); }
                }

                Button {
                    text: SettingsAdapter.ssh-key-copied ? @tr("Copied!") : @tr("Copy Public Key");
                    primary: true;
                    clicked => { SettingsAdapter.copy-ssh-public-key(); }
                }
            }
        }

        if !SettingsAdapter.ssh-key-present: VerticalLayout {
            spacing: Metrics.spacing-md;

            WrappedText {
                text: @tr("Generate a secure Ed25519 SSH keypair directly inside the app to sync with SSH remotes (git@...).");
                font-size: Metrics.font-sm;
                text-color: Colors.muted;
                            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Generate SSH Key");
                    primary: true;
                    clicked => { SettingsAdapter.generate-ssh-key(); }
                }
            }
        }
    }
}
