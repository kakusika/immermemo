import { SettingsAdapter } from "../../adapters/settings.slint";
import { Palette, Button } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { TablerIcons } from "@origiri-icons/icons.slint";
import { IconButton, Card, Divider } from "@origiri-mobile/widgets.slint";
import { AccountAvatar } from "../../widgets/account_avatar.slint";
import { WrappedText } from "widgets.slint";
import { SettingsPage } from "page.slint";
import { AddAccountPanel } from "add_account.slint";

export component AccountsPage inherits SettingsPage {
    in-out property <int> page;

    Card {
        content-spacing: Metrics.spacing-md;

        HorizontalLayout {
            alignment: center;
            Text {
                text: @tr("Accounts");
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
                horizontal-stretch: 1;
            }
        }

        WrappedText {
            text: @tr("An account is a login to a Git host. Each vault chooses which account, and which repository, it syncs with.");
            font-size: Metrics.font-sm;
            text-color: Colors.muted;
        }

        if SettingsAdapter.accounts.length == 0: WrappedText {
            text: @tr("No accounts yet.");
            font-size: 13px;
            text-color: Colors.muted;
        }

        for acc in SettingsAdapter.accounts: Rectangle {
            height: 56px;
            border-radius: Metrics.radius-md;
            background: Palette.foreground.with-alpha(0.04);

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;

                AccountAvatar {
                    avatar: acc.avatar;
                    has-avatar: acc.has-avatar;
                    provider: acc.provider;
                    avatar-size: 32px;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;

                    Text {
                        text: acc.username != "" ? ("@" + acc.username) : acc.id;
                        font-size: 14px;
                        font-weight: 600;
                        color: Palette.foreground;
                        overflow: elide;
                    }

                    Text {
                        text: acc.provider + " · " + acc.instance-url
                            + (acc.vault-count > 0 ? (" · " + @tr("{} vaults", acc.vault-count)) : "");
                        font-size: 11px;
                        color: Colors.muted;
                        overflow: elide;
                    }
                }

                Button {
                    text: @tr("+ Vault");
                    clicked => { SettingsAdapter.new-vault-with-account(acc.id); }
                }

                IconButton {
                    icon: TablerIcons.trash;
                    clicked => { SettingsAdapter.delete-account(acc.id); }
                }
            }
        }

        Divider { }

        if !SettingsAdapter.adding-account: HorizontalLayout {
            alignment: center;
            Button {
                text: @tr("+ Add Account");
                primary: SettingsAdapter.accounts.length == 0;
                clicked => { SettingsAdapter.adding-account = true; }
            }
        }

        if SettingsAdapter.adding-account: VerticalLayout {
            spacing: Metrics.spacing-md;

            HorizontalLayout {
                alignment: center;
                Text {
                    text: @tr("Add Account");
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: TablerIcons.x;
                    clicked => { SettingsAdapter.adding-account = false; }
                }
            }

            AddAccountPanel { }
        }
    }
}
