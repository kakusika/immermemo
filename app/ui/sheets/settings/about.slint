import { WrappedText } from "widgets.slint";
import { SettingsAdapter } from "../../adapters/settings.slint";
import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Card } from "@origiri-mobile/widgets.slint";
import { SettingsPage } from "page.slint";

export component AboutPage inherits SettingsPage {
    Card {
        content-spacing: Metrics.spacing-sm;

        Text {
            text: @tr("Immermemo v{}", SettingsAdapter.app-version);
            font-size: 16px;
            font-weight: 600;
            color: Palette.foreground;
        }

        // Selectable would be handier to copy, but a plain line is enough to
        // compare against the build just made.
        Text {
            text: @tr("Build {}", SettingsAdapter.build-id);
            font-size: 12px;
            color: Colors.muted;
        }

        if SettingsAdapter.emoji-font != "": WrappedText {
            text: @tr("Emoji font: {}", SettingsAdapter.emoji-font);
            font-size: 12px;
            text-color: Colors.muted;
        }

        WrappedText {
            text: @tr("A mobile note app for writing Tomet (.tmt) notes, synced over git without git touching user files.");
            font-size: 13px;
            text-color: Colors.muted;
                    }

        Rectangle {
            height: 4px;
        }

        WrappedText {
            text: @tr("AST-level three-way merge with conflict tracking (@conflict).");
            font-size: 12px;
            text-color: Colors.muted;
                    }
    }
}
