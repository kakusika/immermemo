// Global adapter managing settings, remote sync configurations,
// cloud hosting providers (GitHub, Forgejo, GitLab), QR transfer, and SSH keys.

export struct AccountData {
    id: string,
    provider: string,
    instance-url: string,
    username: string,
    display-name: string,
    avatar: image,
    has-avatar: bool,
    // How many vaults sync through this account.
    vault-count: int,
}

export struct VaultData {
    name: string,
    path: string,
    subtitle: string,
    is-current: bool,
    original-index: int,
    has-account: bool,
    // Whether the vault syncs at all (through an account or a typed remote).
    syncs: bool,
    account-provider: string,
    account-avatar: image,
    account-has-avatar: bool,
}

export struct HomeQuickActionRow {
    items: [int],
    empty-slots: int,
}

export global SettingsAdapter {
    // Accounts list
    in property <[AccountData]> accounts: [];
    // The open vault's sync account, if it syncs through one (shown on Home).
    in property <bool> current-vault-has-account: false;
    in property <string> current-vault-account-provider: "";
    in property <image> current-vault-account-avatar;
    in property <bool> current-vault-account-has-avatar: false;
    in-out property <bool> adding-account: false;

    // Vaults list
    in property <[VaultData]> vaults: [];

    // Remote sync properties
    in property <bool> syncing: false;
    in property <string> sync-status: "";

    // Vault properties
    in property <string> current-vault-name: "";
    in property <string> current-vault-path: "";

    // Appearance properties
    // 0: Small (14px), 1: Medium (17px), 2: Large (20px)
    in-out property <int> font-size-choice: 1;
    // 0: System, 1: Light, 2: Dark
    in-out property <int> theme-choice: 0;
    // 0: System (Wallpaper), 1: Custom
    in-out property <int> color-source: 0;
    in-out property <string> color-seed: "#6750A4";
    // 0: Tonal Spot, 1: Vivid, 2: Expressive, 3: Fruit Salad, 4: Rainbow, 5: Spritz, 6: Monochrome
    in-out property <int> palette-style: 0;
    // 0: Standard, 1: Medium, 2: High
    in-out property <int> contrast-level: 0;
    // 0: show (default), 1: hide while editing a note, 2: always hide
    in-out property <int> status-bar-choice: 0;

    // Bottom bar actions
    in-out property <bool> nav-show-home: true;
    in-out property <bool> nav-show-search: true;
    in-out property <bool> nav-show-library: true;
    in-out property <bool> nav-show-directory: false;
    in-out property <bool> nav-show-daily: false;
    in-out property <bool> nav-show-starred: false;
    in-out property <bool> nav-show-recent: false;
    in-out property <bool> nav-show-graph: false;
    in-out property <bool> nav-show-new-note: true;
    in-out property <bool> nav-show-sync: true;
    in-out property <bool> nav-show-switch-vault: true;
    in-out property <bool> nav-show-settings: true;
    // Order of items by ID:
    // 0: home, 1: search, 2: library, 3: directory, 4: daily, 5: starred, 6: recent, 7: graph,
    // 8: new_note, 9: sync, 10: switch_vault, 11: settings
    in-out property <[int]> nav-order: [0, 1, 8, 2, 9, 10, 11, 3, 4, 5, 6, 7];
    callback move-nav-item(int, int);

    // Home quick actions
    in-out property <bool> home-show-new-note: true;
    in-out property <bool> home-show-search: false;
    in-out property <bool> home-show-library: false;
    in-out property <bool> home-show-directory: false;
    in-out property <bool> home-show-daily: false;
    in-out property <bool> home-show-starred: false;
    in-out property <bool> home-show-recent: false;
    in-out property <bool> home-show-graph: false;
    in-out property <bool> home-show-sync: false;
    in-out property <bool> home-show-switch-vault: false;
    in-out property <bool> home-show-settings: false;
    // Order of home quick actions by ID:
    // 8: new_note, 1: search, 4: daily, 3: directory, 5: starred, 6: recent, 7: graph, 2: library, 9: sync, 10: switch_vault, 11: settings
    in-out property <[int]> home-actions-order: [8, 1, 4, 3, 5, 6, 7, 2, 9, 10, 11];
    in property <[int]> home-enabled-actions: [8];
    in property <[HomeQuickActionRow]> home-quick-action-rows: [{ items: [8], empty-slots: 2 }];
    callback move-home-action-item(int, int);
    callback home-actions-changed();

    // App info
    in property <string> app-version;
    // Which build this is (commit and build time), to tell a phone's install
    // from the build just made.
    in property <string> build-id;
    // Which emoji font the device offered and which was used (Android only;
    // empty elsewhere, where the system's own emoji font is used as it is).
    in property <string> emoji-font;

    // Transfer & Share properties
    in property <image> qr-image;
    in-out property <bool> export-include-interface: true;
    in-out property <bool> export-include-remote: true;
    in-out property <bool> export-include-token: false;
    in property <bool> transfer-copied: false;
    in-out property <string> import-draft: "";
    in property <bool> import-preview-ready: false;
    in property <bool> preview-has-interface: false;
    in property <bool> preview-has-remote: false;
    in property <string> preview-remote-url: "";
    in property <bool> preview-has-token: false;
    in property <string> import-status-message: "";
    in property <bool> import-status-is-error: false;
    in-out property <int> transfer-tab: 0;

    // Cloud Provider Sync properties
    in property <bool> github-auth-pending: false;
    in property <string> github-user-code: "";
    in property <string> github-verification-uri: "";
    in property <string> github-auth-status: "";

    in property <bool> forgejo-connecting: false;
    in property <string> forgejo-status-message: "";
    in property <bool> forgejo-status-is-error: false;

    in property <bool> gitlab-connecting: false;
    in property <string> gitlab-status-message: "";
    in property <bool> gitlab-status-is-error: false;

    in-out property <int> sync-provider-tab: 0; // 0: GitHub, 1: Forgejo / Gitea, 2: GitLab
    in-out property <string> forgejo-instance-draft: "https://codeberg.org";
    in-out property <string> forgejo-token-draft: "";

    in-out property <string> gitlab-instance-draft: "https://gitlab.com";
    in-out property <string> gitlab-token-draft: "";


    // In-app SSH key
    in property <bool> ssh-key-present: false;
    in property <string> ssh-public-key: "";
    in property <bool> ssh-key-copied: false;

    // Callbacks
    callback sync();
    callback open-vaults();
    callback status-bar-changed(int);
    callback bottom-bar-changed();
    callback font-size-changed(int);
    callback theme-changed(int);
    callback color-source-changed(int);
    callback color-seed-changed(string);
    callback palette-style-changed(int);
    callback contrast-level-changed(int);
    callback refresh-transfer-qr();
    callback export-options-changed(bool, bool, bool);
    callback copy-transfer-link();
    callback paste-import-clipboard();
    callback review-import(string);
    callback apply-import();
    callback cancel-import-preview();

    callback connect-github();
    callback open-github-browser();
    callback cancel-github-auth();

    callback connect-forgejo(string, string);

    callback connect-gitlab(string, string);

    callback generate-ssh-key();
    callback copy-ssh-public-key();

    callback delete-account(string);
    // Opens the add-vault sheet with this account already chosen for sync.
    callback new-vault-with-account(string);

    callback switch-vault(int);
    callback add-vault();
    callback delete-vault(int);
}
