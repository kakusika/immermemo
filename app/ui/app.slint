import { Palette } from "std-widgets.slint";
import { Metrics, Colors } from "@origiri-mobile/tokens.slint";
import { Icon, TablerIcons } from "@origiri-icons/icons.slint";
import { BottomNavBar, IconActionRow } from "components.slint";
import { MiniNoteBar } from "widgets/mini_note_bar.slint";
import { EditorScreen } from "pages/editor/editor.slint";
import { NoteBodyItemView } from "render/note_body.slint";
import { RenderedBlock, RenderedBlockView } from "render/rendered_block.slint";
import { HomeScreen } from "pages/home.slint";
import {
    FilesScreen,
    DirectoryEntry,
    BreadcrumbSegment,
} from "pages/files.slint";
import { SearchScreen } from "pages/search.slint";
import { VaultSheet } from "sheets/vault.slint";
import { SettingsSheet } from "sheets/settings/settings.slint";
import { ConflictSheet } from "sheets/conflict.slint";
import { HistorySheet } from "sheets/history.slint";
import { VaultHistorySheet } from "sheets/vault_history.slint";
import { IconPickerSheet, PickerIconEntry } from "sheets/icon_picker.slint";
import {
    TextInputDialog,
    ConfirmDialog,
    ActionSheet,
    ActionRow,
} from "@origiri-mobile/widgets.slint";
export { PickerIconEntry } from "sheets/icon_picker.slint";
import { NotePropertyEntry } from "pages/editor/properties.slint";
export { NotePropertyEntry }
import { SettingsAdapter } from "sheets/settings/adapter.slint";
export { SettingsAdapter }

// Drives one full-screen sheet's "hop up from the bottom, swipe down to
// dismiss" animation -- the same drag math `App` already runs for the
// note editor sheet (see its `sheet-drag-moved`/`-swiped`/`-cancelled`
// handlers below), factored out so each of `VaultSheet`/`HistorySheet`/
// `VaultHistorySheet`/`IconPickerSheet` can own an independent instance
// instead of sharing `App`'s own `is-dragging-sheet`/`drag-sheet-progress`
// (which stay dedicated to the note editor sheet/mini-card, untouched by
// this). `progress <= 0.60` and the velocity threshold mirror the note
// sheet's own close/stay-open split exactly.
component SheetDragState {
    in property <bool> open: false;
    in-out property <bool> dragging: false;
    in-out property <float> progress: 0.0;
    property <bool> threshold-passed: false;
    out property <float> sheet-progress: root.dragging
        ? root.progress
        : (root.open ? 1.0 : 0.0);
    animate sheet-progress {
        duration: root.dragging ? 0ms : 240ms;
        easing: ease-out;
    }

    callback close();
    callback haptic();

    public function moved(dy: length, travel: length) {
        let downward = max(0px, dy);
        let p = clamp(1.0 - (downward / travel), 0.0, 1.0);
        let passed = p <= 0.60;
        if (passed != root.threshold-passed) {
            root.threshold-passed = passed;
            root.haptic();
        }
        root.dragging = true;
        root.progress = p;
    }
    public function swiped(dy: length, velocity: float) {
        let flicked-closed = velocity > 0.6 * Metrics.ui-scale;
        let should-close = root.progress <= 0.60 || flicked-closed;
        root.dragging = false;
        root.threshold-passed = false;
        if (should-close) {
            root.close();
        } else {
            root.progress = 1.0;
        }
    }
    public function cancelled() {
        root.dragging = false;
        root.threshold-passed = false;
        root.progress = 1.0;
    }
}

export component App inherits Window {
    title: "immermemo";
    preferred-width: 960px;
    preferred-height: 640px;
    background: Colors.page-background;
    forward-focus: root-focus-scope;

    // Navigation: 0: Home, 1: Files, 2: Search, 3: Settings. Properties
    // moved into the note sheet itself (EditorScreen's note-view) --
    // see ViewSwitcher in components.slint.
    in-out property <int> active-tab: 0;

    in-out property <bool> note-sheet-open: false;
    changed note-sheet-open => { root.note-sheet-open-changed(root.note-sheet-open); }

    public function open-note-sheet() {
        root.note-sheet-open = true;
        root.drag-sheet-progress = 1.0;
        pane.view-mode();
        root.trigger-haptic();
    }

    public function close-note-sheet() {
        pane.view-mode();
        root.note-sheet-open = false;
        root.drag-sheet-progress = 0.0;
        root.trigger-haptic();
    }

    in property <[string]> notes;
    in property <[string]> snippets: [];
    in property <[bool]> conflicted;
    in property <int> current: -1;
    in-out property <string> search-query: "";
    in property <string> current-title;
    in property <string> current-note-path: "";
    in property <string> note-kind: "";
    in property <[NotePropertyEntry]> note-metadata: [];
    in property <int> char-count: 0;
    in property <int> word-count: 0;
    in property <int> line-count: 0;
    in property <int> conflict-count: 0;
    in-out property <string> status;
    in-out property <bool> status-is-error: false;
    in-out property <string> last-sync-error: "";
    in-out property <bool> sync-error-copied: false;
    in property <string> last-synced-at: "";
    in property <bool> syncing;
    in property <bool> current-has-conflict;
    in-out property <bool> conflict-sheet-open: false;
    in-out property <bool> history-sheet-open: false;
    in property <[string]> history-commits: [];
    in property <[string]> history-dates: [];
    in property <[string]> history-previews: [];
    in-out property <int> history-selected-index: 0;
    in-out property <bool> vault-history-open: false;
    in property <[string]> vault-history-commits: [];
    in property <[string]> vault-history-dates: [];
    in-out property <int> active-conflict-index: 0;
    in property <int> active-conflict-total: 0;
    // `a`/`b` are `@conflict`'s own structural names -- neither carries
    // mine/theirs meaning by itself (reversible depending on who's
    // looking, see `.agents/tasks/git-ancestry-conflict-labeling.md`).
    // `a-label`/`b-label` (and the matching `*-button-label`s) are
    // computed in Rust from `immermemo_sync::ConflictSide` and already
    // say "Mine"/"Theirs"/a neutral "A"/"B" as appropriate -- this file
    // never branches on that itself.
    in property <string> active-conflict-a: "";
    in property <string> active-conflict-b: "";
    in property <string> active-conflict-a-label: "";
    in property <string> active-conflict-b-label: "";
    in property <string> active-conflict-a-button-label: "";
    in property <string> active-conflict-b-button-label: "";
    in property <bool> can-undo;
    in property <bool> can-redo;
    // Back/forward stack of previously-opened notes (`session.rs`'s
    // `BackForwardStack`) -- distinct from `can-undo`/`can-redo` above
    // (per-note text edits) and from the git-commit "history" sheets.
    in property <bool> can-navigate-back;
    in property <bool> can-navigate-forward;
    // Lightweight preview of the adjacent history notes (title + first
    // non-empty line, not the fully-rendered body) -- refreshed whenever
    // the back/forward stack changes, not per drag frame. Empty when
    // `can-navigate-back`/`-forward` is false.
    in property <string> history-back-title;
    in property <[NoteBodyItemView]> history-back-items: [];
    in property <string> history-forward-title;
    in property <[NoteBodyItemView]> history-forward-items: [];
    callback navigate-back();
    callback navigate-forward();
    in-out property <string> body;
    // Derived from `body` by `src/render/mod.rs`, kept in step with
    // it everywhere Rust sets `body` -- see that module's doc. Read-only
    // from Slint's side: nothing here ever writes it back.
    in property <[NoteBodyItemView]> note-body-items: [];
    // Mirrors `pane`'s own `body-content-width` so Rust can read the
    // current value on demand (`body`/font-size changes, not just a resize)
    // -- `reflow-note-body` below only *pushes* a new value reactively when
    // it changes; most recomputes of `note-body-items` happen for other
    // reasons and still need to know the width to flow against.
    out property <length> body-content-width: pane.body-content-width;
    // Driven by `src/render/mod.rs`'s `RealMeasure` -- set a probe
    // property, read the matching `*-width` property right back,
    // synchronously, once per measurement. See the probe elements
    // themselves (bottom of this file) for why they exist as real
    // elements instead of a pure computation.
    in property <string> measure-probe-text;
    in property <length> measure-probe-font-size: 16px;
    // Bold/italic measure wider/narrower than regular text -- matching
    // these to whatever `FlowView` will actually render the run at is
    // what makes the wrap decision correct, not just the font size.
    in property <int> measure-probe-font-weight: 400;
    in property <bool> measure-probe-font-italic: false;
    out property <length> measure-probe-text-width: measure-probe-text-item.preferred-width;
    in property <RenderedBlock> measure-probe-block;
    out property <length> measure-probe-block-width: measure-probe-block-item.preferred-width;
    in property <bool> remote-configured;
    in-out property <int> note-menu-index: -1;
    in-out property <bool> quick-actions-open: false;
    in-out property <bool> more-menu-open: false;
    // Library Directory's List/Grid views -- see `files.slint`'s
    // `DirectoryEntry`/`BreadcrumbSegment` and
    // `app/src/directory.rs`'s module doc.
    in property <[DirectoryEntry]> directory-folder-entries: [];
    in property <[BreadcrumbSegment]> directory-breadcrumb: [];
    callback navigate-directory-folder(string);
    in-out property <bool> rename-open: false;
    in-out property <string> rename-draft;
    // Sets a note's own `@meta{ icon: @doc.icon(...) }` -- see
    // `sheets/icon_picker.slint`'s own doc comment and
    // `immermemo::session::open_icon_picker`. `icon-picker-results` is
    // Rust-filtered/capped, never all 5000+ vendored icons at once.
    in-out property <bool> icon-picker-open: false;
    in-out property <string> icon-picker-query;
    in property <[PickerIconEntry]> icon-picker-results: [];
    in-out property <bool> delete-confirm-open: false;
    in-out property <length> mini-card-reveal-dx: 0px;
    in-out property <bool> is-dragging-mini-reveal: false;
    in-out property <bool> delete-vault-confirm-open: false;
    in-out property <bool> vault-sheet-open: false;
    in property <[string]> vaults;
    in property <int> current-vault: -1;
    in property <string> current-vault-name: "";
    in property <string> current-vault-path: "";
    in-out property <bool> settings-sheet-open: false;
    in-out property <bool> settings-open <=> root.settings-sheet-open;
    in-out property <int> settings-page: 0;
    in-out property <int> font-size-choice <=> SettingsAdapter.font-size-choice;
    in-out property <length> editor-font-size: 17px;
    in-out property <int> theme-choice <=> SettingsAdapter.theme-choice;
    in-out property <int> status-bar-choice <=> SettingsAdapter.status-bar-choice;
    in-out property <float> ui-scale <=> Metrics.ui-scale;
    in-out property <bool> editor-edit-mode <=> pane.edit-mode;
    in-out property <int> directory-mode <=> files-screen.directory-mode;
    in-out property <int> files-page <=> files-screen.page;

    function apply-theme-choice() {
        if (root.theme-choice == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.theme-choice == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    changed theme-choice => { root.apply-theme-choice(); }

    in-out property <bool> add-vault-open: false;
    in-out property <string> add-vault-draft;
    in property <length> extra-inset-top: 0px;
    in property <length> extra-inset-bottom: 0px;

    // Kept for backward compatibility with snap tests
    in-out property <bool> list-open: false;
    changed list-open => {
        if (root.list-open && root.active-tab != 2) {
            root.active-tab = 2;
        }
    }

    in-out property <bool> narrow: false;
    init => {
        root.narrow = root.width < 600px;
        root.apply-theme-choice();
    }
    changed width => { root.narrow = root.width < 600px; }

    callback select(int);
    callback edited(string);
    callback reflow-note-body(length);
    callback undo();
    callback redo();
    callback insert-symbol(string, int, int);
    callback sync();
    callback new-note();
    callback link();
    callback open-settings();
    callback close-settings();
    callback note-sheet-open-changed(bool);
    callback rename-requested(int);
    callback delete-requested(int);
    callback confirm-rename(string);
    callback confirm-delete();
    callback icon-requested(int);
    callback icon-picker-query-changed(string);
    callback icon-picker-select(string);
    callback open-vault-sheet();
    callback switch-vault(int);
    callback add-vault-requested();
    callback confirm-add-vault(string);
    callback delete-vault-requested(int);
    callback confirm-delete-vault();
    callback resolve-mine();
    callback resolve-theirs();
    callback jump-conflict();
    callback open-conflict-sheet();
    callback resolve-conflict-step(int);
    callback prev-conflict-step();
    callback next-conflict-step();
    callback trigger-haptic();
    callback trigger-heavy-haptic();
    callback search-query-changed(string);
    callback open-conflict-note();
    callback copy-sync-error();
    callback dismiss-sync-error();
    callback open-history();
    callback restore-history-version(int);
    callback open-vault-history();

    property <int> previous-tab: 0;

    public function handle-back() -> bool {
        // 1. Close open dialogs
        if (root.delete-vault-confirm-open) {
            root.delete-vault-confirm-open = false;
            return true;
        }
        if (root.add-vault-open) {
            root.add-vault-open = false;
            return true;
        }
        if (root.rename-open) {
            root.rename-open = false;
            return true;
        }
        if (root.delete-confirm-open) {
            root.delete-confirm-open = false;
            return true;
        }
        if (root.note-menu-index >= 0) {
            root.note-menu-index = -1;
            return true;
        }
        if (root.more-menu-open) {
            root.more-menu-open = false;
            return true;
        }
        if (root.quick-actions-open) {
            root.quick-actions-open = false;
            return true;
        }

        // 2. Close open sheets
        if (root.conflict-sheet-open) {
            root.conflict-sheet-open = false;
            return true;
        }
        if (root.history-sheet-open) {
            root.history-sheet-open = false;
            return true;
        }
        if (root.vault-history-open) {
            root.vault-history-open = false;
            return true;
        }
        if (root.vault-sheet-open) {
            root.vault-sheet-open = false;
            return true;
        }
        if (root.settings-sheet-open) {
            if (settings-sheet.page != 0) {
                settings-sheet.page = 0;
            } else {
                root.settings-sheet-open = false;
                root.close-settings();
            }
            return true;
        }
        // 3. Close note sheet if open (unfocus if keyboard is up or typing)
        if (root.note-sheet-open) {
            if (pane.edit-mode || pane.editor-has-focus || root.keyboard > 0px) {
                pane.view-mode();
                return true;
            }
            root.close-note-sheet();
            return true;
        }

        // 4. Same for the Library tab's Directory page: pop one folder
        // level (List and Grid both browse folder-at-a-time) before
        // falling back to the hub. The parent is the breadcrumb's
        // second-to-last segment, or the vault root if there isn't one.
        if (root.active-tab == 2 && files-screen.page != 0) {
            if (files-screen.page >= 2) {
                files-screen.page = 0;
                return true;
            }
            if (root.directory-breadcrumb.length > 0) {
                root.navigate-directory-folder(root.directory-breadcrumb.length >= 2
                    ? root.directory-breadcrumb[root.directory-breadcrumb.length - 2].key
                    : "");
                return true;
            }
            files-screen.page = 0;
            return true;
        }

        // 5. If on any secondary tab (Files: 1, Search: 2), navigate back to Home (0)
        if (root.active-tab != 0) {
            root.active-tab = 0;
            root.trigger-haptic();
            return true;
        }

        // 6. Already at root Home tab with nothing open:
        // Return false to allow Android to perform the default action (minimize/close app)
        return false;
    }

    public function set-cursor(offset: int) {
        pane.set-cursor(offset);
    }

    property <length> inset-top: root.safe-area-insets.top + root.extra-inset-top;
    // The on-screen keyboard overlays the app; tracked directly from the
    // window's virtual keyboard height so safe insets, sheet height, and bottom
    // bar adapt without depending on transient window height resizes.
    in-out property <length> keyboard: 0px;
    function update-keyboard() {
        root.keyboard = root.virtual-keyboard-size.height;
    }
    changed virtual-keyboard-size => { root.update-keyboard(); }
    property <length> inset-bottom: max(root.safe-area-insets.bottom + root.extra-inset-bottom, root.keyboard);
    property <length> bottom-bar-extra-inset: max(0px, (root.safe-area-insets.bottom + root.extra-inset-bottom) - 6px * Metrics.ui-scale);
    property <length> bottom-bar-total-height: root.keyboard == 0px
        ? (Metrics.bottom-bar-height + root.bottom-bar-extra-inset)
        : 0px;
    property <length> mini-card-resting-y: root.height - root.bottom-bar-total-height - Metrics.mini-card-height - 8px * Metrics.ui-scale;
    property <length> mini-card-extra-inset: (root.current >= 0 && root.keyboard == 0px)
        ? (Metrics.mini-card-height + 16px * Metrics.ui-scale)
        : 0px;
    property <length> screen-inset-bottom: max(root.bottom-bar-total-height + root.mini-card-extra-inset, root.keyboard);

    // Sheet gesture tracking & transition animation (music-player style)
    in-out property <bool> is-dragging-sheet: false;
    in-out property <float> drag-sheet-progress: 0.0;
    property <bool> sheet-threshold-passed: false;
    // Average downward speed in px/ms (at ui-scale 1.0) that counts as a
    // deliberate flick-to-close, scaled by ui-scale so it tracks the same
    // fraction-of-screen-per-time at any font/UI size setting. EditorScreen
    // measures this itself (see its `drag-start-time` doc comment) and
    // reports it alongside dy. 0.6 px/ms = 600px/s; a deliberate fast flick
    // tends to run well over 1000px/s, so this stays clear of an ordinary
    // drag's speed without needing to be as low as it was while the
    // measurement itself was still unreliable.
    property <float> fast-swipe-velocity: 0.6;
    property <float> sheet-progress: root.is-dragging-sheet
        ? root.drag-sheet-progress
        : (root.note-sheet-open ? 1.0 : 0.0);

    animate sheet-progress {
        duration: root.is-dragging-sheet ? 0ms : 240ms;
        easing: ease-out;
    }

    // One `SheetDragState` per note-sheet-style full-screen sheet (see
    // that component's own doc comment) -- independent from each other
    // and from the note editor sheet's own drag state above.
    vault-sheet-drag := SheetDragState {
        open: root.vault-sheet-open;
        close => { root.vault-sheet-open = false; }
        haptic => { root.trigger-haptic(); }
    }

    icon-picker-drag := SheetDragState {
        open: root.icon-picker-open;
        close => { root.icon-picker-open = false; }
        haptic => { root.trigger-haptic(); }
    }

    history-sheet-drag := SheetDragState {
        open: root.history-sheet-open;
        close => { root.history-sheet-open = false; }
        haptic => { root.trigger-haptic(); }
    }

    vault-history-drag := SheetDragState {
        open: root.vault-history-open;
        close => { root.vault-history-open = false; }
        haptic => { root.trigger-haptic(); }
    }

    settings-sheet-drag := SheetDragState {
        open: root.settings-sheet-open;
        close => {
            root.settings-sheet-open = false;
            root.close-settings();
        }
        haptic => { root.trigger-haptic(); }
    }

    public function open-settings-sheet() {
        root.open-settings();
        root.trigger-haptic();
    }

    // Main App Layout wrapped in FocusScope for Back gesture & Escape key handling
    root-focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (root.handle-back()) {
                    return accept;
                }
            }
            return reject;
        }

        // Layer 1: Content Area with 3 pages (swiping disabled to free gestures)
        content-box := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clip: true;

            // Screen 0: Home
            home-screen := HomeScreen {
                x: (0 - root.active-tab) * parent.width;
                y: 0px;
                width: parent.width;
                height: parent.height;
                inset-top: root.inset-top;
                inset-bottom: root.screen-inset-bottom;
                vault-name: root.current-vault-name;
                vault-path: root.current-vault-path;
                note-count: root.notes.length;
                conflict-count: root.conflict-count;
                status: root.status;
                syncing: root.syncing;
                remote-configured: root.remote-configured;
                last-sync-error: root.last-sync-error;
                sync-error-copied: root.sync-error-copied;
                last-synced-at: root.last-synced-at;
                new-note => {
                    root.new-note();
                    root.open-note-sheet();
                    pane.focus-editor();
                }
                sync => { root.sync(); }
                open-vaults => { root.open-vault-sheet(); }
                open-settings => {
                    root.open-settings-sheet();
                }
                open-vault-history => { root.open-vault-history(); }
                open-conflict-note => {
                    root.open-conflict-note();
                    root.open-note-sheet();
                }
                copy-sync-error => {
                    root.copy-sync-error();
                }
                dismiss-sync-error => {
                    root.dismiss-sync-error();
                }

                animate x {
                    duration: 220ms;
                    easing: ease-out;
                }
            }

            // Screen 1: Search
            search-screen := SearchScreen {
                x: (1 - root.active-tab) * parent.width;
                y: 0px;
                width: parent.width;
                height: parent.height;
                inset-top: root.inset-top;
                inset-bottom: root.screen-inset-bottom;
                query <=> root.search-query;
                notes: root.notes;
                snippets: root.snippets;
                conflicted: root.conflicted;
                query-changed(q) => { root.search-query-changed(q); }
                select(i) => {
                    root.select(i);
                    root.open-note-sheet();
                }

                animate x {
                    duration: 220ms;
                    easing: ease-out;
                }
            }

            // Screen 2: Files / Notes list (Library)
            files-screen := FilesScreen {
                x: (2 - root.active-tab) * parent.width;
                y: 0px;
                width: parent.width;
                height: parent.height;
                current: root.current;
                status: root.status;
                syncing: root.syncing;
                inset-top: root.inset-top;
                inset-bottom: root.screen-inset-bottom;
                highlight-current: true;
                remote-configured: root.remote-configured;
                folder-entries: root.directory-folder-entries;
                breadcrumb: root.directory-breadcrumb;
                select(i) => {
                    root.select(i);
                    root.open-note-sheet();
                }
                new-note => {
                    root.new-note();
                    root.open-note-sheet();
                    pane.focus-editor();
                }
                sync => { root.sync(); }
                open-settings => {
                    root.open-settings-sheet();
                }
                note-menu-requested(i) => { root.note-menu-index = i; }
                navigate-folder(key) => { root.navigate-directory-folder(key); }
                trigger-haptic => { root.trigger-haptic(); }
                trigger-heavy-haptic => { root.trigger-heavy-haptic(); }

                animate x {
                    duration: 220ms;
                    easing: ease-out;
                }
            }
        }

        // Scrim: dims the screen behind the note sheet so the sheet reads
        // as sitting on top of it, proportional to how open the sheet is.
        sheet-scrim := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            property <float> combined-progress: max(root.sheet-progress, max(
                vault-sheet-drag.sheet-progress, max(
                    icon-picker-drag.sheet-progress, max(
                        history-sheet-drag.sheet-progress, max(
                            vault-history-drag.sheet-progress,
                            settings-sheet-drag.sheet-progress)))));
            background: #000000.with-alpha(0.35 * self.combined-progress);
            visible: self.combined-progress > 0.01;
        }

        // Layer 2: Fullscreen Note Editor Sheet Overlay
        // header-gesture/body-gesture inside EditorScreen are themselves
        // fixed-position (see editor.slint's `sheet-y-offset` doc comment);
        // this wrapper only gates visibility during the open/close
        // animation, it no longer carries the animated position itself.
        editor-sheet := Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            visible: root.sheet-progress > 0.01;

            pane := EditorScreen {
                width: 100%;
                height: 100%;
                sheet-progress: root.sheet-progress;
                sheet-y-offset: (1.0 - root.sheet-progress) * root.mini-card-resting-y;
                title: root.current-title;
                has-note: root.current >= 0;
                note-count: root.notes.length;
                has-conflict: root.current-has-conflict;
                note-path: root.current-note-path;
                note-kind: root.note-kind;
                note-metadata: root.note-metadata;
                char-count: root.char-count;
                word-count: root.word-count;
                line-count: root.line-count;
                conflict-total: root.active-conflict-total;
                conflict-a-preview: root.active-conflict-a;
                conflict-b-preview: root.active-conflict-b;
                conflict-a-label: root.active-conflict-a-label;
                conflict-b-label: root.active-conflict-b-label;
                conflict-a-button-label: root.active-conflict-a-button-label;
                conflict-b-button-label: root.active-conflict-b-button-label;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                can-navigate-back: root.can-navigate-back;
                can-navigate-forward: root.can-navigate-forward;
                history-back-title: root.history-back-title;
                history-back-items: root.history-back-items;
                history-forward-title: root.history-forward-title;
                history-forward-items: root.history-forward-items;
                navigate-back => { root.navigate-back(); }
                navigate-forward => { root.navigate-forward(); }
                show-back: false;
                back => { root.handle-back(); }
                collapse => { root.close-note-sheet(); }
                inset-top: root.inset-top;
                inset-bottom: root.keyboard > 0px ? root.keyboard : root.safe-area-insets.bottom + root.extra-inset-bottom;
                font-size: root.editor-font-size;
                status: root.status;
                status-is-error: root.status-is-error;
                body <=> root.body;
                note-body-items: root.note-body-items;
                edited(t) => { root.edited(t); }
                reflow-note-body(w) => { root.reflow-note-body(w); }
                undo => { root.undo(); }
                redo => { root.redo(); }
                insert-symbol(sym, cpos, apos) => { root.insert-symbol(sym, cpos, apos); }
                dismiss-status => {
                    root.status = "";
                    root.status-is-error = false;
                }
                new-note => {
                    root.new-note();
                    pane.focus-editor();
                }
                resolve-mine => { root.resolve-mine(); }
                resolve-theirs => { root.resolve-theirs(); }
                jump-conflict => { root.jump-conflict(); }
                open-conflict-sheet => { root.open-conflict-sheet(); }
                syncing: root.syncing;
                remote-configured: root.remote-configured;
                last-synced-at: root.last-synced-at;
                manual-sync => { root.sync(); }
                open-history => { root.open-history(); }
                // Reuses the same ActionSheet (Rename/Delete) FilesScreen's
                // long-press already opens -- the editor just means "the
                // current note" instead of taking an index.
                note-menu-requested => { root.note-menu-index = root.current; }
                header-swipe-enabled: root.note-sheet-open && root.keyboard == 0px;
                sheet-drag-moved(dy) => {
                    // dy is the total distance since this gesture's own
                    // start (header-gesture/body-gesture are stationary, so
                    // this is trustworthy on its own -- no need to add back
                    // an already-accumulated offset the way this used to,
                    // back when it was compensating for a drifting frame).
                    // A fresh gesture always starts from drag-sheet-progress
                    // == 1.0 (swiped/cancelled always reset it to a clean
                    // 0 or 1 endpoint), so this is the whole computation.
                    let travel = max(100px, root.mini-card-resting-y);
                    let downward = max(0px, dy);
                    let progress = clamp(1.0 - (downward / travel), 0.0, 1.0);
                    let passed = progress <= 0.60;
                    if (passed != root.sheet-threshold-passed) {
                        root.sheet-threshold-passed = passed;
                        root.trigger-haptic();
                    }
                    root.is-dragging-sheet = true;
                    root.drag-sheet-progress = progress;
                }
                sheet-drag-swiped(dy, velocity) => {
                    // A fast downward flick closes the sheet even if it
                    // didn't travel past the distance threshold. No extra
                    // minimum-distance guard here: `swiped` only fires once
                    // SwipeGestureHandler has already recognized this as a
                    // swipe (not a tap), so that disambiguation is already
                    // done upstream -- and an upward (negative dy) flick
                    // already fails this on its own, since velocity shares
                    // dy's sign and the threshold is positive.
                    let flicked-closed = velocity > root.fast-swipe-velocity * Metrics.ui-scale;
                    let should-close = root.drag-sheet-progress <= 0.60 || flicked-closed;
                    root.is-dragging-sheet = false;
                    root.sheet-threshold-passed = false;
                    if (should-close) {
                        root.close-note-sheet();
                    } else {
                        root.note-sheet-open = true;
                        root.drag-sheet-progress = 1.0;
                    }
                }
                sheet-drag-cancelled => {
                    root.is-dragging-sheet = false;
                    root.sheet-threshold-passed = false;
                    root.drag-sheet-progress = 1.0;
                }
            }
        }

        // Mini note card container (anchored above the bottom nav bar)
        mini-note-bar := MiniNoteBar {
            x: Metrics.spacing-sm - 12px * Metrics.ui-scale;
            y: root.mini-card-resting-y - 20px * Metrics.ui-scale;
            width: parent.width - 2 * Metrics.spacing-sm + 24px * Metrics.ui-scale;
            height: Metrics.mini-card-height + 26px * Metrics.ui-scale;
            visible: root.current >= 0 && root.keyboard == 0px && !root.note-sheet-open && !root.settings-sheet-open;
            gesture-enabled: root.current >= 0 && root.keyboard == 0px && !root.note-sheet-open && !root.settings-sheet-open;

            title: root.current-title;
            preview: root.snippets.length > root.current && root.current >= 0 ? root.snippets[root.current] : "";
            has-conflict: root.current-has-conflict;
            syncing: root.syncing;
            remote-configured: root.remote-configured;
            status: root.status;
            status-is-error: root.status-is-error;

            can-navigate-back: root.can-navigate-back;
            can-navigate-forward: root.can-navigate-forward;
            history-back-title: root.history-back-title;
            history-forward-title: root.history-forward-title;
            mini-card-reveal-dx <=> root.mini-card-reveal-dx;
            is-dragging-mini-reveal <=> root.is-dragging-mini-reveal;

            resting-y: root.mini-card-resting-y;
            sheet-progress: root.sheet-progress;
            fast-swipe-velocity: root.fast-swipe-velocity;

            open-sheet => { root.open-note-sheet(); }
            sync => { root.sync(); }
            navigate-back => { root.navigate-back(); }
            navigate-forward => { root.navigate-forward(); }
            trigger-haptic => { root.trigger-haptic(); }

            sheet-drag-started => { root.is-dragging-sheet = true; }
            sheet-drag-moved(p) => {
                root.is-dragging-sheet = true;
                root.drag-sheet-progress = p;
            }
            sheet-drag-ended(v, should-open) => {
                root.is-dragging-sheet = false;
                if (should-open || root.drag-sheet-progress > 0.25) {
                    root.open-note-sheet();
                } else {
                    root.note-sheet-open = false;
                    root.drag-sheet-progress = 0.0;
                }
            }
            sheet-drag-cancelled => {
                root.is-dragging-sheet = false;
                root.drag-sheet-progress = 0.0;
            }
        }

        // Layer 3: Bottom Navigation Bar
        // Sits in front of the Note Sheet; translates downward off-screen as the sheet opens
        bottom-nav-bar := BottomNavBar {
            x: 0px;
            y: (root.height - root.bottom-bar-total-height) + root.sheet-progress * root.bottom-bar-total-height;
            width: 100%;
            height: root.bottom-bar-total-height;
            visible: root.keyboard == 0px && root.sheet-progress < 0.99;
            active-tab <=> root.active-tab;
            files-page <=> files-screen.page;
            conflict-count: root.conflict-count;
            current-has-conflict: root.current-has-conflict;
            has-home: SettingsAdapter.nav-show-home;
            has-search: SettingsAdapter.nav-show-search;
            has-library: SettingsAdapter.nav-show-library;
            has-directory: SettingsAdapter.nav-show-directory;
            has-daily: SettingsAdapter.nav-show-daily;
            has-starred: SettingsAdapter.nav-show-starred;
            has-recent: SettingsAdapter.nav-show-recent;
            has-graph: SettingsAdapter.nav-show-graph;
            has-quick: SettingsAdapter.nav-show-quick;
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            open-library-page(p) => {
                files-screen.page = p;
            }
            tab-selected(idx) => {
                root.active-tab = idx;
                root.trigger-haptic();
            }
            quick-action => {
                root.trigger-haptic();
                root.quick-actions-open = true;
            }
            open-more => {
                root.trigger-haptic();
                root.more-menu-open = true;
            }
        }

        ActionSheet {
            open: root.more-menu-open;
            narrow: root.narrow;
            title: @tr("More");
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            cancel => { root.more-menu-open = false; }

            if bottom-nav-bar.overflow-home: IconActionRow {
                icon: TablerIcons.home;
                text: @tr("Home");
                tint: root.active-tab == 0 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 0;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-search: IconActionRow {
                icon: TablerIcons.search;
                text: @tr("Search");
                tint: root.active-tab == 1 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 1;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-library: IconActionRow {
                icon: TablerIcons.files;
                text: @tr("Library");
                tint: root.active-tab == 2 && files-screen.page == 0 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 0;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-directory: IconActionRow {
                icon: TablerIcons.folder;
                text: @tr("Directory");
                tint: root.active-tab == 2 && files-screen.page == 1 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 1;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-daily: IconActionRow {
                icon: TablerIcons.calendar;
                text: @tr("Daily Notes");
                tint: root.active-tab == 2 && files-screen.page == 2 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 2;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-starred: IconActionRow {
                icon: TablerIcons.star;
                text: @tr("Starred");
                tint: root.active-tab == 2 && files-screen.page == 3 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 3;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-recent: IconActionRow {
                icon: TablerIcons.clock;
                text: @tr("Recent");
                tint: root.active-tab == 2 && files-screen.page == 4 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 4;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-graph: IconActionRow {
                icon: TablerIcons.git-fork;
                text: @tr("Graph View");
                tint: root.active-tab == 2 && files-screen.page == 5 ? Palette.accent-background : Palette.foreground;
                clicked => {
                    root.more-menu-open = false;
                    root.active-tab = 2;
                    files-screen.page = 5;
                    root.trigger-haptic();
                }
            }

            if bottom-nav-bar.overflow-quick: IconActionRow {
                icon: TablerIcons.bolt;
                text: @tr("Quick Actions");
                clicked => {
                    root.more-menu-open = false;
                    root.trigger-haptic();
                    root.quick-actions-open = true;
                }
            }
        }

        ActionSheet {
            open: root.quick-actions-open;
            narrow: root.narrow;
            title: @tr("Quick Actions");
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            cancel => { root.quick-actions-open = false; }

            IconActionRow {
                icon: TablerIcons.plus;
                text: @tr("New Note");
                tint: Palette.accent-background;
                clicked => {
                    root.quick-actions-open = false;
                    root.new-note();
                    root.open-note-sheet();
                    pane.focus-editor();
                }
            }

            IconActionRow {
                icon: TablerIcons.cloud;
                text: @tr("Sync Now");
                clicked => {
                    root.quick-actions-open = false;
                    root.sync();
                }
            }

            IconActionRow {
                icon: TablerIcons.folder;
                text: @tr("Switch Vault");
                clicked => {
                    root.quick-actions-open = false;
                    root.open-vault-sheet();
                }
            }

            IconActionRow {
                icon: TablerIcons.settings;
                text: @tr("Settings");
                clicked => {
                    root.quick-actions-open = false;
                    root.open-settings-sheet();
                }
            }
        }

        ActionSheet {
            open: root.note-menu-index >= 0;
            narrow: root.narrow;
            title: root.note-menu-index >= 0 ? root.notes[root.note-menu-index] : "";
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            cancel => { root.note-menu-index = -1; }

            ActionRow {
                text: @tr("Rename");
                clicked => {
                    let idx = root.note-menu-index;
                    root.note-menu-index = -1;
                    root.rename-requested(idx);
                }
            }

            ActionRow {
                text: @tr("Set Icon");
                clicked => {
                    let idx = root.note-menu-index;
                    root.note-menu-index = -1;
                    root.icon-requested(idx);
                }
            }

            ActionRow {
                text: @tr("Delete");
                tint: Colors.danger;
                clicked => {
                    let idx = root.note-menu-index;
                    root.note-menu-index = -1;
                    root.delete-requested(idx);
                }
            }
        }

        TextInputDialog {
            open: root.rename-open;
            narrow: root.narrow;
            title: @tr("Rename note");
            text-draft <=> root.rename-draft;
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            save(name) => {
                root.rename-open = false;
                root.confirm-rename(name);
            }
            cancel => { root.rename-open = false; }
        }

        ConfirmDialog {
            open: root.delete-confirm-open;
            narrow: root.narrow;
            title: @tr("Delete this note?");
            body: @tr("This can't be undone from here.");
            confirm-text: @tr("Delete");
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            confirm => {
                root.delete-confirm-open = false;
                root.confirm-delete();
            }
            cancel => { root.delete-confirm-open = false; }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            visible: settings-sheet-drag.sheet-progress > 0.01;

            settings-sheet := SettingsSheet {
                width: 100%;
                height: 100%;
                sheet-progress: settings-sheet-drag.sheet-progress;
                sheet-y-offset: (1.0 - settings-sheet-drag.sheet-progress) * root.height;
                sheet-drag-moved(dy) => { settings-sheet-drag.moved(dy, max(100px, root.height)); }
                sheet-drag-swiped(dy, v) => { settings-sheet-drag.swiped(dy, v); }
                sheet-drag-cancelled => { settings-sheet-drag.cancelled(); }
                show-back: true;
                page <=> root.settings-page;
                inset-top: root.inset-top;
                inset-bottom: root.inset-bottom;
                close => {
                    root.settings-sheet-open = false;
                    root.close-settings();
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            visible: vault-sheet-drag.sheet-progress > 0.01;

            VaultSheet {
                width: 100%;
                height: 100%;
                sheet-progress: vault-sheet-drag.sheet-progress;
                sheet-y-offset: (1.0 - vault-sheet-drag.sheet-progress) * root.height;
                sheet-drag-moved(dy) => { vault-sheet-drag.moved(dy, max(100px, root.height)); }
                sheet-drag-swiped(dy, v) => { vault-sheet-drag.swiped(dy, v); }
                sheet-drag-cancelled => { vault-sheet-drag.cancelled(); }
                vaults: root.vaults;
                current: root.current-vault;
                inset-top: root.inset-top;
                inset-bottom: root.inset-bottom;
                select(i) => {
                    root.vault-sheet-open = false;
                    root.switch-vault(i);
                }
                add => { root.add-vault-requested(); }
                close => { root.vault-sheet-open = false; }
                delete-requested(i) => { root.delete-vault-requested(i); }
                trigger-haptic => { root.trigger-haptic(); }
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            visible: icon-picker-drag.sheet-progress > 0.01;

            IconPickerSheet {
                width: 100%;
                height: 100%;
                sheet-progress: icon-picker-drag.sheet-progress;
                sheet-y-offset: (1.0 - icon-picker-drag.sheet-progress) * root.height;
                sheet-drag-moved(dy) => { icon-picker-drag.moved(dy, max(100px, root.height)); }
                sheet-drag-swiped(dy, v) => { icon-picker-drag.swiped(dy, v); }
                sheet-drag-cancelled => { icon-picker-drag.cancelled(); }
                query <=> root.icon-picker-query;
                results: root.icon-picker-results;
                inset-top: root.inset-top;
                inset-bottom: root.inset-bottom;
                query-changed(text) => { root.icon-picker-query-changed(text); }
                select(name) => {
                    root.icon-picker-open = false;
                    root.icon-picker-select(name);
                }
                close => { root.icon-picker-open = false; }
            }
        }

        ConfirmDialog {
            open: root.delete-vault-confirm-open;
            narrow: root.narrow;
            title: @tr("Remove this vault?");
            body: @tr("Its notes will stay on disk, but its sync settings and git history will be forgotten.");
            confirm-text: @tr("Remove");
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            confirm => {
                root.delete-vault-confirm-open = false;
                root.confirm-delete-vault();
            }
            cancel => { root.delete-vault-confirm-open = false; }
        }

        TextInputDialog {
            open: root.add-vault-open;
            narrow: root.narrow;
            title: @tr("Add vault");
            text-draft <=> root.add-vault-draft;
            inset-bottom: root.safe-area-insets.bottom + root.extra-inset-bottom;
            save(input) => {
                root.add-vault-open = false;
                root.confirm-add-vault(input);
            }
            cancel => { root.add-vault-open = false; }
        }

        if root.conflict-sheet-open: ConflictSheet {
            width: 100%;
            height: 100%;
            open: true;
            conflict-index: root.active-conflict-index;
            conflict-total: root.active-conflict-total;
            a-text: root.active-conflict-a;
            b-text: root.active-conflict-b;
            a-label: root.active-conflict-a-label;
            b-label: root.active-conflict-b-label;
            a-button-label: root.active-conflict-a-button-label;
            b-button-label: root.active-conflict-b-button-label;
            close => { root.conflict-sheet-open = false; }
            resolve-choice(choice) => { root.resolve-conflict-step(choice); }
            prev-conflict => { root.prev-conflict-step(); }
            next-conflict => { root.next-conflict-step(); }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            visible: history-sheet-drag.sheet-progress > 0.01;

            HistorySheet {
                width: 100%;
                height: 100%;
                open: true;
                sheet-progress: history-sheet-drag.sheet-progress;
                sheet-y-offset: (1.0 - history-sheet-drag.sheet-progress) * root.height;
                sheet-drag-moved(dy) => { history-sheet-drag.moved(dy, max(100px, root.height)); }
                sheet-drag-swiped(dy, v) => { history-sheet-drag.swiped(dy, v); }
                sheet-drag-cancelled => { history-sheet-drag.cancelled(); }
                note-title: root.current-title;
                commits: root.history-commits;
                dates: root.history-dates;
                previews: root.history-previews;
                selected-index <=> root.history-selected-index;
                inset-top: root.inset-top;
                inset-bottom: root.inset-bottom;
                close => { root.history-sheet-open = false; }
                restore(idx) => { root.restore-history-version(idx); }
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            visible: vault-history-drag.sheet-progress > 0.01;

            VaultHistorySheet {
                width: 100%;
                height: 100%;
                open: true;
                sheet-progress: vault-history-drag.sheet-progress;
                sheet-y-offset: (1.0 - vault-history-drag.sheet-progress) * root.height;
                sheet-drag-moved(dy) => { vault-history-drag.moved(dy, max(100px, root.height)); }
                sheet-drag-swiped(dy, v) => { vault-history-drag.swiped(dy, v); }
                sheet-drag-cancelled => { vault-history-drag.cancelled(); }
                vault-name: root.current-vault-name;
                commits: root.vault-history-commits;
                dates: root.vault-history-dates;
                inset-top: root.inset-top;
                inset-bottom: root.inset-bottom;
                close => { root.vault-history-open = false; }
            }
        }

        // Measurement probes for `origiri_richtext_flow::Measure`
        // (`src/render/mod.rs`'s `RealMeasure`): off-screen elements
        // Rust sets properties on and reads `preferred-width` back from,
        // same technique `pages/editor/editor.slint`'s `LineNumberGutter` uses
        // for line-height, parameterized via properties instead of a fixed
        // probe string so Rust can ask about arbitrary text/elements.
        // Always present (not behind an `if`) so they're never torn down
        // between measurements.
        measure-probe-text-item := Text {
            x: -9999px;
            text: root.measure-probe-text;
            font-size: root.measure-probe-font-size;
            font-weight: root.measure-probe-font-weight;
            font-italic: root.measure-probe-font-italic;
        }

        measure-probe-block-item := RenderedBlockView {
            is-inline: true;
            x: -9999px;
            block: root.measure-probe-block;
        }
    }
}
